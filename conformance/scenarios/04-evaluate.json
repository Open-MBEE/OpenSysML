      "model": {
        "fixture": "set_tensor.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "T::cube"
      },
      "expect": {
        "response": {
          "result": {
            "tensor_quantity": {
              "dimensions": [
                2,
                2,
                2
              ],
              "components": [
                {
                  "real_magnitude": 1.0,
                  "unit": "m",
                  "unit_term": {
                    "factors": [
                      {
                        "unit_id": "SI::metre",
                        "exponent": 1
                      }
                    ],
                    "scale_num": 1,
                    "scale_den": 1
                  }
                },
                {
                  "real_magnitude": 2.0,
                  "unit": "m",
                  "unit_term": {
                    "factors": [
                      {
                        "unit_id": "SI::metre",
                        "exponent": 1
                      }
                    ],
                    "scale_num": 1,
                    "scale_den": 1
                  }
                },
                {
                  "real_magnitude": 3.0,
                  "unit": "m",
                  "unit_term": {
                    "factors": [
                      {
                        "unit_id": "SI::metre",
                        "exponent": 1
                      }
                    ],
                    "scale_num": 1,
                    "scale_den": 1
                  }
                },
                {
                  "real_magnitude": 4.0,
                  "unit": "m",
                  "unit_term": {
                    "factors": [
                      {
                        "unit_id": "SI::metre",
                        "exponent": 1
                      }
                    ],
                    "scale_num": 1,
                    "scale_den": 1
                  }
                },
                {
                  "real_magnitude": 5.0,
                  "unit": "m",
                  "unit_term": {
                    "factors": [
                      {
                        "unit_id": "SI::metre",
                        "exponent": 1
                      }
                    ],
                    "scale_num": 1,
                    "scale_den": 1
                  }
                },
                {
                  "real_magnitude": 6.0,
                  "unit": "m",
                  "unit_term": {
                    "factors": [
                      {
                        "unit_id": "SI::metre",
                        "exponent": 1
                      }
                    ],
                    "scale_num": 1,
                    "scale_den": 1
                  }
                },
                {
                  "real_magnitude": 7.0,
                  "unit": "m",
                  "unit_term": {
                    "factors": [
                      {
                        "unit_id": "SI::metre",
                        "exponent": 1
                      }
                    ],
                    "scale_num": 1,
                    "scale_den": 1
                  }
                },
                {
                  "real_magnitude": 8.0,
                  "unit": "m",
                  "unit_term": {
                    "factors": [
                      {
                        "unit_id": "SI::metre",
                        "exponent": 1
                      }
                    ],
                    "scale_num": 1,
                    "scale_den": 1
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "id": "evaluate/a_named_measurement_reference_arrives_with_its_declaration",
      "description": "A unit held by itself travels in one arm carrying the unit as written, its reduction to base units and the declaration it names, so a client can hand it back as a conversion target.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "measurement_refs"
      ],
      "model": {
        "fixture": "measurement_ref.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "M::q.mRef"
      },
      "expect": {
        "response": {
          "result": {
            "measurement_ref": {
              "unit": "km",
              "unit_term": {
                "factors": [
                  {
                    "unit_id": "SI::metre",
                    "exponent": 1
                  }
                ],
                "scale_num": 1000,
                "scale_den": 1
              },
              "unit_id": "SI::kilometre"
            }
          }
        }
      }
    },
    {
      "id": "evaluate/a_composed_measurement_reference_names_no_declaration",
      "description": "A unit an operation composed has no declaration of its own, so it travels with its reduction and no unit id rather than an invented one.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "measurement_refs"
      ],
      "model": {
        "fixture": "measurement_ref.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "M::speed"
      },
      "expect": {
        "response": {
          "result": {
            "measurement_ref": {
              "unit": "m/s",
              "unit_term": {
                "factors": [
                  {
                    "unit_id": "SI::metre",
                    "exponent": 1
                  },
                  {
                    "unit_id": "SI::second",
                    "exponent": -1
                  }
                ],
                "scale_num": 1,
                "scale_den": 1
              }
            }
          }
        },
        "absent": [
          "result.measurement_ref.unit_id"
        ]
      }
    },
    {
      "id": "evaluate/an_unparsable_expression_is_reported_in_band",
      "description": "A bad expression is an answer about the expression, not a transport failure.",
      "rpc": "Evaluate",
      "model": {
        "fixture": "vehicle.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "invalid syntax ((("
      },
      "expect": {
        "non_empty": [
          "error"
        ]
      }
    },
    {
      "id": "evaluate/a_calc_definition_read_as_a_value_is_a_function_naming_it",
      "description": "A calc used as a value travels as a function naming the calc by qualified name and no object, so a client can hand it back as an argument of another calc.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "function_values"
      ],
      "model": {
        "fixture": "function.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "F::pick"
      },
      "expect": {
        "response": {
          "result": {
            "function": {
              "calc_id": "F::Sq"
            }
          }
        },
        "absent": [
          "result.function.self_id"
        ]
      }
    },
    {
      "id": "evaluate/a_calc_of_an_object_read_as_a_value_names_the_object_it_computes_over",
      "description": "A calc usage owned by a part reads the part's features when invoked, so its function carries the object it is bound to beside the calc's name.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "function_values"
      ],
      "model": {
        "fixture": "function.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "F::scaler"
      },
      "expect": {
        "response": {
          "result": {
            "function": {
              "calc_id": "F::Scaler::scale",
              "self_id": "@1"
            }
          }
        }
      }
    },
    {
      "id": "evaluate/a_calc_invoked_through_a_calc_parameter_answers_its_result",
      "description": "A calc passed to another calc's calc-typed parameter is invoked through that parameter, so Apply(Sq, 3.0) is 9.",
      "rpc": "Evaluate",
      "model": {
        "fixture": "function.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "F::nine"
      },
      "expect": {
        "response": {
          "result": {
            "real_value": 9.0
          }
        }
      }
    },
    {
      "id": "evaluate/a_meta_cast_arrives_as_a_metaobject_under_its_own_metaclass",
      "description": "`x meta T` reflects on the element x names, so the result travels as that element's qualified name under the metaclass that classifies it, not under T: seatBelt is a PartUsage however it was cast.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "metaobject_values"
      ],
      "model": {
        "fixture": "metaobject.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "Meta::asFeature"
      },
      "expect": {
        "response": {
          "result": {
            "sequence": {
              "elements": [
                {
                  "metaobject": {
                    "element_id": "Meta::seatBelt",
                    "metaclass_id": "SysML::Systems::PartUsage"
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "id": "evaluate/metadata_access_ends_with_the_reflective_metaobject",
      "description": "`x.metadata` is the element's annotations in model order followed by its reflective metaobject, so a client sees the annotation object first and the metaobject last.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "metaobject_values"
      ],
      "model": {
        "fixture": "metaobject.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "Meta::everything"
      },
      "expect": {
        "response": {
          "result": {
            "sequence": {
              "elements": [
                {
                  "instance_id": "@1"
                },
                {
                  "metaobject": {
                    "element_id": "Meta::seatBelt",
                    "metaclass_id": "SysML::Systems::PartUsage"
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "id": "evaluate/a_meta_cast_to_a_metaclass_the_element_is_not_an_instance_of_is_empty",
      "description": "A part usage is no PartDefinition, so the cast yields the empty sequence rather than a metaobject or an error.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "metaobject_values"
      ],
      "model": {
        "fixture": "metaobject.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "Meta::notADefinition"
      },
      "expect": {
        "response": {
          "result": {
            "sequence": {}
          }
        },
        "absent": [
          "error"
        ]
      }
    },
    {
      "id": "evaluate/an_unknown_model_is_not_found",
      "rpc": "Evaluate",
      "request": {
        "model_hash": "no-such-model",
        "expression": "2 + 2"
      },
      "expect": {
        "status": "NOT_FOUND"
      }
    },
    {
      "id": "evaluate/a_coordinate_frame_arrives_as_itself",
      "description": "A feature typed by a coordinate frame evaluates to the frame, so the result names its declaration, type and dimensions and lists one measurement reference per axis rather than reading as unsupported.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "coordinate_frame_values"
      ],
      "model": {
        "fixture": "coordinate_frame.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "Frames::datum"
      },
      "expect": {
        "response": {
          "result": {
            "coordinate_frame": {
              "name": "datum",
              "frame_id": "Frames::datum",
              "type_id": "ISQSpaceTime::CartesianSpatial3dCoordinateFrame",
              "dimensions": [
                "3"
              ]
            }
          }
        },
        "counts": {
          "result.coordinate_frame.axes": 3
        },
        "contains_all": {
          "result.coordinate_frame.axes.*.unit_id": [
            "SI::millimetre"
          ]
        },
        "absent": [
          "result.coordinate_frame.transformation",
          "result.null"
        ]
      },
      "expect_without_capability": {
        "non_empty": [
          "result.null"
        ],
        "absent": [
          "result.coordinate_frame"
        ]
      }
    },
    {
      "id": "evaluate/a_posed_frame_carries_its_transformation_and_resolved_pose",
      "description": "A frame posed in another carries the transformation that places it: the source frame, the translation and rotation steps in the order applied, and the pose they resolve to in the source's axis units. The frame is itself the target, so the nested transformation names none.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "coordinate_frame_values"
      ],
      "model": {
        "fixture": "coordinate_frame.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "Frames::lbcf"
      },
      "expect": {
        "response": {
          "result": {
            "coordinate_frame": {
              "name": "lbcf",
              "frame_id": "Frames::lbcf",
              "transformation": {
                "transformation_id": "Frames::lbcf::transformation",
                "type_id": "MeasurementReferences::TranslationRotationSequence",
                "source": {
                  "name": "datum",
                  "frame_id": "Frames::datum",
                  "type_id": "ISQSpaceTime::CartesianSpatial3dCoordinateFrame",
                  "dimensions": [
                    "3"
                  ]
                },
                "pose": {
                  "origin": [
                    10.0,
                    0.0,
                    0.0
                  ]
                }
              }
            }
          }
        },
        "counts": {
          "result.coordinate_frame.transformation.sequence.steps": 2,
          "result.coordinate_frame.transformation.pose.basis": 9
        },
        "non_empty": [
          "result.coordinate_frame.transformation.sequence.steps.0.translation.vector_quantity",
          "result.coordinate_frame.transformation.sequence.steps.1.rotation.axis_direction",
          "result.coordinate_frame.transformation.sequence.steps.1.rotation.angle"
        ],
        "absent": [
          "result.coordinate_frame.transformation.target"
        ]
      }
    },
    {
      "id": "evaluate/a_coordinate_transformation_names_both_frames_it_relates",
      "description": "A transformation read on its own is a value too, and then names both ends: the frame it is stated in and the frame it places.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "coordinate_frame_values"
      ],
      "model": {
        "fixture": "coordinate_frame.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "Frames::lbcf.transformation"
      },
      "expect": {
        "response": {
          "result": {
            "coordinate_transformation": {
              "source": {
