{
  "scenarios": [
    {
      "id": "evaluate/arithmetic_is_an_integer",
      "description": "An integral expression answers int_value, not real_value: the arm is the type.",
      "rpc": "Evaluate",
      "model": {
        "fixture": "vehicle.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "2 + 2"
      },
      "expect": {
        "response": {
          "result": {
            "int_value": 4
          }
        }
      }
    },
    {
      "id": "evaluate/a_boolean_is_a_boolean",
      "rpc": "Evaluate",
      "model": {
        "fixture": "vehicle.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "true and false"
      },
      "expect": {
        "response": {
          "result": {
            "bool_value": false
          }
        },
        "absent": [
          "error"
        ]
      }
    },
    {
      "id": "evaluate/a_declarations_default_is_read_without_a_subject",
      "description": "With no subject the definition's own default is what the feature holds.",
      "rpc": "Evaluate",
      "model": {
        "fixture": "vehicle.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "mass",
        "context_symbol_id": "Demo::Vehicle"
      },
      "expect": {
        "response": {
          "result": {
            "real_value": 1500.0
          }
        }
      }
    },
    {
      "id": "evaluate/a_feature_the_model_leaves_unvalued_is_undetermined",
      "description": "With no subject a typed attribute with no value is neither unset nor an error: the model fixes one value and states none, so the result is the undetermined arm with its reason and count.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "undetermined_value"
      ],
      "model": {
        "fixture": "unset.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "d + 1.0",
        "context_symbol_id": "P::Q"
      },
      "expect": {
        "response": {
          "result": {
            "undetermined": {
              "count": {
                "lower": "1",
                "upper": "1"
              }
            }
          }
        },
        "contains": {
          "result.undetermined.reason": "d has no value"
        }
      }
    },
    {
      "id": "evaluate/a_constant_operand_decides_a_boolean_over_an_undetermined_one",
      "description": "`and` with a false operand is false whatever the other operand holds, so an undetermined operand does not spread to the result.",
      "rpc": "Evaluate",
      "model": {
        "fixture": "unset.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "(d > 1.0) and false",
        "context_symbol_id": "P::Q"
      },
      "expect": {
        "response": {
          "result": {
            "bool_value": false
          }
        }
      }
    },
    {
      "id": "evaluate/a_subject_is_evaluated_against_that_objects_value",
      "description": "The subject redefines mass, so the same expression answers the object's value rather than the definition's.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "evaluate_subject"
      ],
      "model": {
        "fixture": "vehicle.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "mass",
        "subject_symbol_id": "Demo::sedan"
      },
      "expect": {
        "response": {
          "result": {
            "real_value": 1200.0
          }
        }
      }
    },
    {
      "id": "evaluate/an_absent_subject_is_reported",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "evaluate_subject"
      ],
      "model": {
        "fixture": "vehicle.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "mass",
        "subject_symbol_id": "Demo::nope"
      },
      "expect": {
        "non_empty": [
          "error"
        ]
      }
    },
    {
      "id": "evaluate/an_enumeration_literal_arrives_as_the_literal",
      "description": "A literal travels as the declaration it names, so a client can tell it from a string.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "enum_values"
      ],
      "model": {
        "fixture": "enumeration.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "D::Color::red"
      },
      "expect": {
        "response": {
          "result": {
            "enum_literal": {
              "literal_id": "D::Color::red",
              "enumeration_id": "D::Color"
            }
          }
        }
      }
    },
    {
      "id": "evaluate/a_complex_number_arrives_as_one_value",
      "description": "A complex number travels as its two parts in one arm, so a client cannot mistake it for a sequence of two reals.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "complex_values"
      ],
      "model": {
        "fixture": "complex.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "z",
        "context_symbol_id": "C::Signal"
      },
      "expect": {
        "response": {
          "result": {
            "complex": {
              "real": 1.5,
              "imaginary": -2.0
            }
          }
        }
      }
    },
    {
      "id": "evaluate/a_sequence_of_complex_numbers_keeps_each_whole",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "complex_values"
      ],
      "model": {
        "fixture": "complex.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "zs",
        "context_symbol_id": "C::Signal"
      },
      "expect": {
        "response": {
          "result": {
            "sequence": {
              "elements": [
                {
                  "complex": {
                    "real": 1.0,
                    "imaginary": 2.0
                  }
                },
                {
                  "complex": {
                    "real": 3.0,
                    "imaginary": 4.0
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "id": "evaluate/an_array_arrives_with_its_shape",
      "description": "An array travels as its dimensions and its row-major elements in one arm, so a client can rebuild the shape rather than receive a flat sequence.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "structured_values"
      ],
      "model": {
        "fixture": "structured.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "S::grid"
      },
      "expect": {
        "response": {
          "result": {
            "array": {
              "dimensions": [
                2,
                3
              ],
              "elements": [
                {
                  "int_value": 1
                },
                {
                  "int_value": 2
                },
                {
                  "int_value": 3
                },
                {
                  "int_value": 4
                },
                {
                  "int_value": 5
                },
                {
                  "int_value": 6
                }
              ]
            }
          }
        }
      }
    },
    {
      "id": "evaluate/a_vector_arrives_with_numeric_components",
      "description": "A vector travels as its components in one arm, each keeping its Integer or Real kind.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "structured_values"
      ],
      "model": {
        "fixture": "structured.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "S::v"
      },
      "expect": {
        "response": {
          "result": {
            "vector": {
              "components": [
                {
                  "real_value": 3.0
                },
                {
                  "real_value": 4.0
                }
              ]
            }
          }
        }
      }
    },
    {
      "id": "evaluate/a_vector_quantity_arrives_with_a_unit_per_component",
      "description": "A vector quantity travels as one Quantity per component, each carrying the unit as written and its reduction to base units.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "structured_values"
      ],
      "model": {
        "fixture": "structured.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "S::d"
      },
      "expect": {
        "response": {
          "result": {
            "vector_quantity": {
              "components": [
                {
                  "real_magnitude": 3.0,
                  "unit": "m",
                  "unit_term": {
                    "factors": [
                      {
                        "unit_id": "SI::metre",
                        "exponent": 1
                      }
                    ],
                    "scale_num": 1,
                    "scale_den": 1
                  }
                },
                {
                  "real_magnitude": 4.0,
                  "unit": "m",
                  "unit_term": {
                    "factors": [
                      {
                        "unit_id": "SI::metre",
                        "exponent": 1
                      }
                    ],
                    "scale_num": 1,
                    "scale_den": 1
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "id": "evaluate/a_set_arrives_as_its_members_in_canonical_order",
      "description": "A Set's elements are unique and unordered, so they travel in their own arm with every repeat dropped and in the runtime's canonical order, not as written.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "set_values"
      ],
      "model": {
        "fixture": "set_tensor.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "T::s.elements"
      },
      "expect": {
        "response": {
          "result": {
            "set": {
              "elements": [
                {
                  "int_value": 1
                },
                {
                  "int_value": 2
                },
                {
                  "int_value": 3
                }
              ]
            }
          }
        }
      }
    },
    {
      "id": "evaluate/a_tensor_quantity_arrives_with_its_shape",
      "description": "A tensor quantity of any rank travels as its dimensions and one Quantity per row-major component, so a client can rebuild a rank-three shape rather than receive a flat sequence.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "tensor_values"
      ],
      "model": {
        "fixture": "set_tensor.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "T::cube"
      },
      "expect": {
        "response": {
          "result": {
            "tensor_quantity": {
              "dimensions": [
                2,
                2,
                2
              ],
              "components": [
                {
                  "real_magnitude": 1.0,
                  "unit": "m",
                  "unit_term": {
                    "factors": [
                      {
                        "unit_id": "SI::metre",
                        "exponent": 1
                      }
                    ],
                    "scale_num": 1,
                    "scale_den": 1
                  }
                },
                {
                  "real_magnitude": 2.0,
                  "unit": "m",
                  "unit_term": {
                    "factors": [
                      {
                        "unit_id": "SI::metre",
                        "exponent": 1
                      }
                    ],
                    "scale_num": 1,
                    "scale_den": 1
                  }
                },
                {
                  "real_magnitude": 3.0,
                  "unit": "m",
                  "unit_term": {
                    "factors": [
                      {
                        "unit_id": "SI::metre",
                        "exponent": 1
                      }
                    ],
                    "scale_num": 1,
                    "scale_den": 1
                  }
                },
                {
                  "real_magnitude": 4.0,
                  "unit": "m",
                  "unit_term": {
                    "factors": [
                      {
                        "unit_id": "SI::metre",
                        "exponent": 1
                      }
                    ],
                    "scale_num": 1,
                    "scale_den": 1
                  }
                },
                {
                  "real_magnitude": 5.0,
                  "unit": "m",
                  "unit_term": {
                    "factors": [
                      {
                        "unit_id": "SI::metre",
                        "exponent": 1
                      }
                    ],
                    "scale_num": 1,
                    "scale_den": 1
                  }
                },
                {
                  "real_magnitude": 6.0,
                  "unit": "m",
                  "unit_term": {
                    "factors": [
                      {
                        "unit_id": "SI::metre",
                        "exponent": 1
                      }
                    ],
                    "scale_num": 1,
                    "scale_den": 1
                  }
                },
                {
                  "real_magnitude": 7.0,
                  "unit": "m",
                  "unit_term": {
                    "factors": [
                      {
                        "unit_id": "SI::metre",
                        "exponent": 1
                      }
                    ],
                    "scale_num": 1,
                    "scale_den": 1
                  }
                },
                {
                  "real_magnitude": 8.0,
                  "unit": "m",
                  "unit_term": {
                    "factors": [
                      {
                        "unit_id": "SI::metre",
                        "exponent": 1
                      }
                    ],
                    "scale_num": 1,
                    "scale_den": 1
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "id": "evaluate/a_named_measurement_reference_arrives_with_its_declaration",
      "description": "A unit held by itself travels in one arm carrying the unit as written, its reduction to base units and the declaration it names, so a client can hand it back as a conversion target.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "measurement_refs"
      ],
      "model": {
        "fixture": "measurement_ref.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "M::q.mRef"
      },
      "expect": {
        "response": {
          "result": {
            "measurement_ref": {
              "unit": "km",
              "unit_term": {
                "factors": [
                  {
                    "unit_id": "SI::metre",
                    "exponent": 1
                  }
                ],
                "scale_num": 1000,
                "scale_den": 1
              },
              "unit_id": "SI::kilometre"
            }
          }
        }
      }
    },
    {
      "id": "evaluate/a_composed_measurement_reference_names_no_declaration",
      "description": "A unit an operation composed has no declaration of its own, so it travels with its reduction and no unit id rather than an invented one.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "measurement_refs"
      ],
      "model": {
        "fixture": "measurement_ref.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "M::speed"
      },
      "expect": {
        "response": {
          "result": {
            "measurement_ref": {
              "unit": "m/s",
              "unit_term": {
                "factors": [
                  {
                    "unit_id": "SI::metre",
                    "exponent": 1
                  },
                  {
                    "unit_id": "SI::second",
                    "exponent": -1
                  }
                ],
                "scale_num": 1,
                "scale_den": 1
              }
            }
          }
        },
        "absent": [
          "result.measurement_ref.unit_id"
        ]
      }
    },
    {
      "id": "evaluate/an_unparsable_expression_is_reported_in_band",
      "description": "A bad expression is an answer about the expression, not a transport failure.",
      "rpc": "Evaluate",
      "model": {
        "fixture": "vehicle.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "invalid syntax ((("
      },
      "expect": {
        "non_empty": [
          "error"
        ]
      }
    },
    {
      "id": "evaluate/a_calc_definition_read_as_a_value_is_a_function_naming_it",
      "description": "A calc used as a value travels as a function naming the calc by qualified name and no object, so a client can hand it back as an argument of another calc.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "function_values"
      ],
      "model": {
        "fixture": "function.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "F::pick"
      },
      "expect": {
        "response": {
          "result": {
            "function": {
              "calc_id": "F::Sq"
            }
          }
        },
        "absent": [
          "result.function.self_id"
        ]
      }
    },
    {
      "id": "evaluate/a_calc_of_an_object_read_as_a_value_names_the_object_it_computes_over",
      "description": "A calc usage owned by a part reads the part's features when invoked, so its function carries the object it is bound to beside the calc's name.",
      "rpc": "Evaluate",
      "requires_capabilities": [
        "function_values"
      ],
      "model": {
        "fixture": "function.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "F::scaler"
      },
      "expect": {
        "response": {
          "result": {
            "function": {
              "calc_id": "F::Scaler::scale",
              "self_id": "@1"
            }
          }
        }
      }
    },
    {
      "id": "evaluate/a_calc_invoked_through_a_calc_parameter_answers_its_result",
      "description": "A calc passed to another calc's calc-typed parameter is invoked through that parameter, so Apply(Sq, 3.0) is 9.",
      "rpc": "Evaluate",
      "model": {
        "fixture": "function.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "expression": "F::nine"
      },
      "expect": {
        "response": {
          "result": {
            "real_value": 9.0
          }
        }
      }
    },
    {
      "id": "evaluate/an_unknown_model_is_not_found",
      "rpc": "Evaluate",
      "request": {
        "model_hash": "no-such-model",
        "expression": "2 + 2"
      },
      "expect": {
        "status": "NOT_FOUND"
      }
    }
  ]
}
