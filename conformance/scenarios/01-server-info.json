{
  "scenarios": [
    {
      "id": "server_info/reports_the_capabilities_clients_negotiate_on",
      "description": "A client selects behaviour by capability name, not by version string, so every name these scenarios require must be reported.",
      "rpc": "GetServerInfo",
      "request": {},
      "expect": {
        "non_empty": [
          "capabilities"
        ],
        "response": {
          "version": "${version}"
        },
        "contains_all": {
          "capabilities": [
            "type_facts",
            "convert",
            "verification",
            "query",
            "oslc_query",
            "enum_values",
            "evaluate_subject",
            "symbol_attributes",
            "unset_value",
            "complex_values",
            "structured_values",
            "measurement_refs",
            "function_values",
            "apply_edits",
            "strict_conformance",
            "feature_values",
            "document_query",
            "render_document",
            "schedule"
          ]
        }
      }
    }
  ]
}
