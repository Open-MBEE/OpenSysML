{
  "scenarios": [
    {
      "id": "symbol/a_definition_reports_its_kind_and_members",
      "rpc": "GetSymbol",
      "description": "A definition's symbol names its kind and its members, which is what navigation walks.",
      "model": {
        "fixture": "vehicle.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Demo::Vehicle"
      },
      "expect": {
        "response": {
          "symbol": {
            "id": "Demo::Vehicle",
            "name": "Vehicle",
            "kind": "partDef"
          }
        }
      }
    },
    {
      "id": "symbol/inherited_members_are_listed_with_provenance",
      "description": "A usage's members include the ones inherited through its type's specializations, each naming the type that declares it; child_ids stays the owned members, and the standard-library ones are counted rather than listed.",
      "rpc": "GetSymbol",
      "requires_capabilities": [
        "symbol_members"
      ],
      "model": {
        "fixture": "members.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Demo::m"
      },
      "expect": {
        "contains_all": {
          "symbol.members.*.id": [
            "Demo::Base::p"
          ]
        },
        "contains": {
          "symbol.members.0.id": "Demo::Base::p",
          "symbol.members.0.inherited_from": "Demo::Base"
        },
        "response": {
          "symbol": {
            "members": [
              {
                "id": "Demo::Base::p",
                "name": "p",
                "kind": "partUsage",
                "inherited": true,
                "inherited_from": "Demo::Base"
              }
            ]
          }
        },
        "non_empty": [
          "symbol.withheld_library_members"
        ],
        "absent": [
          "symbol.child_ids"
        ]
      }
    },
    {
      "id": "symbol/library_members_are_listed_on_request",
      "description": "include_library_members lists the standard-library members otherwise counted, each marked library with its provenance, and the count drops to zero.",
      "rpc": "GetSymbol",
      "requires_capabilities": [
        "symbol_members"
      ],
      "model": {
        "fixture": "members.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Demo::m",
        "include_library_members": true
      },
      "expect": {
        "contains_all": {
          "symbol.members.*.id": [
            "Demo::Base::p"
          ]
        },
        "min_counts": {
          "symbol.members": 2
        },
        "absent": [
          "symbol.withheld_library_members"
        ]
      }
    },
    {
      "id": "symbol/an_about_metadata_usage_is_named_by_what_it_annotates",
      "description": "An element names the metadata usage annotating it from elsewhere with `about`; the usage stays a member of the namespace it is written in, so child_ids leaves it out.",
      "rpc": "GetSymbol",
      "requires_capabilities": [
        "symbol_annotating_metadata"
      ],
      "model": {
        "fixture": "annotations.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Demo::Pump"
      },
      "expect": {
        "response": {
          "symbol": {
            "id": "Demo::Pump",
            "annotating_metadata_ids": [
              "Demo::pump_fm"
            ]
          }
        },
        "absent": [
          "symbol.child_ids"
        ]
      },
      "expect_without_capability": {
        "response": {
          "symbol": {
            "id": "Demo::Pump"
          }
        },
        "absent": [
          "symbol.annotating_metadata_ids"
        ]
      }
    },
    {
      "id": "symbol/an_annotating_metadata_usage_reads_its_type_and_value",
      "description": "The usage an element names as annotating it is an ordinary symbol: its type resolves to the metadata definition and its attribute carries the value written.",
      "rpc": "GetSymbol",
      "requires_capabilities": [
        "symbol_annotating_metadata",
        "type_facts",
        "symbol_attributes"
      ],
      "model": {
        "fixture": "annotations.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Demo::pump_fm"
      },
      "expect": {
        "response": {
          "symbol": {
            "id": "Demo::pump_fm",
            "kind": "metadataUsage",
            "type_info": {
              "resolved_id": "Demo::FailureMode"
            },
            "attributes": [
              {
                "name": "severity",
                "value": {
                  "int_value": 2
                }
              }
            ]
          }
        },
        "absent": [
          "symbol.annotating_metadata_ids"
        ]
      }
    },
    {
      "id": "symbol/an_attribute_reports_the_kind_that_filters_it",
      "description": "Attribute and part usages are told apart by kind, which is how a client offers attributes() and parts().",
      "rpc": "GetSymbol",
      "requires_capabilities": [
        "symbol_attributes"
      ],
      "model": {
        "fixture": "vehicle.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Demo::Vehicle::mass"
      },
      "expect": {
        "response": {
          "symbol": {
            "id": "Demo::Vehicle::mass",
            "name": "mass",
            "kind": "attributeUsage"
          }
        }
      }
    },
    {
      "id": "symbol/an_unknown_symbol_is_not_found",
      "rpc": "GetSymbol",
      "model": {
        "fixture": "vehicle.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Demo::Nope"
      },
      "expect": {
        "contains": {
          "error": "symbol not found"
        }
      }
    },
    {
      "id": "symbol/an_unknown_model_is_not_found",
      "rpc": "GetSymbol",
      "request": {
        "model_hash": "no-such-model",
        "symbol_id": "Demo::Vehicle"
      },
      "expect": {
        "status": "NOT_FOUND"
      }
    }
  ]
}
