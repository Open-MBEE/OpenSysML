{
  "scenarios": [
    {
      "id": "symbol/a_definition_reports_its_kind_and_members",
      "rpc": "GetSymbol",
      "description": "A definition's symbol names its kind and its members, which is what navigation walks.",
      "model": {
        "fixture": "vehicle.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Demo::Vehicle"
      },
      "expect": {
        "response": {
          "symbol": {
            "id": "Demo::Vehicle",
            "name": "Vehicle",
            "kind": "partDef"
          }
        }
      }
    },
    {
      "id": "symbol/inherited_members_are_listed_with_provenance",
      "description": "A usage's members include the ones inherited through its type's specializations, each naming the type that declares it; child_ids stays the owned members, and the standard-library ones are counted rather than listed.",
      "rpc": "GetSymbol",
      "requires_capabilities": [
        "symbol_members"
      ],
      "model": {
        "fixture": "members.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Demo::m"
      },
      "expect": {
        "contains_all": {
          "symbol.members.*.id": [
            "Demo::Base::p"
          ]
        },
        "contains": {
          "symbol.members.0.id": "Demo::Base::p",
          "symbol.members.0.inherited_from": "Demo::Base"
        },
        "response": {
          "symbol": {
            "members": [
              {
                "id": "Demo::Base::p",
                "name": "p",
                "kind": "partUsage",
                "inherited": true,
                "inherited_from": "Demo::Base"
              }
            ]
          }
        },
        "non_empty": [
          "symbol.withheld_library_members"
        ],
        "absent": [
          "symbol.child_ids"
        ]
      }
    },
    {
      "id": "symbol/library_members_are_listed_on_request",
      "description": "include_library_members lists the standard-library members otherwise counted, each marked library with its provenance, and the count drops to zero.",
      "rpc": "GetSymbol",
      "requires_capabilities": [
        "symbol_members"
      ],
      "model": {
        "fixture": "members.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Demo::m",
        "include_library_members": true
      },
      "expect": {
        "contains_all": {
          "symbol.members.*.id": [
            "Demo::Base::p"
          ]
        },
        "min_counts": {
          "symbol.members": 2
        },
        "absent": [
          "symbol.withheld_library_members"
        ]
      }
    },
    {
      "id": "symbol/an_attribute_reports_the_kind_that_filters_it",
      "description": "Attribute and part usages are told apart by kind, which is how a client offers attributes() and parts().",
      "rpc": "GetSymbol",
      "requires_capabilities": [
        "symbol_attributes"
      ],
      "model": {
        "fixture": "vehicle.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Demo::Vehicle::mass"
      },
      "expect": {
        "response": {
          "symbol": {
            "id": "Demo::Vehicle::mass",
            "name": "mass",
            "kind": "attributeUsage"
          }
        }
      }
    },
    {
      "id": "symbol/a_name_resolves_through_a_public_membership_import",
      "description": "resolve_name resolves the id as a qualified name from the root namespace: a public import re-exports the member under the importing namespace.",
      "rpc": "GetSymbol",
      "model": {
        "fixture": "visibility.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Vis::Facade::Pump",
        "resolve_name": true
      },
      "expect": {
        "response": {
          "symbol": {
            "id": "Vis::Lib::Pump"
          }
        }
      }
    },
    {
      "id": "symbol/a_name_resolves_through_a_public_recursive_import",
      "description": "A recursive import brings in the members of the nested namespaces too.",
      "rpc": "GetSymbol",
      "model": {
        "fixture": "visibility.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Vis::FacadeDeep::Valve",
        "resolve_name": true
      },
      "expect": {
        "response": {
          "symbol": {
            "id": "Vis::Lib::Sub::Valve"
          }
        }
      }
    },
    {
      "id": "symbol/a_name_resolves_an_alias_to_its_element",
      "description": "A name that names an alias answers with the element the alias is for.",
      "rpc": "GetSymbol",
      "model": {
        "fixture": "visibility.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Vis::Lib::PumpAlias",
        "resolve_name": true
      },
      "expect": {
        "response": {
          "symbol": {
            "id": "Vis::Lib::Pump"
          }
        }
      }
    },
    {
      "id": "symbol/a_reported_id_of_an_alias_is_the_alias",
      "description": "Without resolve_name the id is one the service reported, and an alias is itself.",
      "rpc": "GetSymbol",
      "model": {
        "fixture": "visibility.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Vis::Lib::PumpAlias"
      },
      "expect": {
        "response": {
          "symbol": {
            "id": "Vis::Lib::PumpAlias",
            "kind": "alias"
          }
        }
      }
    },
    {
      "id": "symbol/a_name_does_not_cross_a_private_import",
      "description": "A private import is visible inside its namespace only, so the name resolves to nothing from the root.",
      "rpc": "GetSymbol",
      "model": {
        "fixture": "visibility.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Vis::Hidden::Pump",
        "resolve_name": true
      },
      "expect": {
        "contains": {
          "error": "symbol not found"
        }
      }
    },
    {
      "id": "symbol/a_name_does_not_reach_a_private_member",
      "description": "A private member is not visible from outside its namespace.",
      "rpc": "GetSymbol",
      "model": {
        "fixture": "visibility.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Vis::Lib::Secret",
        "resolve_name": true
      },
      "expect": {
        "contains": {
          "error": "symbol not found"
        }
      }
    },
    {
      "id": "symbol/a_reported_id_of_a_private_member_is_fetched",
      "description": "The id of a private member, which its owner's child_ids report, still denotes it.",
      "rpc": "GetSymbol",
      "model": {
        "fixture": "visibility.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Vis::Lib::Secret"
      },
      "expect": {
        "response": {
          "symbol": {
            "id": "Vis::Lib::Secret"
          }
        }
      }
    },
    {
      "id": "symbol/a_public_member_of_a_private_namespace_keeps_its_id",
      "description": "No name reaches a member of a private namespace from the root, but the id the service reports for it still fetches it under resolve_name.",
      "rpc": "GetSymbol",
      "model": {
        "fixture": "visibility.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Vis::Lib::Secret::inner",
        "resolve_name": true
      },
      "expect": {
        "response": {
          "symbol": {
            "id": "Vis::Lib::Secret::inner"
          }
        }
      }
    },
    {
      "id": "symbol/an_unknown_symbol_is_not_found",
      "rpc": "GetSymbol",
      "model": {
        "fixture": "vehicle.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Demo::Nope"
      },
      "expect": {
        "contains": {
          "error": "symbol not found"
        }
      }
    },
    {
      "id": "symbol/an_unknown_model_is_not_found",
      "rpc": "GetSymbol",
      "request": {
        "model_hash": "no-such-model",
        "symbol_id": "Demo::Vehicle"
      },
      "expect": {
        "status": "NOT_FOUND"
      }
    }
  ]
}
