{
  "scenarios": [
    {
      "id": "instantiate/a_part_def_answers_an_instance_of_it",
      "rpc": "Instantiate",
      "model": {
        "fixture": "simple_part.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Test::SimplePart"
      },
      "expect": {
        "response": {
          "instance": {
            "id": "@1",
            "type_symbol_id": "Test::SimplePart",
            "feature_values": {
              "mass": {
                "feature_name": "mass",
                "materialized": true,
                "value": {
                  "int_value": 100
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "instantiate/a_part_feature_resolves_to_a_nested_instance",
      "description": "A part slot carries the id of another instance in the graph, which is how a client resolves it.",
      "rpc": "Instantiate",
      "requires_capabilities": [
        "feature_values"
      ],
      "model": {
        "fixture": "vehicle.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Demo::Vehicle"
      },
      "expect": {
        "response": {
          "instance": {
            "id": "@1",
            "type_symbol_id": "Demo::Vehicle",
            "feature_values": {
              "mass": {
                "value": {
                  "real_value": 1500.0
                }
              },
              "engine": {
                "value": {
                  "instance_id": "@2"
                }
              }
            }
          }
        },
        "min_counts": {
          "instances": 2
        }
      }
    },
    {
      "id": "instantiate/a_cyclic_feature_value_is_an_error_on_the_feature",
      "description": "A feature that cannot be computed says so on itself, so the rest of the instance is still readable.",
      "rpc": "Instantiate",
      "requires_capabilities": [
        "feature_values"
      ],
      "model": {
        "fixture": "cyclic.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Demo::Cyclic"
      },
      "expect": {
        "contains": {
          "instance.feature_values.a.error": "cyclic"
        }
      }
    },
    {
      "id": "instantiate/a_valueless_feature_of_a_value_type_is_unset",
      "description": "A materialized feature holding no value uses the unset arm, which is not the model's null.",
      "rpc": "Instantiate",
      "requires_capabilities": [
        "unset_value"
      ],
      "model": {
        "fixture": "unset.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "P::Q"
      },
      "expect": {
        "response": {
          "instance": {
            "feature_values": {
              "d": {
                "materialized": true,
                "value": {
                  "unset": true
                }
              },
              "k": {
                "value": {
                  "real_value": 2.0
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "instantiate/a_complex_typed_feature_holds_one_complex_number",
      "description": "A Complex feature holds one value with both parts, and a Complex[2] feature holds two of them.",
      "rpc": "Instantiate",
      "requires_capabilities": [
        "complex_values",
        "feature_values"
      ],
      "model": {
        "fixture": "complex.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "C::Signal"
      },
      "expect": {
        "response": {
          "instance": {
            "feature_values": {
              "z": {
                "value": {
                  "complex": {
                    "real": 1.5,
                    "imaginary": -2.0
                  }
                }
              },
              "zs": {
                "values": [
                  {
                    "complex": {
                      "real": 1.0,
                      "imaginary": 2.0
                    }
                  },
                  {
                    "complex": {
                      "real": 3.0,
                      "imaginary": 4.0
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "id": "instantiate/an_enumeration_typed_feature_holds_the_literal",
      "rpc": "Instantiate",
      "requires_capabilities": [
        "enum_values"
      ],
      "model": {
        "fixture": "enumeration.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "D::Car"
      },
      "expect": {
        "response": {
          "instance": {
            "feature_values": {
              "c": {
                "value": {
                  "enum_literal": {
                    "literal_id": "D::Color::red"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "instantiate/an_unknown_symbol_is_reported_in_band",
      "rpc": "Instantiate",
      "model": {
        "fixture": "simple_part.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "symbol_id": "Test::DoesNotExist"
      },
      "expect": {
        "contains": {
          "error": "not found"
        }
      }
    },
    {
      "id": "instance_paths/an_object_never_created_is_not_found",
      "description": "InstancePaths on an object id nothing materialized answers NOT_FOUND: Instantiate creates the objects the paths lead to.",
      "rpc": "InstancePaths",
      "requires_capabilities": [
        "instance_paths"
      ],
      "expect_without_capability": {
        "status": "UNIMPLEMENTED",
        "status_message_contains": "instance_paths"
      },
      "model": {
        "fixture": "simple_part.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "object": {
          "instance_id": 99
        }
      },
      "expect": {
        "status": "NOT_FOUND",
        "status_message_contains": "no object #99"
      }
    },
    {
      "id": "instance_paths/a_request_naming_no_object_is_invalid",
      "description": "InstancePaths needs the object, by instance_id or by path.",
      "rpc": "InstancePaths",
      "requires_capabilities": [
        "instance_paths"
      ],
      "model": {
        "fixture": "simple_part.sysml"
      },
      "request": {
        "model_hash": "${model_hash}"
      },
      "expect": {
        "status": "INVALID_ARGUMENT",
        "status_message_contains": "neither was given"
      }
    }
  ]
}
