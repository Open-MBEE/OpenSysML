{
  "scenarios": [
    {
      "id": "execute_action/an_action_runs_and_reports_its_attributes",
      "description": "The action seeds result at 0 and adds five, so an unbound run answers five.",
      "rpc": "ExecuteAction",
      "model": {
        "fixture": "behavior.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "action_symbol_id": "Test::addFive"
      },
      "expect": {
        "response": {
          "outputs": {
            "result": {
              "int_value": 5
            }
          }
        },
        "absent": [
          "error"
        ]
      }
    },
    {
      "id": "execute_action/supplied_inputs_reach_the_action",
      "description": "Binding result to ten answers fifteen: inputs are not discarded server-side.",
      "rpc": "ExecuteAction",
      "model": {
        "fixture": "behavior.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "action_symbol_id": "Test::addFive",
        "inputs": {
          "result": {
            "int_value": 10
          }
        }
      },
      "expect": {
        "response": {
          "outputs": {
            "result": {
              "int_value": 15
            }
          }
        }
      }
    },
    {
      "id": "execute_action/an_action_with_no_initial_node_is_reported",
      "description": "Its successions form a cycle over every step, so none starts the flow; the failure surfaces when the action is initialized, as an error on the response.",
      "rpc": "ExecuteAction",
      "model": {
        "fixture": "behavior.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "action_symbol_id": "Test::noStart"
      },
      "expect": {
        "non_empty": [
          "error"
        ]
      }
    },
    {
      "id": "execute_action/the_default_schedule_takes_the_reverse_order",
      "description": "Two branches write winner in one step; under the default the later-declared branch runs first, so the first-declared write stands.",
      "rpc": "ExecuteAction",
      "model": {
        "fixture": "behavior.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "action_symbol_id": "Test::race"
      },
      "expect": {
        "response": {
          "outputs": {
            "winner": {
              "int_value": 1
            }
          }
        },
        "absent": [
          "error"
        ]
      }
    },
    {
      "id": "execute_action/a_schedule_selects_the_order_the_run_takes",
      "description": "Under declared the first-declared branch runs first, so the later-declared write stands; a service without the capability refuses the field rather than running under the default.",
      "rpc": "ExecuteAction",
      "requires_capabilities": [
        "schedule"
      ],
      "model": {
        "fixture": "behavior.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "action_symbol_id": "Test::race",
        "schedule": "declared"
      },
      "expect": {
        "response": {
          "outputs": {
            "winner": {
              "int_value": 2
            }
          }
        },
        "absent": [
          "error"
        ]
      },
      "expect_without_capability": {
        "status": "UNIMPLEMENTED",
        "status_message_contains": "schedule"
      }
    },
    {
      "id": "execute_action/a_schedule_naming_no_policy_is_invalid",
      "description": "The spelling is checked before anything runs: an unknown policy is refused, not run under the default.",
      "rpc": "ExecuteAction",
      "requires_capabilities": [
        "schedule"
      ],
      "model": {
        "fixture": "behavior.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "action_symbol_id": "Test::race",
        "schedule": "seed:abc"
      },
      "expect": {
        "status": "INVALID_ARGUMENT",
        "status_message_contains": "seed:abc"
      }
    },
    {
      "id": "execute_state/a_machine_reports_the_states_it_visited",
      "description": "The trace is the states really visited, in order, not a placeholder.",
      "rpc": "ExecuteState",
      "model": {
        "fixture": "behavior.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "state_machine_symbol_id": "Test::Machine"
      },
      "expect": {
        "response": {
          "states_visited": [
            "init",
            "Running",
            "done"
          ]
        },
        "absent": [
          "error"
        ]
      }
    },
    {
      "id": "execute_state/a_requested_trace_reports_transitions",
      "description": "A state run can return the transition records that explain how its states were reached.",
      "rpc": "ExecuteState",
      "requires_capabilities": [
        "state_trace"
      ],
      "model": {
        "fixture": "behavior.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "state_machine_symbol_id": "Test::Machine",
        "trace": true
      },
      "expect": {
        "min_counts": {
          "trace": 1
        },
        "contains_all": {
          "trace.*.kind": [
            "transition"
          ],
          "trace.*.text": [
            "transition: init -> Running",
            "transition: Running -> done"
          ]
        }
      },
      "expect_without_capability": {
        "status": "UNIMPLEMENTED",
        "status_message_contains": "state_trace"
      }
    },
    {
      "id": "execute_state/a_schedule_naming_no_policy_is_invalid",
      "rpc": "ExecuteState",
      "requires_capabilities": [
        "schedule"
      ],
      "model": {
        "fixture": "behavior.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "state_machine_symbol_id": "Test::Machine",
        "schedule": "random"
      },
      "expect": {
        "status": "INVALID_ARGUMENT",
        "status_message_contains": "random"
      }
    },
    {
      "id": "execute_state/an_unknown_symbol_is_reported_in_band",
      "rpc": "ExecuteState",
      "model": {
        "fixture": "behavior.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "state_machine_symbol_id": "Test::NoMachine"
      },
      "expect": {
        "non_empty": [
          "error"
        ]
      }
    },
    {
      "id": "execute_action/advance_stops_the_clock_before_the_run_completes",
      "description": "`advance` runs the action for that many simulated seconds; a run still waiting is an in-body failure that carries the clock it stopped at, as `sysml -advance` reports.",
      "rpc": "ExecuteAction",
      "model": {
        "fixture": "timed.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "action_symbol_id": "Timed::delayed",
        "advance": 2
      },
      "expect": {
        "contains": {
          "error": "without completing"
        },
        "response": {
          "final_time": 2
        }
      }
    },
    {
      "id": "execute_action/advance_past_the_wait_completes_the_run",
      "description": "An `advance` long enough for every wait completes the run and reports the clock where it stopped.",
      "rpc": "ExecuteAction",
      "model": {
        "fixture": "timed.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "action_symbol_id": "Timed::delayed",
        "advance": 10
      },
      "expect": {
        "absent": [
          "error"
        ],
        "response": {
          "outputs": {
            "count": {
              "int_value": 1
            }
          },
          "final_time": 10
        }
      }
    },
    {
      "id": "execute_action/clock_step_rounds_a_wait_up_to_the_next_tick",
      "description": "`clock_step` ticks the run's clock in fixed steps, so a five-second wait on a four-second clock ends at eight.",
      "rpc": "ExecuteAction",
      "model": {
        "fixture": "timed.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "action_symbol_id": "Timed::delayed",
        "clock_step": 4
      },
      "expect": {
        "absent": [
          "error"
        ],
        "response": {
          "outputs": {
            "count": {
              "int_value": 1
            }
          },
          "final_time": 8
        }
      }
    },
    {
      "id": "execute_action/an_unknown_draw_policy_is_refused",
      "description": "`draws` takes `random`, `min`, `max` or `average`; anything else is an invalid argument naming the field.",
      "rpc": "ExecuteAction",
      "model": {
        "fixture": "timed.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "action_symbol_id": "Timed::delayed",
        "draws": "sometimes"
      },
      "expect": {
        "status": "INVALID_ARGUMENT",
        "status_message_contains": "draw policy"
      }
    }
  ]
}
