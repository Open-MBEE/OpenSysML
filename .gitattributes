# Generated stubs and the fixtures tests compare against: GitHub collapses them in
# diffs and leaves them out of the language statistics. Hand-maintained prose,
# the docs/project/spec-compliance/ sources included, is not listed here.

# Protobuf and Connect stubs
api/proto/*.pb.go                                linguist-generated=true
api/proto/**/*.connect.go                        linguist-generated=true
client/node/src/generated/**                     linguist-generated=true
client/python/opensysml/proto/**                 linguist-generated=true
client/python/opensysml/metamodel/_generated.py  linguist-generated=true
client/rust/opensysml/src/proto/**               linguist-generated=true
client/dotnet/src/OpenMBEE.OpenSysML/Wire/**     linguist-generated=true
client/dotnet/src/OpenMBEE.OpenSysML.Metamodel/Generated.cs linguist-generated=true
client/rust/conformance/*.binpb                  linguist-generated=true -diff

# Golden files and expected outputs
client/dotnet/test/OpenMBEE.OpenSysML.Generate.Consumer/Golden/** linguist-generated=true
client/dotnet/test/testdata/metamodel/*.golden.cs linguist-generated=true
tests/**/*.golden.*                              linguist-generated=true
tests/**/*.expected.json                         linguist-generated=true
internal/**/testdata/**/*.golden.*               linguist-generated=true
internal/**/testdata/**/*.expected.json          linguist-generated=true
tests/export/testdata/**/*.ttl                   linguist-generated=true
tests/export/testdata/**/*.json                  linguist-generated=true
tests/export/testdata/**/*.json.gz               linguist-generated=true -diff
tests/export/testdata/**/*.sha256                linguist-generated=true

# Measured baselines and binary build inputs
docs/project/*-baseline.json                     linguist-generated=true
docs/project/hideo-suite-baseline.tsv            linguist-generated=true
docs/project/api-json-differential/**/*.json    linguist-generated=true
cmd/*/default.pgo                                linguist-generated=true -diff

# Count baselines two branches move on neighbouring lines: merged cell by cell once
# scripts/install-baseline-merge-driver.sh has configured the driver, by lines otherwise.
internal/semantic/metamodel/derived_census_records.tsv                  merge=opensysml-cells
internal/semantic/metamodel/derived_census_baseline.json                merge=opensysml-cells
internal/translate/export/testdata/structure_differential_expected.txt  merge=opensysml-cells
docs/project/api-json-differential/**/*.json                            merge=opensysml-cells
docs/project/pilot-differential-baseline.json                           merge=opensysml-cells
