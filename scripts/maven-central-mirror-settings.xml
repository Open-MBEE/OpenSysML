<?xml version="1.0" encoding="UTF-8"?>
<!-- Read by scripts/maven-sbom.sh as global settings before it asks Maven Central: Google's mirror of it answers for
     `central`, under the same id so what the local repository already holds is not fetched again. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <mirrors>
        <mirror>
            <id>central</id>
            <name>Google's mirror of Maven Central</name>
            <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
            <mirrorOf>central</mirrorOf>
        </mirror>
    </mirrors>
</settings>
