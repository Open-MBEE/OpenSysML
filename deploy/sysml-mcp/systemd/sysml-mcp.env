# Every sysml-mcp flag is read from OPENSYSML_MCP_<FLAG>: the flag's name in
# upper case with each dash an underscore. A variable left empty is unset.
# The address: loopback for a proxy on this machine to forward to, or
# 0.0.0.0:8765 to serve every interface, which needs the token and TLS.
OPENSYSML_MCP_HTTP=127.0.0.1:8765
# The bearer token every request must carry, in a file only the service reads.
OPENSYSML_MCP_TOKEN_FILE=/etc/sysml-mcp/mcp.token
# Where clients reach the server when a proxy in front terminates TLS.
OPENSYSML_MCP_PUBLIC_URL=https://models.example.org/mcp
# The workspace the server indexes and edits.
OPENSYSML_MCP_ROOT=/var/lib/sysml-mcp/models
OPENSYSML_MCP_LOG_LEVEL=info
# Serving TLS itself instead of behind a proxy:
#OPENSYSML_MCP_TLS_CERT=/etc/sysml-mcp/server.crt
#OPENSYSML_MCP_TLS_KEY=/etc/sysml-mcp/server.key
# Browser origins granted cross-origin access, comma-separated.
#OPENSYSML_MCP_ALLOW_ORIGIN=https://agents.example.org
# Bounds: how long a stop waits for connections, the largest request body.
#OPENSYSML_MCP_SHUTDOWN_TIMEOUT=30s
#OPENSYSML_MCP_MAX_BODY_BYTES=4194304
