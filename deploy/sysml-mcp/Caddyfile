# TLS in front of sysml-mcp. `tls internal` signs with Caddy's own CA (localhost,
# a LAN name); for a public name remove it and Caddy obtains a Let's Encrypt certificate.
{$MCP_HOST}:443 {
	tls internal
	reverse_proxy sysml-mcp:8765 {
		# Event streams stay open as long as a session does.
		flush_interval -1
	}
}
