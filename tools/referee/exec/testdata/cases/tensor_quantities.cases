model: tools/referee/exec/testdata/models/tensor_quantities.sysml

# TensorCalculations over a TensorQuantityValue (docs/project/spec-compliance.md,
# "Structured values"). The pinned pilot leaves every one of these unevaluated
# — the construction, the Array features, indexing, the operators and the
# calculations alike — so they land in pilot-unevaluated and the semantics are
# self-assessed against the vendored declarations.
tensor-construct ::  :: TensorQuantities::stress
tensor-dimensions ::  :: TensorQuantities::dims
tensor-flattened-size ::  :: TensorQuantities::size
tensor-index ::  :: TensorQuantities::corner
tensor-add ::  :: TensorQuantities::sum
tensor-scalar-mult ::  :: TensorQuantities::doubled
tensor-scalar-quantity-mult ::  :: TensorQuantities::stretched
tensor-is-zero ::  :: TensorQuantities::zero
tensor-is-unit ::  :: TensorQuantities::unit
tensor-tensor-mult ::  :: TensorQuantities::product
tensor-outer ::  :: TensorQuantities::outerProduct
tensor-is-zero-qualified ::  :: TensorCalculations::isZeroTensorQuantity(TensorQuantities::stress)
