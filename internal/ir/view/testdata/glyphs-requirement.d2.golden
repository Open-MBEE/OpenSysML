# NotationGlyphs::Diagrams::requirementGlyphs — requirement rendering (view def GeneralView, filter @RequirementDefinition or @RequirementUsage)
classes: {
  definition: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14 } }
  usage: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; border-radius: 8 } }
  annotation: { shape: page; style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14 } }
  edge: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
  specialization: { target-arrowhead: { shape: triangle; style: { filled: false } }; style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
  open: { target-arrowhead: { shape: arrow }; style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
}
n0: "«requirement def»\nLevelReq" { class: definition }
n1: "«requirement»\nlevelReq" { class: usage }
n2: "«requirement»\ncapacity" { class: usage }
n3: "«concern»\nsafety\n“Nothing overflows.”" { class: usage }
n4: "«doc»\nNothing overflows." { class: annotation }
n0 -> n3: "frame" { class: open }
n1 -> n0: { class: specialization }
n2 -> n1: "require" { class: open }
n4 -> n3: { class: edge }
frame_name: "«view» NotationGlyphs::Diagrams::requirementGlyphs : GeneralView" { shape: text; near: top-left }
frame_tr: "expose LevelReq\nexpose levelReq\nexpose capacity\nexpose safety" { shape: text; near: top-right }
frame_bl: "filter @SysML::RequirementDefinition or @SysML::RequirementUsage" { shape: text; near: bottom-left }
