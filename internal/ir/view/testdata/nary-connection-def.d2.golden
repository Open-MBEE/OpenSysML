# NaryViews::definitions — tree rendering (render asTreeDiagram)
classes: {
  definition: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14 } }
  dot: { shape: oval; width: 18; height: 18; style: { fill: black; stroke: black; font-size: 14 }; label.near: outside-bottom-center }
  edge: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
}
n0: "Nary::Triad" { class: dot }
n4: "«part def»\nHub" { class: definition }
n5: "«part def»\nSpoke" { class: definition }
n0 -- n4: { class: edge; target-arrowhead: { label: "hub" } }
n0 -- n5: { class: edge; target-arrowhead: { label: "left" } }
n0 -- n5: { class: edge; target-arrowhead: { label: "right" } }
