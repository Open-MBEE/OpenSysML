  "n2" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td port="n2.0" border="1" fixedsize="true" width="10" height="10"></td><td align="left"><font point-size="8">bread</font></td></tr><tr><td colspan="2"><font point-size="10"><i>«action def»</i></font><br/><b>Heat</b></td></tr><tr><td port="n2.1" border="1" fixedsize="true" width="10" height="10"></td><td align="left"><font point-size="8">toast</font></td></tr></table>>];
  "n3" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td port="n3.0" border="1" fixedsize="true" width="10" height="10"></td><td align="left"><font point-size="8">low</font></td><td port="n3.1" border="1" fixedsize="true" width="10" height="10"></td><td align="left"><font point-size="8">value</font></td></tr><tr><td colspan="4"><font point-size="10"><i>«constraint def»</i></font><br/><b>Between</b></td></tr></table>>];
