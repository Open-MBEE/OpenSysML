  "n0" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td port="n0.0" border="1" fixedsize="true" width="10" height="10"></td><td align="left"><font point-size="8">x</font></td><td port="n0.1" border="1" fixedsize="true" width="10" height="10"></td><td align="left"><font point-size="8">y</font></td></tr><tr><td colspan="4"><font point-size="10"><i>«calc def»</i></font><br/><b>Add</b></td></tr><tr><td port="n0.2" border="1" fixedsize="true" width="10" height="10"></td><td align="left"><font point-size="8">result</font></td></tr></table>>];
