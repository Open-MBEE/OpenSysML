---
config:
  fontFamily: "Helvetica, Arial, sans-serif"
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; } .cluster-label .nodeLabel { text-align: center; }"
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
---
%% VehicleViews::vehicleView — tree rendering
flowchart TD
  n0["`*«part def»*
**Vehicles::Vehicle**`"]
    n1("`*«part»*
**engine : Engine**`")
  n0 --- n1
    n2("`*«part»*
**wheels : Wheel**`")
  n0 --- n2
    n3("`**connect**`")
  n0 --- n3
  n4("`*«view»*
**VehicleViews::vehicleView::engineSubview**`")
    n5["`*«part def»*
**Vehicles::Engine**`"]
      n6("`*«attribute»*
**power**`")
  n5 --- n6
      n7("`*«part»*
**cylinder : Cylinder**`")
  n5 --- n7
  n4 --- n5
  n0 ---|"◆ engine"| n5
