---
config:
  fontFamily: "Helvetica, Arial, sans-serif"
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; }"
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
---
%% VehicleViews::vehicleView — tree rendering
flowchart TD
  n0["`**Vehicles::Vehicle**
*«part def»*`"]
    n1("`**engine : Engine**
*«part»*`")
    n2("`**wheels : Wheel**
*«part»*`")
    n3("`**connect**`")
  n0 --- n1
  n0 --- n2
  n0 --- n3
  n4("`**VehicleViews::vehicleView::engineSubview**
*«view»*`")
    n5["`**Vehicles::Engine**
*«part def»*`"]
      n6("`**power**
*«attribute»*`")
      n7("`**cylinder : Cylinder**
*«part»*`")
  n5 --- n6
  n5 --- n7
  n4 --- n5
