---
config:
  fontFamily: "Helvetica, Arial, sans-serif"
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; } .cluster-label .nodeLabel { text-align: center; }"
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
---
%% VehicleViews::vehicleView — tree rendering
flowchart TD
  n0["`*«part def»*
**Vehicle**`"]
    n1("`*«part»*
**engine**`")
      n2("`*«attribute»*
**power**`")
  n1 --- n2
      n3("`*«part»*
**cylinder**`")
  n1 --- n3
  n0 --- n1
    n4("`*«part»*
**wheels**`")
  n0 --- n4
    n5("`**connect**`")
  n0 --- n5
  n6("`*«view»*
**engineSubview**`")
    n7["`*«part def»*
**Engine**`"]
      n8("`*«attribute»*
**power**`")
  n7 --- n8
      n9("`*«part»*
**cylinder**`")
  n7 --- n9
  n6 --- n7
  n0 ---|"◆ engine"| n7
