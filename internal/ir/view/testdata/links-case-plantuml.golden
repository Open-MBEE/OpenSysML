@startuml
' CaseExamples::caseDiagram — case rendering (render asCaseDiagram)
' not represented: part def CaseExamples::Tool holds no case; a case rendering does not show it
<style>
root {
  BackGroundColor white
  FontName SansSerif
  FontSize 14
  FontColor black
  LineColor #181818
  HorizontalAlignment left
}
element {
  BackGroundColor white
  LineColor #181818
  LineThickness 0.5
  RoundCorner 0
  Shadowing 0.0
}
start, end, activityBar {
  BackGroundColor black
}
arrow {
  LineColor #181818
  LineThickness 1
  FontSize 13
}
note {
  BackGroundColor #FEFFDD
  FontSize 13
}
.usage {
  RoundCorner 20
}
.package {
  LineThickness 1.5
}
.region {
  LineStyle 4
}
</style>
skinparam wrapWidth 300
hide stereotype
left to right direction
usecase "<size:10>//«use case»//</size>\n**CaseExamples::'Provide Transportation' : 'Enter Vehicle'**" as n0 <<use case>> <<usage>> [[https://example.test/src/case.sysml#L26]]
rectangle "<size:10>//«subject»//</size>\n**vehicle : Vehicle**" as n1 <<subject>> <<usage>> [[https://example.test/src/case.sysml#L27]]
actor "<size:10>//«actor»//</size>\n**driver : Person**" as n2 <<actor>> <<usage>> [[https://example.test/src/case.sysml#L28]]
note as n3
  [[https://example.test/src/case.sysml#L29 **objective**]]
  [[https://example.test/src/case.sysml#L29 Transport the vehicle and its passengers safely.]]
end note
usecase "<size:10>//«use case def»//</size>\n**CaseExamples::'Add Fuel'**" as n4 <<use case def>> [[https://example.test/src/case.sysml#L16]]
rectangle "<size:10>//«subject»//</size>\n**vehicle : Vehicle**" as n5 <<subject>> <<usage>> [[https://example.test/src/case.sysml#L17]]
actor "<size:10>//«actor»//</size>\n**fueler : Person**" as n6 <<actor>> <<usage>> [[https://example.test/src/case.sysml#L18]]
usecase "<size:10>//«include use case»//</size>\n**'enter vehicle' : 'Enter Vehicle'**" as n7 <<include use case>> <<usage>> [[https://example.test/src/case.sysml#L38]]
rectangle "<size:10>//«subject»//</size>\n**vehicle**" as n8 <<subject>> <<usage>> [[https://example.test/src/case.sysml#L39]]
actor "<size:10>//«actor»//</size>\n**driver**" as n9 <<actor>> <<usage>> [[https://example.test/src/case.sysml#L40]]
usecase "<size:10>//«use case»//</size>\n**'Drive Vehicle'**" as n10 <<use case>> <<usage>> [[https://example.test/src/case.sysml#L43]]
rectangle "<size:10>//«subject»//</size>\n**vehicle**" as n11 <<subject>> <<usage>> [[https://example.test/src/case.sysml#L44]]
actor "<size:10>//«actor»//</size>\n**driver**" as n12 <<actor>> <<usage>> [[https://example.test/src/case.sysml#L45]]
usecase "<size:10>//«analysis def»//</size>\n**CaseExamples::FuelAnalysis**" as n13 <<analysis def>> [[https://example.test/src/case.sysml#L49]]
rectangle "<size:10>//«subject»//</size>\n**vehicle : Vehicle**" as n14 <<subject>> <<usage>> [[https://example.test/src/case.sysml#L50]]
note as n15
  [[https://example.test/src/case.sysml#L51 **objective**]]
  [[https://example.test/src/case.sysml#L51 Estimate the fuel remaining after a journey.]]
end note
usecase "<size:10>//«verification def»//</size>\n**CaseExamples::FuelVerification**" as n16 <<verification def>> [[https://example.test/src/case.sysml#L56]]
rectangle "<size:10>//«subject»//</size>\n**vehicle : Vehicle**" as n17 <<subject>> <<usage>> [[https://example.test/src/case.sysml#L57]]
note as n18
  [[https://example.test/src/case.sysml#L58 **objective**]]
end note
n0 -- n1 : <U+00AB>subject<U+00BB> [[https://example.test/src/case.sysml#L27]]
n2 -- n0 : [[https://example.test/src/case.sysml#L28]]
n0 .. n3 : [[https://example.test/src/case.sysml#L29]]
n4 -- n5 : <U+00AB>subject<U+00BB> [[https://example.test/src/case.sysml#L17]]
n6 -- n4 : [[https://example.test/src/case.sysml#L18]]
n0 ..> n4 : <U+00AB>include<U+00BB> [[https://example.test/src/case.sysml#L33]]
n0 ..> n7 : <U+00AB>include<U+00BB> [[https://example.test/src/case.sysml#L38]]
n7 -- n8 : <U+00AB>subject<U+00BB> [[https://example.test/src/case.sysml#L39]]
n9 -- n7 : [[https://example.test/src/case.sysml#L40]]
n0 *-- n10 : [[https://example.test/src/case.sysml#L43]]
n10 -- n11 : <U+00AB>subject<U+00BB> [[https://example.test/src/case.sysml#L44]]
n12 -- n10 : [[https://example.test/src/case.sysml#L45]]
n13 -- n14 : <U+00AB>subject<U+00BB> [[https://example.test/src/case.sysml#L50]]
n13 .. n15 : [[https://example.test/src/case.sysml#L51]]
n16 -- n17 : <U+00AB>subject<U+00BB> [[https://example.test/src/case.sysml#L57]]
n16 .. n18 : [[https://example.test/src/case.sysml#L58]]
@enduml
