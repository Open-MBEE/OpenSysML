@startuml
' CaseExamples::caseDiagram — case rendering (render asCaseDiagram)
' not represented: part def CaseExamples::Tool holds no case; a case rendering does not show it
<style>
root {
  BackGroundColor white
  FontName SansSerif
  FontSize 14
  FontColor black
  LineColor #181818
  HorizontalAlignment left
}
element {
  BackGroundColor white
  LineColor #181818
  LineThickness 0.5
  RoundCorner 0
  Shadowing 0.0
}
start, end, activityBar {
  BackGroundColor black
}
arrow {
  LineColor #181818
  LineThickness 1
  FontSize 13
}
note {
  BackGroundColor #FEFFDD
  FontSize 13
}
.usage {
  RoundCorner 20
}
.package {
  LineThickness 1.5
}
.region {
  LineStyle 4
}
</style>
skinparam wrapWidth 300
hide stereotype
left to right direction
usecase "<size:10>//«use case»//</size>\n**'Provide Transportation'**" as n0 <<use case>> <<usage>> [[https://example.test/src/case.sysml#L27]]
rectangle "<size:10>//«subject»//</size>\n**vehicle**" as n1 <<subject>> <<usage>> [[https://example.test/src/case.sysml#L28]]
actor "<size:10>//«actor»//</size>\n**driver**" as n2 <<actor>> <<usage>> [[https://example.test/src/case.sysml#L29]]
note as n3
  **[[https://example.test/src/case.sysml#L30 objective]]**
  [[https://example.test/src/case.sysml#L30 Transport the vehicle and its passengers safely.]]
end note
usecase "<size:10>//«use case»//</size>\n**addFuel**" as n4 <<use case>> <<usage>> [[https://example.test/src/case.sysml#L25]]
actor "<size:10>//«actor»//</size>\n**fueler**" as n5 <<actor>> <<usage>> [[https://example.test/src/case.sysml#L18]]
rectangle "<size:10>//«subject»//</size>\n**vehicle**" as n6 <<subject>> <<usage>> [[https://example.test/src/case.sysml#L17]]
usecase "<size:10>//«include use case»//</size>\n**'enter vehicle'**" as n7 <<include use case>> <<usage>> [[https://example.test/src/case.sysml#L39]]
rectangle "<size:10>//«subject»//</size>\n**vehicle**" as n8 <<subject>> <<usage>> [[https://example.test/src/case.sysml#L40]]
actor "<size:10>//«actor»//</size>\n**driver**" as n9 <<actor>> <<usage>> [[https://example.test/src/case.sysml#L41]]
usecase "<size:10>//«use case»//</size>\n**'Drive Vehicle'**" as n10 <<use case>> <<usage>> [[https://example.test/src/case.sysml#L44]]
rectangle "<size:10>//«subject»//</size>\n**vehicle**" as n11 <<subject>> <<usage>> [[https://example.test/src/case.sysml#L45]]
actor "<size:10>//«actor»//</size>\n**driver**" as n12 <<actor>> <<usage>> [[https://example.test/src/case.sysml#L46]]
usecase "<size:10>//«analysis def»//</size>\n**FuelAnalysis**" as n13 <<analysis def>> [[https://example.test/src/case.sysml#L50]]
rectangle "<size:10>//«subject»//</size>\n**vehicle**" as n14 <<subject>> <<usage>> [[https://example.test/src/case.sysml#L51]]
note as n15
  **[[https://example.test/src/case.sysml#L52 objective]]**
  [[https://example.test/src/case.sysml#L52 Estimate the fuel remaining after a journey.]]
end note
usecase "<size:10>//«verification def»//</size>\n**FuelVerification**" as n16 <<verification def>> [[https://example.test/src/case.sysml#L57]]
rectangle "<size:10>//«subject»//</size>\n**vehicle**" as n17 <<subject>> <<usage>> [[https://example.test/src/case.sysml#L58]]
note as n18
  **[[https://example.test/src/case.sysml#L59 objective]]**
end note
n0 -- n1 : <U+00AB>subject<U+00BB> [[https://example.test/src/case.sysml#L28]]
n2 -- n0 : [[https://example.test/src/case.sysml#L29]]
n0 .. n3 : [[https://example.test/src/case.sysml#L30]]
n5 -- n4 : [[https://example.test/src/case.sysml#L18]]
n4 -- n6 : <U+00AB>subject<U+00BB> [[https://example.test/src/case.sysml#L17]]
n0 ..> n4 : <U+00AB>include<U+00BB> [[https://example.test/src/case.sysml#L34]]
n0 ..> n7 : <U+00AB>include<U+00BB> [[https://example.test/src/case.sysml#L39]]
n7 -- n8 : <U+00AB>subject<U+00BB> [[https://example.test/src/case.sysml#L40]]
n9 -- n7 : [[https://example.test/src/case.sysml#L41]]
n0 *-- n10 : [[https://example.test/src/case.sysml#L44]]
n10 -- n11 : <U+00AB>subject<U+00BB> [[https://example.test/src/case.sysml#L45]]
n12 -- n10 : [[https://example.test/src/case.sysml#L46]]
n13 -- n14 : <U+00AB>subject<U+00BB> [[https://example.test/src/case.sysml#L51]]
n13 .. n15 : [[https://example.test/src/case.sysml#L52]]
n16 -- n17 : <U+00AB>subject<U+00BB> [[https://example.test/src/case.sysml#L58]]
n16 .. n18 : [[https://example.test/src/case.sysml#L59]]
@enduml
