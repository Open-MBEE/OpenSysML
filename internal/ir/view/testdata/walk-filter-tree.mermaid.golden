---
config:
  fontFamily: "Helvetica, Arial, sans-serif"
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; } .cluster-label .nodeLabel { text-align: center; }"
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
---
%% FilteredWalk::structure — tree rendering (render asTreeDiagram)
flowchart TD
  n0("`*«part»*
**rover**`")
    n1("`*«part»*
**chassis**`")
      n2("`*«part»*
**axle**`")
    n3("`*«part»*
**radio**`")
      n4("`*«port»*
**rx**`")
    n5("`*«part»*
**gps**`")
    n6("`**connect**`")
  n0 --- n6
    n7("`**connect**`")
  n0 --- n7
  n0 ---|"◆"| n1
  n0 ---|"◆"| n3
  n0 ---|"◆"| n5
  n1 ---|"◆"| n2
  n3 ---|"◇"| n4
