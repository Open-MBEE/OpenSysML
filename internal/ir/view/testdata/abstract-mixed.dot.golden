// view: AbstractViews::familyMixed
// kind: mixed
// stated: render asMixedDiagram
// layout: dot
digraph "AbstractViews::familyMixed" {
  graph [fontname="Helvetica", compound=true];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  subgraph "cluster_frame" {
    label=<<font point-size="10"><i>«view»</i></font> <b>AbstractViews::familyMixed</b> : Family>;
    labeljust=l;
    labelloc=t;
    penwidth=0.5;
    margin=8;
    subgraph "cluster_n1" {
      label=<<font point-size="10"><i>«abstract part def»</i></font><br/><b>Vehicle</b>>;
      color=black;
      penwidth=0.5;
      "n1" [shape=point, style=invis, width=0, height=0, label=""];
      "n0" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>mass</b>>];
    }
    subgraph "cluster_n2" {
      label=<<font point-size="10"><i>«abstract part»</i></font><br/><b>vehicleFamily</b>>;
      color=black;
      penwidth=0.5;
      "n2" [shape=point, style=invis, width=0, height=0, label=""];
      "n3" [style="rounded,filled", label=<<font point-size="10"><i>«abstract port»</i></font><br/><b>fuel</b>>];
      "n4" [style="rounded,filled", label=<<font point-size="10"><i>«abstract part»</i></font><br/><b>engine</b>>];
      "n5" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>chassis</b>>];
    }
    subgraph "cluster_n6" {
      label=<<font point-size="10"><i>«variation part def»</i></font><br/><b>Models</b>>;
      color=black;
      penwidth=0.5;
      "n6" [shape=point, style=invis, width=0, height=0, label=""];
      subgraph "cluster_n7" {
        label=<<font point-size="10"><i>«variant»</i></font><br/><b>sedan</b>>;
        color=black;
        penwidth=0.5;
        "n7" [shape=point, style=invis, width=0, height=0, label=""];
        "n8" [style="rounded,filled", label=<<font point-size="10"><i>«abstract part»</i></font><br/><b>^engine</b>>];
        "n9" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>^chassis</b>>];
      }
    }
    { rank=min; "frame_tr" [shape=none, margin=0, label=<<font point-size="10">expose Vehicle**<br/>expose vehicleFamily**<br/>expose Models**</font>>]; }
  }
  "n4" -> "n5" [arrowhead=none, penwidth=3];
  "n8" -> "n9" [arrowhead=none, penwidth=3];
  "n2" -> "n1" [arrowhead=empty, class=definition, ltail="cluster_n2", lhead="cluster_n1"];
  "n6" -> "n1" [arrowhead=empty, ltail="cluster_n6", lhead="cluster_n1"];
}
