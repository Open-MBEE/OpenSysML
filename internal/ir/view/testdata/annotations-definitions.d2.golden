# AnnotationViews::definitions — definition rendering (view def GeneralView, filter @PartDefinition; @Definition)
classes: {
  definition: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14 } }
  annotation: { shape: page; style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14 } }
  edge: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
  composition: { source-arrowhead: { shape: diamond; style: { filled: true } }; style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
}
n0: "«part def»\nPump" { class: definition }
n1: "«part def»\nTank" { class: definition }
n2: "«part def»\nValve" { class: definition }
n3: "«part def»\nSeat" { class: definition }
n4: "«doc»\nMoves fluid from the tank to the loop." { class: annotation }
n5: "Sized for the nominal flow." { class: annotation }
n6: "«comment»\nSafety\nlocale \"en\"\nBoth are rated for the loop pressure." { class: annotation }
n7: "«rep»\ninline\nlanguage \"plantuml\"\ncomponent Pump" { class: annotation }
n8: "«doc»\nCapacity\nlocale \"en\"\nHolds the working fluid." { class: annotation }
n9: "«doc»\nCloses the loop." { class: annotation }
n2 <- n3: { class: composition; target-arrowhead: { label: "seat" } }
n4 -> n0: { class: edge }
n5 -> n0: { class: edge }
n6 -> n0: { class: edge }
n6 -> n1: { class: edge }
n7 -> n0: { class: edge }
n8 -> n1: { class: edge }
n9 -> n2: { class: edge }
frame_name: "«view» AnnotationViews::definitions : GeneralView" { shape: text; near: top-left }
frame_tr: "expose Annotated*[@SysML::Definition]" { shape: text; near: top-right }
frame_bl: "filter @SysML::PartDefinition" { shape: text; near: bottom-left }
