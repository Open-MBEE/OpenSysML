# ParameterCalcViews::calculations — tree rendering (render asTreeDiagram)
classes: {
  definition: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14 } }
  usage: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; border-radius: 8 } }
  pin: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 10 } }
  edge: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
  reference: { source-arrowhead: { shape: diamond; style: { filled: false } }; style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
}
n0: "«calc»\nadd" {
  class: usage
  "n0.0": "in x" { class: pin }
  "n0.1": "in y" { class: pin }
  "n0.2": "out result" { class: pin }
}
n1: "«part def»\nSensor" { class: definition }
n2: "«attribute»\na" { class: usage }
n3: "«attribute»\nb" { class: usage }
n4: "«attribute»\ngain" { class: usage }
n5: "«calc»\nsum" {
  class: usage
  "n5.0": "in x" { class: pin }
  "n5.1": "in ^y" { class: pin }
  "n5.2": "out ^result" { class: pin }
}
n6: "«calc»\nscaled" {
  class: usage
  "n6.0": "in factor" { class: pin }
  "n6.1": "in ^x" { class: pin }
  "n6.2": "inout ^count" { class: pin }
  "n6.3": "out ^doubled" { class: pin }
  "n6.4": "out ^r" { class: pin }
}
n1 -- n5: { class: edge }
n1 -- n6: { class: edge }
n1 <- n2: { class: reference }
n1 <- n3: { class: reference }
n1 <- n4: { class: reference }
