MachineViews::vehicleStates - state rendering (view def StateTransitionView)

state def VehicleStates
  state transition
  start
  state off (initial)
  state operating
    state transition
    start
    state idle (initial)
    state moving

transitions:
  start of VehicleStates -> off
  start of operating -> idle
  off -> operating
  operating -> off
  idle -> moving: accept Signal [temperature > 0]
  moving -> idle
