// view: GeneralViews::definitionView
// kind: definition
// stated: view def GeneralView, filter @Definition or @Usage
// layout: dot
digraph "GeneralViews::definitionView" {
  graph [fontname="Helvetica"];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  "n0" [label=<<font point-size="10"><i>«part def»</i></font><br/><b>Vehicle</b>>];
  "n1" [label=<<font point-size="10"><i>«part def»</i></font><br/><b>Chassis</b>>];
  "n2" [label=<<font point-size="10"><i>«part def»</i></font><br/><b>LightChassis</b>>];
  "n3" [label=<<font point-size="10"><i>«part def»</i></font><br/><b>Driver</b>>];
  "n4" [label=<<font point-size="10"><i>«action def»</i></font><br/><b>Brake</b>>];
  "n5" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>vehicle</b>>];
  "n6" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>heavyVehicle</b>>];
  "n7" [style="rounded,filled", label=<<font point-size="10"><i>«action»</i></font><br/><b>brake</b>>];
  "n8" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>Vehicle::mass</b>>];
  "n9" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>chassis</b>>];
  "n10" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>driver</b>>];
  "n11" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>vehicle::mass</b>>];
  "n12" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>heavyVehicle::mass</b>>];
  "n13" [label=<<font point-size="10"><i>«part def»</i></font><br/><b>Engine</b>>];
  "n2" -> "n1" [arrowhead=empty];
  "n5" -> "n0" [arrowhead=onormaldotdot];
  "n6" -> "n0" [arrowhead=onormaldotdot];
  "n7" -> "n4" [arrowhead=onormaldotdot];
  "n0" -> "n8" [dir=back, arrowtail=odiamond];
  "n9" -> "n1" [arrowhead=onormaldotdot];
  "n0" -> "n9" [dir=back, arrowtail=diamond];
  "n10" -> "n3" [arrowhead=onormaldotdot];
  "n0" -> "n10" [dir=back, arrowtail=odiamond];
  "n11" -> "n8" [arrowhead=onormaltee];
  "n5" -> "n11" [dir=back, arrowtail=odiamond];
  "n12" -> "n8" [arrowhead=onormaltee];
  "n6" -> "n12" [dir=back, arrowtail=odiamond];
}
