// view: InheritedPrefixViews::rigLinks
// kind: interconnection
// stated: render asInterconnectionDiagram
// layout: dot
digraph "InheritedPrefixViews::rigLinks" {
  graph [fontname="Helvetica", compound=true];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  subgraph "cluster_n0" {
    label=<<font point-size="10"><i>«part def»</i></font><br/><b>Rig</b>>;
    color=black;
    penwidth=0.5;
    "n0" [shape=point, style=invis, width=0, height=0, label=""];
    subgraph "cluster_n1" {
      label=<<font point-size="10"><i>«part»</i></font><br/><b>a</b>>;
      color=black;
      penwidth=0.5;
      "n1" [shape=point, style=invis, width=0, height=0, label=""];
      "n1.0" [shape=box, label="", xlabel="^aPort", fontsize=8, width=0.16666666666666666, height=0.16666666666666666, fixedsize=true];
      "n2" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>^mass</b>>];
      "n3" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>^engine</b>>];
    }
    subgraph "cluster_n4" {
      label=<<font point-size="10"><i>«part»</i></font><br/><b>b</b>>;
      color=black;
      penwidth=0.5;
      "n4" [shape=point, style=invis, width=0, height=0, label=""];
      "n5" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>^mass</b>>];
      "n6" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>^cooler</b>>];
      "n7" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>^engine</b>>];
    }
    subgraph "cluster_n8" {
      label=<<font point-size="10"><i>«part»</i></font><br/><b>c</b>>;
      color=black;
      penwidth=0.5;
      "n8" [shape=point, style=invis, width=0, height=0, label=""];
      "n9" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>^mass</b>>];
      "n10" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>^engine</b>>];
    }
    subgraph "cluster_n11" {
      label=<<font point-size="10"><i>«part»</i></font><br/><b>d</b>>;
      color=black;
      penwidth=0.5;
      "n11" [shape=point, style=invis, width=0, height=0, label=""];
      "n11.0" [shape=box, label="", xlabel="^aPort", fontsize=8, width=0.16666666666666666, height=0.16666666666666666, fixedsize=true];
      "n12" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>mass</b>>];
      "n13" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>^engine</b>>];
    }
  }
  "n1.0" -> "n11.0" [arrowhead=none, penwidth=3];
}
