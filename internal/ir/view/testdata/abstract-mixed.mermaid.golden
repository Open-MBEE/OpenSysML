---
config:
  fontFamily: "Helvetica, Arial, sans-serif"
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; } .cluster-label .nodeLabel { text-align: center; }"
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
---
%% AbstractViews::familyMixed — mixed rendering (render asMixedDiagram)
flowchart TD
  subgraph n1 ["`*«abstract part def»* **Vehicle**`"]
    direction TD
    n1_anchor[" "]
    n0("`*«attribute»*
**AbstractViews::Vehicle::mass**`")
  end
  n0("`*«attribute»*
**AbstractViews::Vehicle::mass**`")
  subgraph n2 ["`*«abstract part»* **vehicleFamily**`"]
    direction TD
    n2_anchor[" "]
    n3("`*«abstract port»*
**fuel**`")
    n4("`*«abstract part»*
**engine**`")
    n5("`*«part»*
**chassis**`")
  end
  subgraph n6 ["`*«variation part def»* **Models**`"]
    direction TD
    n6_anchor[" "]
    subgraph n7 ["`*«variant»* **sedan**`"]
      direction TD
      n8("`*«abstract part»*
**engine**`")
      n9("`*«part»*
**chassis**`")
    end
  end
  n4 === n5
  n8 === n9
  n2_anchor -.-> n1_anchor
  n6_anchor -->|"«specializes»"| n1_anchor
  classDef anchor fill:none,stroke:none
  class n1_anchor,n2_anchor,n6_anchor anchor
  linkStyle 0 stroke-width:3px
  linkStyle 1 stroke-width:3px
