---
config:
  theme: base
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    clusterBkg: "#FFFFFF"
    edgeLabelBackground: "#FFFFFF"
    primaryBorderColor: "#181818"
    lineColor: "#181818"
    clusterBorder: "#181818"
    noteBorderColor: "#181818"
    primaryTextColor: "#000000"
    textColor: "#000000"
    noteTextColor: "#000000"
    noteBkgColor: "#FEFFDD"
    stateBkg: "#FFFFFF"
    stateBorder: "#181818"
    stateLabelColor: "#000000"
    compositeBackground: "#FFFFFF"
    compositeBorder: "#181818"
    compositeTitleBackground: "#FFFFFF"
    compositeTitleBorder: "#181818"
    actorBkg: "#FFFFFF"
    actorBorder: "#181818"
    actorTextColor: "#000000"
    signalColor: "#181818"
    signalTextColor: "#000000"
    labelBoxBkgColor: "#FFFFFF"
    labelBoxBorderColor: "#181818"
    labelTextColor: "#000000"
    actorLineColor: "#181818"
    loopTextColor: "#000000"
    activationBorderColor: "#181818"
    activationBkgColor: "#FFFFFF"
    sequenceNumberColor: "#000000"
    transitionColor: "#181818"
    transitionLabelColor: "#000000"
    labelBackgroundColor: "#FFFFFF"
    specialStateColor: "#181818"
---
%% MachineViews::thermostat — state rendering (view def StateTransitionView)
stateDiagram-v2
  state "Thermostat<br>«state def»" as n0 {
    state "heating<br>«state»" as n1
    state "idle<br>«state»" as n2 {
      state "drying<br>«state»" as n3
      state "resting<br>«state»" as n4
      [*] --> n3 : [wet]
      [*] --> n4
    }
    state "monitoring<br>«state»" as n5 {
      state "lights<br>«region»" as n6 {
        state "lit<br>«state»" as n8
        state "unlit<br>«state»" as n9
        [*] --> n8 : [dark]
        [*] --> n9 : [not dark]
      }
      state "fans<br>«region»" as n7 {
        state "off<br>«state»<br>initial" as n10
        state "on<br>«state»" as n11
        [*] --> n10
      }
    }
    [*] --> n1 : [cold]
    [*] --> n2 : [not cold]
  }
  n1 --> n2
  n2 --> n5
  n10 --> n11
