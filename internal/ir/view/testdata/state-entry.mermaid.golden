%% MachineViews::thermostat — state rendering (view def StateTransitionView)
stateDiagram-v2
  state "«state def»<br>Thermostat" as n0 {
    state "«state»<br>heating" as n1
    state "«state»<br>idle" as n2 {
      state "«state»<br>drying" as n3
      state "«state»<br>resting" as n4
      [*] --> n3 : [wet]
      [*] --> n4
    }
    state "«state»<br>monitoring" as n5 {
      state "«region»<br>lights" as n6 {
        state "«state»<br>lit" as n8
        state "«state»<br>unlit" as n9
        [*] --> n8 : [dark]
        [*] --> n9 : [not dark]
      }
      state "«region»<br>fans" as n7 {
        state "«state»<br>off<br>initial" as n10
        state "«state»<br>on" as n11
        [*] --> n10
      }
    }
    [*] --> n1 : [cold]
    [*] --> n2 : [not cold]
  }
  n1 --> n2
  n2 --> n5
  n10 --> n11
