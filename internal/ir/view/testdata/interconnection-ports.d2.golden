# ToasterViews::toasterView — interconnection rendering (render asInterconnectionDiagram)
classes: {
  definition: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14 } }
  usage: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; border-radius: 8 } }
  pin: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 10 } }
  connection: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 3 } }
  flow: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1; stroke-dash: 3 } }
}
n0: "«part def»\nToaster" {
  class: definition
  n1: "«part»\nheating : HeatingSystem" {
    class: usage
    "n1.0": "durationIn" { class: pin }
  }
  n2: "«part»\ncontrol : ControlSystem" {
    class: usage
    "n2.0": "durationOut" { class: pin }
  }
  n3: "«part»\nchassis : Chassis" { class: usage }
}
n0.n2."n2.0" -- n0.n1."n1.0": "durationInterface" { class: connection }
n0.n2."n2.0" -> n0.n1."n1.0": "of Real" { class: flow }
