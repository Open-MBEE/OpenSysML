@startuml
' UseCaseViews::useCaseView — case rendering (view def GeneralView, filter @UseCaseUsage)
<style>
root {
  BackGroundColor white
  FontName SansSerif
  FontSize 14
  FontColor black
  LineColor #181818
  HorizontalAlignment left
}
element {
  BackGroundColor white
  LineColor #181818
  LineThickness 0.5
  RoundCorner 0
  Shadowing 0.0
}
start, end, activityBar {
  BackGroundColor black
}
arrow {
  LineColor #181818
  LineThickness 1
  FontSize 13
}
note {
  BackGroundColor #FEFFDD
  FontSize 13
}
.usage {
  RoundCorner 20
}
.package {
  LineThickness 1.5
}
.region {
  LineStyle 4
}
</style>
skinparam wrapWidth 300
hide stereotype
left to right direction
usecase "<size:10>//«use case»//</size>\n**VehicleUseCases::'Provide Transportation'**" as n0 <<use case>> <<usage>> [[https://example.test/src/general-case.sysml#L13]]
rectangle "<size:10>//«subject»//</size>\n**vehicle : Vehicle**" as n1 <<subject>> <<usage>> [[https://example.test/src/general-case.sysml#L14]]
actor "<size:10>//«actor»//</size>\n**driver : Person**" as n2 <<actor>> <<usage>> [[https://example.test/src/general-case.sysml#L15]]
actor "<size:10>//«actor»//</size>\n**passengers : Person**" as n3 <<actor>> <<usage>> [[https://example.test/src/general-case.sysml#L16]]
note as n4
  **[[https://example.test/src/general-case.sysml#L17 objective]]**
  [[https://example.test/src/general-case.sysml#L17 Deliver the driver and passengers to their destination.]]
end note
usecase "<size:10>//«include use case»//</size>\n**addFuel : 'Add Fuel'**" as n5 <<include use case>> <<usage>> [[https://example.test/src/general-case.sysml#L20]]
rectangle "<size:10>//«subject»//</size>\n**vehicle**" as n6 <<subject>> <<usage>> [[https://example.test/src/general-case.sysml#L21]]
actor "<size:10>//«actor»//</size>\n**fueler**" as n7 <<actor>> <<usage>> [[https://example.test/src/general-case.sysml#L22]]
usecase "<size:10>//«include use case»//</size>\n**'enter vehicle' : 'Enter Vehicle'**" as n8 <<include use case>> <<usage>> [[https://example.test/src/general-case.sysml#L24]]
rectangle "<size:10>//«subject»//</size>\n**vehicle**" as n9 <<subject>> <<usage>> [[https://example.test/src/general-case.sysml#L25]]
actor "<size:10>//«actor»//</size>\n**driver**" as n10 <<actor>> <<usage>> [[https://example.test/src/general-case.sysml#L26]]
n0 -- n1 : <U+00AB>subject<U+00BB> [[https://example.test/src/general-case.sysml#L14]]
n2 -- n0 : [[https://example.test/src/general-case.sysml#L15]]
n3 -- n0 : [[https://example.test/src/general-case.sysml#L16]]
n0 .. n4 : [[https://example.test/src/general-case.sysml#L17]]
n0 ..> n5 : <U+00AB>include<U+00BB> [[https://example.test/src/general-case.sysml#L20]]
n5 -- n6 : <U+00AB>subject<U+00BB> [[https://example.test/src/general-case.sysml#L21]]
n7 -- n5 : [[https://example.test/src/general-case.sysml#L22]]
n0 ..> n8 : <U+00AB>include<U+00BB> [[https://example.test/src/general-case.sysml#L24]]
n8 -- n9 : <U+00AB>subject<U+00BB> [[https://example.test/src/general-case.sysml#L25]]
n10 -- n8 : [[https://example.test/src/general-case.sysml#L26]]
@enduml
