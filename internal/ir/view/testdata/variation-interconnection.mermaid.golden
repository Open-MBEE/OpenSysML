---
config:
  fontFamily: "Helvetica, Arial, sans-serif"
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; } .cluster-label .nodeLabel { text-align: center; }"
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
---
%% VariationViews::familyLinks — interconnection rendering (render asInterconnectionDiagram)
flowchart LR
  subgraph n0 ["`*«part»* **vehicleFamily**`"]
    direction LR
    n1("`*«part»*
**engine**`")
    subgraph n2 ["`*«variation part»* **transmission**`"]
      direction LR
      n2_anchor[" "]
      n3("`*«variant»*
**manual**`")
      n4("`*«variant»*
**automatic**`")
    end
  end
  n1 === n2_anchor
  classDef anchor fill:none,stroke:none
  class n2_anchor anchor
  linkStyle 0 stroke-width:3px
