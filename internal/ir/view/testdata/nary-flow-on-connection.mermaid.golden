---
config:
  fontFamily: "Helvetica, Arial, sans-serif"
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; } .cluster-label .nodeLabel { text-align: center; }"
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
---
%% NaryViews::carLinks — interconnection rendering (render asInterconnectionDiagram)
flowchart LR
  subgraph n0 ["`*«part def»* **Car**`"]
    direction LR
    subgraph n1 ["`*«part»* **tank**`"]
      direction LR
      n1_anchor[" "]
      n1.0["^fuelOut"]
      note0@{ shape: notch-rect, label: "the line" }
    end
    subgraph n2 ["`*«part»* **engine**`"]
      direction LR
      n2.0["^fuelIn"]
    end
    subgraph n3 ["`*«part»* **gauge**`"]
      direction LR
      n3.0["^fuelIn"]
    end
    n4@{ shape: text, label: "`*«flow»*
—▶`" }
    n5@{ shape: text, label: "`*«flow»*
◀—`" }
    n6@{ shape: text, label: "«message»<br>—#gt;" }
    note1@{ shape: notch-rect, label: "shared<br>shared" }
    note2@{ shape: notch-rect, label: "the reading" }
  end
  n1.0 === n4
  n4 === n5
  n5 === n6
  n6 === n2.0
  n1.0 --> n3.0
  note0 -.- n1_anchor
  note1 -.- n1_anchor
  note2 -.- n5
  note1 -.- n5
  classDef anchor fill:none,stroke:none
  class n1_anchor anchor
  classDef note fill:#FEFFDD,stroke:#181818
  class note0,note1,note2 note
  linkStyle 0 stroke-width:3px
  linkStyle 1 stroke-width:3px
  linkStyle 2 stroke-width:3px
  linkStyle 3 stroke-width:3px
