---
config:
  fontFamily: "Helvetica, Arial, sans-serif"
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; } .cluster-label .nodeLabel { text-align: center; }"
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
  flowchart:
    subGraphTitleMargin:
      bottom: 72
title: "«view» CalcViews::calcFlows : ActionFlowView"
---
%% CalcViews::calcFlows — action rendering (render asInterconnectionDiagram, view def ActionFlowView)
flowchart TD
  n0("`*«calc»*
**add**
parameters
in x
in y
out result
result
x + y`")
  n2["`*«calc def»*
**Add**
parameters
in x
in y
out r`"]
  n3("`*«calc»*
**total**
parameters
in x
in y
out ^r`")
  subgraph n4 ["`*«calc def»* **Stepwise**
parameters
in load
out result`"]
    direction TD
    subgraph n5 ["`*«action»* **measure**`"]
      direction TD
      n5_anchor[" "]
      n5_p0["reading"]
    end
    subgraph n6 ["`*«action»* **scale**
parameters
out scaled`"]
      direction TD
      n6_anchor[" "]
      n6_p0["raw"]
    end
  end
  n5_anchor -.-> n6_anchor
  n5_p0 --> n6_p0
  classDef anchor fill:none,stroke:none
  class n5_anchor,n6_anchor anchor
