// view: NotationGlyphs::Diagrams::definitionGlyphs
// kind: definition
// stated: view def GeneralView, filter @Definition or @Usage
// layout: dot
digraph "NotationGlyphs::Diagrams::definitionGlyphs" {
  graph [fontname="Helvetica"];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  "n0" [label=<<font point-size="10"><i>«part def»</i></font><br/><b>Plant</b>>];
  "n1" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>tank</b>>];
  "n2" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>spare</b>>];
  "n3" [style="rounded,filled", label=<<font point-size="10"><i>«timeslice»</i></font><br/><b>filling</b>>];
  "n4" [style="rounded,filled", label=<<font point-size="10"><i>«snapshot»</i></font><br/><b>full</b>>];
  "n5" [style="rounded,filled", label=<<font point-size="10"><i>«occurrence»</i></font><br/><b>startup</b>>];
  "n6" [label=<<font point-size="10"><i>«requirement def»</i></font><br/><b>LevelReq</b>>];
  "n7" [style="rounded,filled", label=<<font point-size="10"><i>«require constraint»</i></font><br/><b>keepLevel</b>>];
  "n8" [style="rounded,filled", label=<<font point-size="10"><i>«assume constraint»</i></font><br/><b>lowLevel</b>>];
  "n9" [style="rounded,filled", label=<<font point-size="10"><i>«constraint»</i></font><br/><b>bounded</b>>];
  "n10" [style="rounded,filled", label=<<font point-size="10"><i>«constraint»</i></font><br/><b>tight</b>>];
  "n11" [style="rounded,filled", label=<<font point-size="10"><i>«requirement»</i></font><br/><b>capacity</b>>];
  "n12" [style="rounded,filled", label=<<font point-size="10"><i>«assert constraint»</i></font><br/><b>asserted</b>>];
  "n0" -> "n1" [dir=back, arrowtail=diamond];
  "n2" -> "n1" [label="references", arrowhead=onormaldot];
  "n0" -> "n2" [dir=back, arrowtail=odiamond];
  "n0" -> "n3" [dir=back, arrowtail=dot];
  "n0" -> "n4" [dir=back, arrowtail=dot];
  "n0" -> "n5" [label="event", arrowhead=vee];
  "n6" -> "n9" [label="require", arrowhead=vee];
  "n6" -> "n10" [label="assume", arrowhead=vee];
  "n6" -> "n7" [label="require", arrowhead=vee];
  "n6" -> "n8" [label="assume", arrowhead=vee];
  "n11" -> "n12" [label="assert", arrowhead=vee];
}
