# GeneralViews::packageView — package rendering (view def GeneralView, filter @Package)
classes: {
  package: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; stroke-width: 2 } }
  containment: { source-arrowhead: { shape: circle; style: { filled: false } }; style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
  dependency: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1; stroke-dash: 3 } }
}
n0: "VehicleStructure" { class: package }
n1: "Powertrain" { class: package }
n2: "VehicleRequirements" { class: package }
n3: "VehicleVerification" { class: package }
n4: "GeneralViews" { class: package }
n0 <- n1: { class: containment }
n2 -> n0: "private import ::*" { class: dependency }
n3 -> n0: "private import ::*" { class: dependency }
n3 -> n1: "private import ::*" { class: dependency }
n3 -> n2: "private import ::*" { class: dependency }
