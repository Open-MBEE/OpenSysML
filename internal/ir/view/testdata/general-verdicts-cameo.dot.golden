// view: GeneralViews::requirementView
// kind: requirement
// stated: view def GeneralView, filter @RequirementDefinition or @RequirementUsage
// not represented: 4 exposed standard library element(s) not drawn; a requirement rendering draws the model's own elements
// layout: dot
digraph "GeneralViews::requirementView" {
  graph [fontname="Arial", fontcolor="#424242"];
  node [shape=box, style=filled, fillcolor="#FFCC99:#FFFAD4", gradientangle=0, color="#99795C", fontname="Arial", fontsize=11, fontcolor="#424242", penwidth=1];
  edge [color="#424242", fontname="Arial", fontsize=9, fontcolor="#424242", penwidth=1, arrowhead=open];
  subgraph "cluster_frame" {
    label=<<b>req</b> [Requirement] MassRequirement [ requirementView ]>;
    labeljust=l;
    labelloc=t;
    fontsize=11;
    color="#5B5B59";
    penwidth=1;
    margin=8;
    "n0" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td><font point-size="9">«requirement def»</font><br/><b>MassRequirement</b></td></tr><hr/><tr><td align="left">id R1, “The total mass of the vehicle shall not exceed the stated...”</td></tr></table>>];
    "n1" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td><font point-size="9">«requirement def»</font><br/><b>StoppingRequirement</b></td></tr><hr/><tr><td align="left">id R2, “The vehicle shall stop within the stated distance.”</td></tr></table>>];
    "n2" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td><font point-size="9">«requirement def»</font><br/><b>EmergencyStopRequirement</b></td></tr><hr/><tr><td align="left">id R3</td></tr></table>>];
    "n3" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td><font point-size="9">«requirement»</font><br/><b>vehicleMass : MassRequirement</b></td></tr><hr/><tr><td align="left">id R1.1, verdict pass by Cases::light, fail by Cases::heavy</td></tr></table>>, fillcolor="#EEBF99", color="#D55E00"];
    "n4" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td><font point-size="9">«requirement»</font><br/><b>chassisMass : MassRequirement</b></td></tr><hr/><tr><td align="left">id R1.2, verdict pass by Cases::chassis</td></tr></table>>, fillcolor="#99D8C7", color="#009E73"];
    "n5" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td><font point-size="9">«requirement»</font><br/><b>emergencyStop : EmergencyStopRequirement</b></td></tr><hr/><tr><td align="left">id R3.1, verdict inconclusive by Cases::stop (no verdict bound), error by Cases::brake (division by zero)</td></tr></table>>, fillcolor="#EBC9DC", color="#CC79A7"];
    "n6" [label=<<font point-size="9">«part def»</font><br/><b>LightChassis</b>>];
    "n7" [label=<<font point-size="9">«part»</font><br/><b>vehicle : Vehicle</b>>];
    "n8" [label=<<font point-size="9">«part»</font><br/><b>heavyVehicle : Vehicle</b>>];
    "n9" [style="rounded,filled", fillcolor="#E1E1C3:#F7F7EF", color="#424242", label=<<b>brake : Brake</b>>];
    "n10" [label=<<font point-size="9">«verification def»</font><br/><b>MassTest</b>>];
    "n11" [label=<<font point-size="9">«verification»</font><br/><b>lightMassTest : MassTest</b>>];
    "n12" [label=<<font point-size="9">«verification»</font><br/><b>heavyMassTest : MassTest</b>>];
    "n13" [label=<<font point-size="9">«verification def»</font><br/><b>StopTest</b>>];
    "n14" [label=<<font point-size="9">«verification»</font><br/><b>stopTest : StopTest</b>>];
  }
  "n2" -> "n1" [arrowhead=empty];
  "n3" -> "n0" [arrowhead=empty, style=dashed];
  "n4" -> "n0" [arrowhead=empty, style=dashed];
  "n5" -> "n2" [arrowhead=empty, style=dashed];
  "n4" -> "n3" [label="derive", arrowhead=vee, style=dashed];
  "n6" -> "n4" [label="refine", arrowhead=vee, style=dashed];
  "n7" -> "n3" [label="satisfy", arrowhead=vee, style=dashed];
  "n8" -> "n3" [label="satisfy", arrowhead=vee, style=dashed];
  "n7" -> "n5" [label="satisfy", arrowhead=vee, style=dashed];
  "n5" -> "n9" [label="allocate", arrowhead=vee, style=dashed];
  "n10" -> "n3" [label="verify", arrowhead=vee, style=dashed];
  "n11" -> "n3" [label="verify", arrowhead=vee, style=dashed];
  "n12" -> "n3" [label="verify", arrowhead=vee, style=dashed];
  "n13" -> "n5" [label="verify", arrowhead=vee, style=dashed];
  "n14" -> "n5" [label="verify", arrowhead=vee, style=dashed];
}
