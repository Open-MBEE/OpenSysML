CalcViews::calcFlows - action rendering (render asInterconnectionDiagram, view def ActionFlowView)

calc add
  result
    x + y
  in x
  in y
  out result
calc def Add
  in x
  in y
  out r
calc total
  in x
  in y
  out ^r
calc def Stepwise
  in load
  out result
  action measure
    out reading
  action scale
    in raw
    out scaled

flow:
  measure -> scale
  measure.reading => scale.raw
