ToasterViews::toasterView - interconnection rendering (render asInterconnectionDiagram)

part def ToasterDemo::Toaster
  part heating : HeatingSystem
    port durationIn : ~DurationPort
  part control : ControlSystem
    port durationOut : DurationPort
  part chassis : Chassis

connections:
  control.durationOut -- heating.durationIn: durationInterface
  control.durationOut => heating.durationIn: of Real
