# GeneralViews::definitionView — definition rendering (view def GeneralView, filter @Definition or @Usage)
classes: {
  definition: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14 } }
  usage: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; border-radius: 8 } }
  specialization: { target-arrowhead: { shape: triangle; style: { filled: false } }; style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
  typing: { target-arrowhead: { shape: triangle; style: { filled: false } }; style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1; stroke-dash: 3 } }
  composition: { source-arrowhead: { shape: diamond; style: { filled: true } }; style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
  reference: { source-arrowhead: { shape: diamond; style: { filled: false } }; style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
}
n0: "Vehicle" { class: definition }
n1: "Chassis" { class: definition }
n2: "LightChassis" { class: definition }
n3: "Driver" { class: definition }
n4: "Brake" { class: definition }
n5: "vehicle" { class: usage }
n6: "heavyVehicle" { class: usage }
n7: "brake" { class: usage }
n8: "Vehicle::mass" { class: usage }
n9: "chassis" { class: usage }
n10: "driver" { class: usage }
n11: "vehicle::mass" { class: usage }
n12: "heavyVehicle::mass" { class: usage }
n13: "Engine" { class: definition }
n2 -> n1: { class: specialization }
n5 -> n0: { class: typing }
n6 -> n0: { class: typing }
n7 -> n4: { class: typing }
n0 <- n8: { class: reference }
