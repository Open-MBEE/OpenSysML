NotationGlyphs::Diagrams::treeGlyphs - tree rendering (the view states no rendering; a tree is the default)

part def Plant
  part tank
    attribute level
  part pump
  timeslice filling
  snapshot full
  occurrence startup
  part spare
    attribute level
view tankView
part def Tank
  attribute level

relationships:
  Plant *-- tank
  Plant *-- pump
  Plant @-- filling
  Plant @-- full
  Plant -> startup: event
  Plant o-- spare
  tank --:|> Tank
  tank o-- level
  spare --|> tank: references
  spare o-- level
  tankView ..> Tank: «expose»
  Tank o-- level
