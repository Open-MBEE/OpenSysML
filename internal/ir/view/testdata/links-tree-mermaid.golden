---
config:
  fontFamily: "Helvetica, Arial, sans-serif"
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; } .cluster-label .nodeLabel { text-align: center; }"
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
---
%% VehicleViews::vehicleView — tree rendering
flowchart TD
  n0["`*«part def»*
**Vehicle**`"]
    n1("`*«part»*
**engine**`")
      n2("`*«attribute»*
**power**`")
      n3("`*«part»*
**cylinder**`")
    n4("`*«part»*
**wheels**`")
    n5("`**connect**`")
  n0 --- n5
  n6("`*«view»*
**engineSubview**`")
    n7["`*«part def»*
**Engine**`"]
      n8("`*«attribute»*
**power**`")
      n9("`*«part»*
**cylinder**`")
  n6 --- n7
  n0 ---|"◆"| n1
  n0 ---|"◆"| n4
  n1 -->|"typing"| n7
  n1 ---|"◇"| n2
  n1 ---|"◆"| n3
  n7 ---|"◇"| n8
  n7 ---|"◆"| n9
  click n0 href "https://example.test/src/tree.sysml#L11"
  click n1 href "https://example.test/src/tree.sysml#L12"
  click n2 href "https://example.test/src/tree.sysml#L5"
  click n3 href "https://example.test/src/tree.sysml#L6"
  click n4 href "https://example.test/src/tree.sysml#L13"
  click n5 href "https://example.test/src/tree.sysml#L14"
  click n6 href "https://example.test/src/tree.sysml#L29"
  click n7 href "https://example.test/src/tree.sysml#L4"
  click n8 href "https://example.test/src/tree.sysml#L5"
  click n9 href "https://example.test/src/tree.sysml#L6"
