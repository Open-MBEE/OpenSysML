# SequenceViews::pubSubView — sequence rendering (view def SequenceView)
classes: {
  usage: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; border-radius: 8 } }
  edge: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
}
sequence: "" {
  shape: sequence_diagram
  n0: "«part»\nproducer" { class: usage }
  n1: "«part»\nserver" { class: usage }
  n2: "«part»\nconsumer" { class: usage }
  n2 -> n1: "subscribe_message" { class: edge }
  n0 -> n1: "publish_message" { class: edge }
  n1 -> n2: "deliver_message" { class: edge }
}
