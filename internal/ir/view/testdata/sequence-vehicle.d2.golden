# VehicleSequenceViews::startVehicleView — sequence rendering (view def SequenceView)
# not represented: the flows in perform action startVehicle are its action flow, not interaction messages; they are not shown
classes: {
  usage: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; border-radius: 8 } }
  succession: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1; stroke-dash: 3 } }
  open: { target-arrowhead: { shape: arrow }; style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
}
sequence: "" {
  shape: sequence_diagram
  n0: "«part»\ndriver" {
    class: usage
    n2: "«perform»\nturnVehicleOn" { class: usage }
    n5: "«perform»\ntrigger2" { class: usage }
    n7: "«event occurrence»\ndriverReady" { class: usage }
  }
  n1: "«part»\nvehicle" {
    class: usage
    n3: "«perform»\ntrigger1" { class: usage }
    n4: "«perform»\nsendStatus" { class: usage }
    n6: "«event occurrence»\ndoorClosed" { class: usage }
  }
  n0.n2 -> n1.n3: "of ignitionCmd : IgnitionCmd" { class: open }
  n1.n4 -> n0.n5: "of es : EngineStatus" { class: open }
  n1.n6 -> n0.n7: { class: succession }
}
