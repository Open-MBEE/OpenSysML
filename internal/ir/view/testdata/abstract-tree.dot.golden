// view: AbstractViews::familyTree
// kind: tree
// stated: render asTreeDiagram
// layout: dot
digraph "AbstractViews::familyTree" {
  graph [fontname="Helvetica"];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  "n0" [label=<<font point-size="10"><i>«abstract part def»</i></font><br/><b>Vehicle</b>>];
  "n1" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>mass</b>>];
  "n0" -> "n1" [arrowhead=none];
  "n2" [style="rounded,filled", label=<<font point-size="10"><i>«abstract part»</i></font><br/><b>vehicleFamily</b>>];
  "n3" [style="rounded,filled", label=<<font point-size="10"><i>«abstract port»</i></font><br/><b>fuel</b>>];
  "n2" -> "n3" [arrowhead=none];
  "n4" [style="rounded,filled", label=<<font point-size="10"><i>«abstract part»</i></font><br/><b>engine</b>>];
  "n2" -> "n4" [arrowhead=none];
  "n5" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>chassis</b>>];
  "n2" -> "n5" [arrowhead=none];
  "n6" [style="rounded,filled", label=<<b>connect</b>>];
  "n2" -> "n6" [arrowhead=none];
  "n7" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>mass</b>>];
  "n2" -> "n7" [arrowhead=none];
  "n8" [label=<<font point-size="10"><i>«variation part def»</i></font><br/><b>Models</b>>];
  "n9" [style="rounded,filled", label=<<font point-size="10"><i>«variant»</i></font><br/><b>sedan</b>>];
  "n10" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>mass</b>>];
  "n9" -> "n10" [arrowhead=none];
  "n11" [style="rounded,filled", label=<<font point-size="10"><i>«abstract port»</i></font><br/><b>fuel</b>>];
  "n9" -> "n11" [arrowhead=none];
  "n12" [style="rounded,filled", label=<<font point-size="10"><i>«abstract part»</i></font><br/><b>engine</b>>];
  "n9" -> "n12" [arrowhead=none];
  "n13" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>chassis</b>>];
  "n9" -> "n13" [arrowhead=none];
  "n14" [style="rounded,filled", label=<<b>connect</b>>];
  "n9" -> "n14" [arrowhead=none];
  "n8" -> "n9" [arrowhead=none];
  "n15" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>mass</b>>];
  "n8" -> "n15" [arrowhead=none];
  "n2" -> "n0" [arrowhead=onormaldotdot];
  "n8" -> "n0" [arrowhead=empty];
}
