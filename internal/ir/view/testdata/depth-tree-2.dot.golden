  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  "n0" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>vehicle</b>>];
  "n1" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>mass</b>>];
  "n0" -> "n1" [arrowhead=none];
  "n2" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>wheel</b>>];
  "n3" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>pressure</b>>];
  "n2" -> "n3" [arrowhead=none];
  "n4" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>hub</b><br/>nested deeper than 2 levels; not shown>];
  "n2" -> "n4" [arrowhead=none];
  "n0" -> "n2" [arrowhead=none];
  "n5" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>engine</b>>];
  "n6" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>piston</b><br/>nested deeper than 2 levels; not shown>];
  "n5" -> "n6" [arrowhead=none];
  "n7" [style="rounded,filled", label=<<font point-size="10"><i>«port»</i></font><br/><b>fuelIn</b>>];
  "n5" -> "n7" [arrowhead=none];
  "n0" -> "n5" [arrowhead=none];
}
