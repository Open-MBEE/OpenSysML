  "n5" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>total</b>>];
  "n6" [label=<<font point-size="10"><i>«part def»</i></font><br/><b>Cabin</b>>];
  "n0" -> "n6" [arrowhead=none];
  "n7" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>cabin</b>>];
