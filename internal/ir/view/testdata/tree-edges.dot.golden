// view: FleetViews::structure
// kind: tree
// layout: dot
digraph "FleetViews::structure" {
  graph [fontname="Helvetica"];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  "n0" [label=<<b>Vehicle</b>>];
  "n1" [style="rounded,filled", label=<<b>chassis</b>>];
  "n0" -> "n1" [arrowhead=none];
  "n2" [style="rounded,filled", label=<<b>wheels</b>>];
  "n0" -> "n2" [arrowhead=none];
  "n3" [style="rounded,filled", label=<<b>driver</b>>];
  "n0" -> "n3" [arrowhead=none];
  "n4" [style="rounded,filled", label=<<b>total</b>>];
  "n0" -> "n4" [arrowhead=none];
  "n5" [label=<<b>Cabin</b>>];
  "n0" -> "n5" [arrowhead=none];
  "n6" [style="rounded,filled", label=<<b>cabin</b>>];
  "n0" -> "n6" [arrowhead=none];
  "n7" [style="rounded,filled", label=<<b>radio</b>>];
  "n0" -> "n7" [arrowhead=none];
  "n8" [style="rounded,filled", label=<<b>trailer</b>>];
  "n0" -> "n8" [arrowhead=none];
  "n9" [label=<<b>SportsCar</b>>];
  "n10" [style="rounded,filled", label=<<b>chassis</b>>];
  "n9" -> "n10" [arrowhead=none];
  "n11" [style="rounded,filled", label=<<b>spare</b>>];
  "n9" -> "n11" [arrowhead=none];
  "n12" [label=<<b>Chassis</b>>];
  "n13" [style="rounded,filled", label=<<b>mass</b>>];
  "n12" -> "n13" [arrowhead=none];
  "n14" [label=<<b>LightChassis</b>>];
  "n15" [style="rounded,filled", label=<<b>mass</b>>];
  "n14" -> "n15" [arrowhead=none];
  "n16" [label=<<b>Wheel</b>>];
  "n17" [label=<<b>Driver</b>>];
  "n18" [label=<<b>Mass</b>>];
  "n19" [style="rounded,filled", label=<<b>fleetCar</b>>];
  "n0" -> "n12" [label="chassis", dir=back, arrowtail=diamond];
  "n0" -> "n16" [label="wheels", dir=back, arrowtail=diamond];
  "n0" -> "n17" [label="driver", dir=back, arrowtail=odiamond];
  "n0" -> "n18" [label="total", dir=back, arrowtail=odiamond];
  "n9" -> "n0" [arrowhead=empty];
  "n9" -> "n14" [label="chassis", dir=back, arrowtail=diamond];
  "n9" -> "n16" [label="spare", dir=back, arrowtail=diamond];
  "n10" -> "n1" [label="redefines", arrowhead=empty];
  "n11" -> "n2" [label="subsets", arrowhead=empty];
  "n12" -> "n18" [label="mass", dir=back, arrowtail=odiamond];
  "n14" -> "n12" [arrowhead=empty];
  "n15" -> "n13" [label="redefines", arrowhead=empty];
  "n19" -> "n0" [arrowhead=empty, style=dashed];
}
