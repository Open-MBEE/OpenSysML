// view: CaseExamples::caseDiagram
// kind: case
// stated: render asCaseDiagram
// not represented: part def CaseExamples::Tool holds no case; a case rendering does not show it
// layout: dot
digraph "CaseExamples::caseDiagram" {
  graph [fontname="Helvetica", rankdir=LR];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  "n0" [shape=ellipse, label=<<font point-size="10"><i>«use case»</i></font><br/><b>&#39;Provide Transportation&#39;</b>>];
  "n1" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle</b>>];
  "n2" [shape=box, label=<<font point-size="10"><i>«actor»</i></font><br/><b>driver</b>>];
  "n3" [shape=note, label=<<b>objective</b><br/>Transport the vehicle and its passengers safely.>];
  "n4" [shape=ellipse, label=<<font point-size="10"><i>«use case»</i></font><br/><b>addFuel</b>>];
  "n5" [shape=box, label=<<font point-size="10"><i>«actor»</i></font><br/><b>^fueler</b>>];
  "n6" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>^vehicle</b>>];
  "n7" [shape=ellipse, label=<<font point-size="10"><i>«include use case»</i></font><br/><b>&#39;enter vehicle&#39;</b>>];
  "n8" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle</b>>];
  "n9" [shape=box, label=<<font point-size="10"><i>«actor»</i></font><br/><b>driver</b>>];
  "n10" [shape=ellipse, label=<<font point-size="10"><i>«use case»</i></font><br/><b>&#39;Drive Vehicle&#39;</b>>];
  "n11" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle</b>>];
  "n12" [shape=box, label=<<font point-size="10"><i>«actor»</i></font><br/><b>driver</b>>];
  "n13" [shape=ellipse, label=<<font point-size="10"><i>«analysis def»</i></font><br/><b>FuelAnalysis</b>>];
  "n14" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle</b>>];
  "n15" [shape=note, label=<<b>objective</b><br/>Estimate the fuel remaining after a journey.>];
  "n16" [shape=ellipse, label=<<font point-size="10"><i>«verification def»</i></font><br/><b>FuelVerification</b>>];
  "n17" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle</b>>];
  "n18" [shape=note, label=<<b>objective</b>>];
  "n0" -> "n1" [label="«subject»", dir=none];
  "n2" -> "n0" [dir=none];
  "n0" -> "n3" [dir=none, style=dashed];
  "n5" -> "n4" [dir=none];
  "n4" -> "n6" [label="«subject»", dir=none];
  "n0" -> "n4" [label="«include»", arrowhead=vee];
  "n0" -> "n7" [label="«include»", arrowhead=vee];
  "n7" -> "n8" [label="«subject»", dir=none];
  "n9" -> "n7" [dir=none];
  "n0" -> "n10" [arrowtail=diamond, dir=back];
  "n10" -> "n11" [label="«subject»", dir=none];
  "n12" -> "n10" [dir=none];
  "n13" -> "n14" [label="«subject»", dir=none];
  "n13" -> "n15" [dir=none, style=dashed];
  "n16" -> "n17" [label="«subject»", dir=none];
  "n16" -> "n18" [dir=none, style=dashed];
}
