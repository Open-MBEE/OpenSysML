// view: CaseExamples::caseDiagram
// kind: case
// stated: render asCaseDiagram
// not represented: part def CaseExamples::Tool holds no case; a case rendering does not show it
// layout: dot
digraph "CaseExamples::caseDiagram" {
  graph [fontname="Helvetica", rankdir=LR];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  "n0" [shape=ellipse, label=<<font point-size="10"><i>«use case»</i></font><br/><b>CaseExamples::&#39;Provide Transportation&#39; : &#39;Enter Vehicle&#39;</b>>];
  "n1" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle : Vehicle</b>>];
  "n2" [shape=box, label=<<font point-size="10"><i>«actor»</i></font><br/><b>driver : Person</b>>];
  "n3" [shape=note, label=<<b>objective</b><br/>Transport the vehicle and its passengers safely.>];
  "n4" [shape=ellipse, label=<<font point-size="10"><i>«use case def»</i></font><br/><b>CaseExamples::&#39;Add Fuel&#39;</b>>];
  "n5" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle : Vehicle</b>>];
  "n6" [shape=box, label=<<font point-size="10"><i>«actor»</i></font><br/><b>fueler : Person</b>>];
  "n7" [shape=note, label=<<font point-size="10"><i>«objective»</i></font><br/><b>obj</b>>];
  "n8" [shape=ellipse, label=<<font point-size="10"><i>«include use case»</i></font><br/><b>&#39;enter vehicle&#39; : &#39;Enter Vehicle&#39;</b>>];
  "n9" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle</b>>];
  "n10" [shape=box, label=<<font point-size="10"><i>«actor»</i></font><br/><b>driver</b>>];
  "n11" [shape=note, label=<<font point-size="10"><i>«objective»</i></font><br/><b>obj</b>>];
  "n12" [shape=ellipse, label=<<font point-size="10"><i>«use case»</i></font><br/><b>&#39;Drive Vehicle&#39;</b>>];
  "n13" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle</b>>];
  "n14" [shape=box, label=<<font point-size="10"><i>«actor»</i></font><br/><b>driver</b>>];
  "n15" [shape=note, label=<<font point-size="10"><i>«objective»</i></font><br/><b>obj</b>>];
  "n16" [shape=ellipse, label=<<font point-size="10"><i>«analysis def»</i></font><br/><b>CaseExamples::FuelAnalysis</b>>];
  "n17" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle : Vehicle</b>>];
  "n18" [shape=note, label=<<b>objective</b><br/>Estimate the fuel remaining after a journey.>];
  "n19" [shape=ellipse, label=<<font point-size="10"><i>«verification def»</i></font><br/><b>CaseExamples::FuelVerification</b>>];
  "n20" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle : Vehicle</b>>];
  "n21" [shape=note, label=<<b>objective</b>>];
  "n0" -> "n1" [label="«subject»", dir=none];
  "n2" -> "n0" [dir=none];
  "n0" -> "n3" [dir=none, style=dashed];
  "n4" -> "n5" [label="«subject»", dir=none];
  "n6" -> "n4" [dir=none];
  "n4" -> "n7" [dir=none, style=dashed];
  "n0" -> "n4" [label="«include»", style=dashed];
  "n0" -> "n8" [label="«include»", style=dashed];
  "n8" -> "n9" [label="«subject»", dir=none];
  "n10" -> "n8" [dir=none];
  "n8" -> "n11" [dir=none, style=dashed];
  "n0" -> "n12" [arrowtail=diamond, dir=back];
  "n12" -> "n13" [label="«subject»", dir=none];
  "n14" -> "n12" [dir=none];
  "n12" -> "n15" [dir=none, style=dashed];
  "n16" -> "n17" [label="«subject»", dir=none];
  "n16" -> "n18" [dir=none, style=dashed];
  "n19" -> "n20" [label="«subject»", dir=none];
  "n19" -> "n21" [dir=none, style=dashed];
}
