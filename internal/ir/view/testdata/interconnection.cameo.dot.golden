// view: PlantViews::loopView
// kind: interconnection
// stated: render asInterconnectionDiagram
// layout: dot
digraph "PlantViews::loopView" {
  graph [fontname="Arial", fontcolor="#424242", compound=true];
  node [shape=box, style=filled, fillcolor="#FFCC99:#FFFAD4", gradientangle=0, color="#99795C", fontname="Arial", fontsize=11, fontcolor="#424242", penwidth=1];
  edge [color="#424242", fontname="Arial", fontsize=9, fontcolor="#424242", penwidth=1, arrowhead=open];
  subgraph "cluster_frame" {
    label=<<b>ibd</b> [Block] Loop [ loopView ]>;
    labeljust=l;
    labelloc=t;
    fontsize=11;
    color="#5B5B59";
    penwidth=1;
    margin=8;
    subgraph "cluster_n0" {
      label="";
      style=filled;
      fillcolor="#FFCC99:#FFFAD4";
      gradientangle=0;
      color="#99795C";
      penwidth=1;
      "n0" [shape=point, style=invis, width=0, height=0, label=""];
      subgraph "cluster_n1" {
        label=<<font point-size="9">«part»</font><br/><b>pump</b>>;
        style=filled;
        fillcolor="#FFCC99:#FFFAD4";
        gradientangle=0;
        color="#99795C";
        penwidth=1;
        "n1" [shape=point, style=invis, width=0, height=0, label=""];
        "n1.0" [shape=box, label="", xlabel="outlet", fontsize=8, width=0.16666666666666666, height=0.16666666666666666, fixedsize=true, fillcolor="#FFFFFF", color="#424242"];
        "n2" [label=<<font point-size="9">«item»</font><br/><b>waterOut</b>>];
      }
      subgraph "cluster_n3" {
        label=<<font point-size="9">«part»</font><br/><b>tank</b>>;
        style=filled;
        fillcolor="#FFCC99:#FFFAD4";
        gradientangle=0;
        color="#99795C";
        penwidth=1;
        "n3" [shape=point, style=invis, width=0, height=0, label=""];
        "n3.0" [shape=box, label="", xlabel="inlet", fontsize=8, width=0.16666666666666666, height=0.16666666666666666, fixedsize=true, fillcolor="#FFFFFF", color="#424242"];
        "n4" [label=<<font point-size="9">«item»</font><br/><b>waterIn</b>>];
      }
      subgraph "cluster_n5" {
        label=<<font point-size="9">«part»</font><br/><b>sensor</b>>;
        style=filled;
        fillcolor="#FFCC99:#FFFAD4";
        gradientangle=0;
        color="#99795C";
        penwidth=1;
        "n5" [shape=point, style=invis, width=0, height=0, label=""];
        "n6" [label=<<font point-size="9">«item»</font><br/><b>waterOut</b>>];
      }
    }
  }
  "n1.0" -> "n3.0" [arrowhead=none];
  "n2" -> "n4";
}
