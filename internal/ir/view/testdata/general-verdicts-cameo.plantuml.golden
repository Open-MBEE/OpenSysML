@startuml
' GeneralViews::requirementView — requirement rendering (view def GeneralView, filter @RequirementDefinition or @RequirementUsage)
' not represented: 4 exposed standard library element(s) not drawn; a requirement rendering draws the model's own elements
' not represented: style cameo; only the DOT and Mermaid forms draw a diagram in a style
<style>
root {
  BackGroundColor white
  FontName SansSerif
  FontSize 14
  FontColor black
  LineColor #181818
  HorizontalAlignment left
}
element {
  BackGroundColor white
  LineColor #181818
  LineThickness 0.5
  RoundCorner 0
  Shadowing 0.0
}
start, end, activityBar {
  BackGroundColor black
}
arrow {
  LineColor #181818
  LineThickness 1
  FontSize 13
}
note {
  BackGroundColor #FEFFDD
  FontSize 13
}
.usage {
  RoundCorner 20
}
.package {
  LineThickness 1.5
}
.region {
  LineStyle 4
}
</style>
skinparam wrapWidth 300
hide stereotype
hide circle
hide empty members
class "<size:10>//«requirement def»//</size>\n**VehicleRequirements::MassRequirement**\nid R1, “The total mass of the vehicle shall not exceed the stated...”" as n0 <<requirement def>>
class "<size:10>//«requirement def»//</size>\n**VehicleRequirements::StoppingRequirement**\nid R2, “The vehicle shall stop within the stated distance.”" as n1 <<requirement def>>
class "<size:10>//«requirement def»//</size>\n**VehicleRequirements::EmergencyStopRequirement**\nid R3" as n2 <<requirement def>>
class "<size:10>//«requirement»//</size>\n**VehicleRequirements::vehicleMass : MassRequirement**\nid R1.1, verdict pass by Cases::light, fail by Cases::heavy" as n3 <<requirement>> <<usage>> #EEBF99;line:D55E00
class "<size:10>//«requirement»//</size>\n**VehicleRequirements::chassisMass : MassRequirement**\nid R1.2, verdict pass by Cases::chassis" as n4 <<requirement>> <<usage>> #99D8C7;line:009E73
class "<size:10>//«requirement»//</size>\n**VehicleRequirements::emergencyStop : EmergencyStopRequirement**\nid R3.1, verdict inconclusive by Cases::stop (no verdict bound), error by Cases::brake (division by zero)" as n5 <<requirement>> <<usage>> #EBC9DC;line:CC79A7
class "<size:10>//«part def»//</size>\n**VehicleStructure::LightChassis**" as n6 <<part def>>
class "<size:10>//«part»//</size>\n**VehicleStructure::vehicle : Vehicle**" as n7 <<part>> <<usage>>
class "<size:10>//«part»//</size>\n**VehicleStructure::heavyVehicle : Vehicle**" as n8 <<part>> <<usage>>
class "<size:10>//«action»//</size>\n**VehicleStructure::brake : Brake**" as n9 <<action>> <<usage>>
class "<size:10>//«verification def»//</size>\n**VehicleVerification::MassTest**" as n10 <<verification def>>
class "<size:10>//«verification def»//</size>\n**VehicleVerification::StopTest**" as n11 <<verification def>>
n2 --|> n1
n3 ..|> n0
n4 ..|> n0
n5 ..|> n2
n4 ..> n3 : derive
n6 ..> n4 : refine
n7 ..> n3 : satisfy
n8 ..> n3 : satisfy
n7 ..> n5 : satisfy
n5 ..> n9 : allocate
n10 ..> n3 : verify
n11 ..> n5 : verify
@enduml
