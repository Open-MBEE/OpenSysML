---
config:
  fontFamily: "Helvetica, Arial, sans-serif"
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; } .cluster-label .nodeLabel { text-align: center; }"
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
---
%% FleetViews::structure — tree rendering
flowchart TD
  n0["`**Vehicle**`"]
    n1("`**chassis**`")
  n0 --- n1
    n2("`**wheels**`")
  n0 --- n2
    n3("`**driver**`")
  n0 --- n3
    n4("`**total**`")
  n0 --- n4
    n5["`**Cabin**`"]
  n0 --- n5
    n6("`**cabin**`")
  n0 --- n6
    n7("`**radio**`")
  n0 --- n7
    n8("`**trailer**`")
  n0 --- n8
  n9["`**SportsCar**`"]
    n10("`**chassis**`")
  n9 --- n10
    n11("`**spare**`")
  n9 --- n11
  n12["`**Chassis**`"]
    n13("`**mass**`")
  n12 --- n13
  n14["`**LightChassis**`"]
    n15("`**mass**`")
  n14 --- n15
  n16["`**Wheel**`"]
  n17["`**Driver**`"]
  n18["`**Mass**`"]
  n19("`**fleetCar**`")
  n0 ---|"◆ chassis"| n12
  n0 ---|"◆ wheels"| n16
  n0 ---|"◇ driver"| n17
  n0 ---|"◇ total"| n18
  n9 -->|"specialization"| n0
  n9 ---|"◆ chassis"| n14
  n9 ---|"◆ spare"| n16
  n10 -->|"redefines"| n1
  n11 -->|"subsets"| n2
  n12 ---|"◇ mass"| n18
  n14 -->|"specialization"| n12
  n15 -->|"redefines"| n13
  n19 -.->|"typing"| n0
