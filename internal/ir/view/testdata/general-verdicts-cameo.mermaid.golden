---
config:
  fontFamily: "Arial, Helvetica, sans-serif"
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; } .cluster-label .nodeLabel { text-align: center; }"
  themeVariables:
    fontFamily: "Arial, Helvetica, sans-serif"
    fontSize: "11px"
    primaryColor: "#FFCC99"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#99795C"
    primaryTextColor: "#424242"
    lineColor: "#424242"
    textColor: "#424242"
    noteBkgColor: "#FFFFFF"
    noteBorderColor: "#5B5B59"
    noteTextColor: "#424242"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#5B5B59"
    edgeLabelBackground: "#FFFFFF"
---
%% GeneralViews::requirementView — requirement rendering (view def GeneralView, filter @RequirementDefinition or @RequirementUsage)
%% style cameo
%% not represented: 4 exposed standard library element(s) not drawn; a requirement rendering draws the model's own elements
%% not represented: Cameo gradients are drawn flat
%% not represented: Mermaid has no diagram frame with header tab
flowchart TD
  n0["`*«requirement def»*
**VehicleRequirements::MassRequirement**
id R1, “The total mass of the vehicle shall not exceed the stated...”`"]
  n1["`*«requirement def»*
**VehicleRequirements::StoppingRequirement**
id R2, “The vehicle shall stop within the stated distance.”`"]
  n2["`*«requirement def»*
**VehicleRequirements::EmergencyStopRequirement**
id R3`"]
  n3["`*«requirement»*
**VehicleRequirements::vehicleMass : MassRequirement**
id R1.1, verdict pass by Cases::light, fail by Cases::heavy`"]
  n4["`*«requirement»*
**VehicleRequirements::chassisMass : MassRequirement**
id R1.2, verdict pass by Cases::chassis`"]
  n5["`*«requirement»*
**VehicleRequirements::emergencyStop : EmergencyStopRequirement**
id R3.1, verdict inconclusive by Cases::stop (no verdict bound), error by Cases::brake (division by zero)`"]
  n6["`*«part def»*
**VehicleStructure::LightChassis**`"]
  n7["`*«part»*
**VehicleStructure::vehicle : Vehicle**`"]
  n8["`*«part»*
**VehicleStructure::heavyVehicle : Vehicle**`"]
  n9("`**VehicleStructure::brake : Brake**`")
  n10["`*«verification def»*
**VehicleVerification::MassTest**`"]
  n11["`*«verification def»*
**VehicleVerification::StopTest**`"]
  n2 -->|"specialization"| n1
  n3 -.->|"typing"| n0
  n4 -.->|"typing"| n0
  n5 -.->|"typing"| n2
  n4 -.->|"derive"| n3
  n6 -.->|"refine"| n4
  n7 -.->|"satisfy"| n3
  n8 -.->|"satisfy"| n3
  n7 -.->|"satisfy"| n5
  n5 -.->|"allocate"| n9
  n10 -.->|"verify"| n3
  n11 -.->|"verify"| n5
  classDef palette0 fill:#FFCC99,stroke:#99795C
  classDef palette1 fill:#E1E1C3,stroke:#424242
  class n0,n1,n2,n3,n4,n5,n6,n7,n8,n10,n11 palette0
  class n9 palette1
  style n3 fill:#EEBF99,stroke:#D55E00
  style n4 fill:#99D8C7,stroke:#009E73
  style n5 fill:#EBC9DC,stroke:#CC79A7
