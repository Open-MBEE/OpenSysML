# NotationGlyphs::Diagrams::lineGlyphs — interconnection rendering (render asInterconnectionDiagram)
classes: {
  usage: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; border-radius: 8 } }
  successionflow: { target-arrowhead: { shape: triangle; style: { filled: true } }; style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1; stroke-dash: 3 } }
}
n0: "«part»\nline" {
  class: usage
  n1: "«part»\na" {
    class: usage
    n2: "«attribute»\nlevel" { class: usage }
  }
  n3: "«part»\nb" {
    class: usage
    n4: "«attribute»\nlevel" { class: usage }
  }
}
n0.n1.n2 -> n0.n3.n4: "«succession flow»" { class: successionflow }
