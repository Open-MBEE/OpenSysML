// view: InheritedPrefixViews::rigTree
// kind: tree
// stated: render asTreeDiagram
// layout: dot
digraph "InheritedPrefixViews::rigTree" {
  graph [fontname="Helvetica"];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  "n0" [label=<<font point-size="10"><i>«part def»</i></font><br/><b>Rig</b>>];
  "n1" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>a</b>>];
  "n2" [style="rounded,filled", label=<<font point-size="10"><i>«port»</i></font><br/><b>^aPort</b>>];
  "n3" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>^mass</b>>];
  "n4" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>^engine</b>>];
  "n5" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>b</b>>];
  "n6" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>^mass</b>>];
  "n7" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>^cooler</b>>];
  "n8" [style="rounded,filled", label=<<font point-size="10"><i>«port»</i></font><br/><b>^aPort</b>>];
  "n9" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>^engine</b>>];
  "n10" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>c</b>>];
  "n11" [style="rounded,filled", label=<<font point-size="10"><i>«port»</i></font><br/><b>^aPort</b>>];
  "n12" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>^mass</b>>];
  "n13" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>^engine</b>>];
  "n14" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>d</b>>];
  "n15" [style="rounded,filled", label=<<font point-size="10"><i>«port»</i></font><br/><b>^aPort</b>>];
  "n16" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>mass</b>>];
  "n17" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>^engine</b>>];
  "n18" [style="rounded,filled", label=<<b>connect</b>>];
  "n0" -> "n18" [arrowhead=none];
  "n0" -> "n1" [dir=back, arrowtail=diamond];
  "n0" -> "n5" [dir=back, arrowtail=diamond];
  "n0" -> "n10" [dir=back, arrowtail=diamond];
  "n0" -> "n14" [dir=back, arrowtail=diamond];
  "n1" -> "n2" [dir=back, arrowtail=odiamond];
  "n1" -> "n3" [dir=back, arrowtail=odiamond];
  "n1" -> "n4" [dir=back, arrowtail=diamond];
  "n5" -> "n6" [dir=back, arrowtail=odiamond];
  "n5" -> "n7" [dir=back, arrowtail=diamond];
  "n5" -> "n8" [dir=back, arrowtail=odiamond];
  "n5" -> "n9" [dir=back, arrowtail=diamond];
  "n10" -> "n1" [arrowhead=empty];
  "n10" -> "n11" [dir=back, arrowtail=odiamond];
  "n10" -> "n12" [dir=back, arrowtail=odiamond];
  "n10" -> "n13" [dir=back, arrowtail=diamond];
  "n14" -> "n15" [dir=back, arrowtail=odiamond];
  "n14" -> "n16" [dir=back, arrowtail=odiamond];
  "n14" -> "n17" [dir=back, arrowtail=diamond];
}
