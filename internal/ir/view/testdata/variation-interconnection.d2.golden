# VariationViews::familyLinks — interconnection rendering (render asInterconnectionDiagram)
classes: {
  usage: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; border-radius: 8 } }
  connection: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 3 } }
}
n0: "«part»\nvehicleFamily" {
  class: usage
  n1: "«part»\nengine" { class: usage }
  n2: "«variation part»\ntransmission" {
    class: usage
    n3: "«variant»\nmanual" { class: usage }
    n4: "«variant»\nautomatic" { class: usage }
  }
}
n0.n1 -- n0.n2: { class: connection }
