# GeneralViews::requirementView — requirement rendering (view def GeneralView, filter @RequirementDefinition or @RequirementUsage)
# not represented: 4 exposed standard library element(s) not drawn; a requirement rendering draws the model's own elements
# not represented: style cameo; only the DOT and Mermaid forms draw a diagram in a style
classes: {
  definition: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14 } }
  usage: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; border-radius: 8 } }
  edge: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
  specialization: { target-arrowhead: { shape: triangle; style: { filled: false } }; style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
  dependency: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1; stroke-dash: 3 } }
}
n0: "«requirement def»\nMassRequirement\nid R1, “The total mass of the vehicle shall not exceed the stated...”" { class: definition }
n1: "«requirement def»\nStoppingRequirement\nid R2, “The vehicle shall stop within the stated distance.”" { class: definition }
n2: "«requirement def»\nEmergencyStopRequirement\nid R3" { class: definition }
n3: "«requirement»\nvehicleMass\nid R1.1, verdict pass by Cases::light, fail by Cases::heavy" { class: usage; style: { fill: "#EEBF99"; stroke: "#D55E00" } }
n4: "«requirement»\nchassisMass\nid R1.2, verdict pass by Cases::chassis" { class: usage; style: { fill: "#99D8C7"; stroke: "#009E73" } }
n5: "«requirement»\nemergencyStop\nid R3.1, verdict inconclusive by Cases::stop (no verdict bound), error by Cases::brake (division by zero)" { class: usage; style: { fill: "#EBC9DC"; stroke: "#CC79A7" } }
n6: "«part def»\nLightChassis" { class: definition }
n7: "«part»\nvehicle" { class: usage }
n8: "«part»\nheavyVehicle" { class: usage }
n9: "«action»\nbrake" { class: usage }
n10: "«verification def»\nMassTest" { class: definition }
n11: "«verification»\nlightMassTest" { class: usage }
n12: "«verification»\nheavyMassTest" { class: usage }
n13: "«verification def»\nStopTest" { class: definition }
n14: "«verification»\nstopTest" { class: usage }
