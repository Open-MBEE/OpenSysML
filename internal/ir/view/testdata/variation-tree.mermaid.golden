---
config:
  fontFamily: "Helvetica, Arial, sans-serif"
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; } .cluster-label .nodeLabel { text-align: center; }"
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
---
%% VariationViews::familyTree — tree rendering (render asTreeDiagram)
flowchart TD
  n0("`*«part»*
**vehicleFamily**`")
    n1("`*«part»*
**engine**`")
  n0 --- n1
    n2("`*«variation part»*
**transmission**`")
      n3("`*«variant»*
**manual**`")
  n2 --- n3
      n4("`*«variant»*
**automatic**`")
  n2 --- n4
  n0 --- n2
    n5("`**connect**`")
  n0 --- n5
  n6["`*«variation part def»*
**EngineChoices**`"]
    n7("`*«variant»*
**fourCylinder**`")
  n6 --- n7
    n8("`*«variant»*
**sixCylinder**`")
  n6 --- n8
  n0 ---|"◆ engine"| n6
