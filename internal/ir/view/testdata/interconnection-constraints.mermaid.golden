---
config:
  fontFamily: "Helvetica, Arial, sans-serif"
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; } .cluster-label .nodeLabel { text-align: center; }"
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
---
%% ParametricViews::amplifierView — interconnection rendering (render asInterconnectionDiagram)
flowchart LR
  subgraph n0 ["`*«part def»* **Amplifier**`"]
    direction LR
    n1("`*«attribute»*
**signal**`")
    n2("`*«attribute»*
**gain**`")
    n3("`*«attribute»*
**noise**`")
    n4("`*«attribute»*
**output**`")
    subgraph n5 ["`*«constraint»* **amplify**`"]
      direction LR
      n5.0["input"]
      n5.1["gain"]
      n5.2["output"]
    end
    subgraph n6 ["`*«constraint»* **mix**`"]
      direction LR
      n6.0["a"]
      n6.1["b"]
      n6.2["total"]
    end
  end
  n1 === n5.0
  n2 === n5.1
  n5.2 === n6.0
  n3 === n6.1
  n6.2 === n4
