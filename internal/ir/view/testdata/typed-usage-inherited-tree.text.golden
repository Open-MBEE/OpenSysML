    port status
    part engines
      attribute thrust
      attribute mass
      part subcomponents
        attribute mass
    part subcomponents
      attribute mass
      part subcomponents
        attribute mass
    attribute mass
  part stage2
    attribute propellantMass
    port status
    part engines
      attribute thrust
      attribute mass
      part subcomponents
        attribute mass
    part subcomponents
      attribute mass
      part subcomponents
        attribute mass
    attribute mass
  part subcomponents
    attribute mass
    part subcomponents
      attribute mass
  connect
