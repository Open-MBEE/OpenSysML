    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
---
%% ParameterCalcViews::definitions — tree rendering (render asTreeDiagram)
flowchart TD
  n0["`*«calc def»*
**Add**
parameters
in x
in y
out result`"]
  n1["`*«calc def»*
**Scale**
parameters
in x
in factor
inout count
out doubled
out r`"]
  n2["`*«action def»*
**Heat**
parameters
in bread
out toast`"]
  n3["`*«constraint def»*
**Between**
parameters
in low
in value`"]
