%% HeadingViews::headings — tree rendering (render asTreeDiagram)
%% not represented: 15 node(s) without a position, drawn as compartment rows of the node above them, and 25 node(s) under them left undrawn
%% layout: n0 x=10 y=10
%% layout: n3 x=200 y=10
%% layout: n18 x=500 y=10
%% layout: n25 x=10 y=300
%% layout: n44 x=300 y=300
flowchart TD
  n0["`*«enum def»*
**Mode**
enums
idle
active`"]
  n3["`*«part def»*
**Controller**
attributes
gain
parts
s1
s2
flows
flow
calcs
total
satisfies
safe
rendering
gauge
metadata
metadata usage`"]
  n18["`*«connection def»*
**Link**
ends
end source
end target`"]
  n25["`*«verification case def»*
**Check**
subject
*controller*
objective
objective
actors
tester`"]
  n44["`*«view def»*
**Dashboard**`"]
  n25 ---|"◇ controller"| n3
