CaseExamples::caseDiagram - case rendering (render asCaseDiagram)

use case 'Provide Transportation'
subject vehicle
actor driver
objective (Transport the vehicle and its passengers safely.)
use case addFuel
actor ^fueler
subject ^vehicle
include use case 'enter vehicle'
subject vehicle
actor driver
use case 'Drive Vehicle'
subject vehicle
actor driver
analysis def FuelAnalysis
subject vehicle
objective (Estimate the fuel remaining after a journey.)
verification def FuelVerification
subject vehicle
objective

relationships:
  'Provide Transportation' -- vehicle: «subject»
  driver -- 'Provide Transportation'
  'Provide Transportation' .. objective n3
  fueler -- addFuel
  addFuel -- vehicle: «subject»
  'Provide Transportation' -> addFuel: «include»
  'Provide Transportation' -> 'enter vehicle': «include»
  'enter vehicle' -- vehicle: «subject»
  driver -- 'enter vehicle'
  'Provide Transportation' *-- 'Drive Vehicle'
  'Drive Vehicle' -- vehicle: «subject»
  driver -- 'Drive Vehicle'
  FuelAnalysis -- vehicle: «subject»
  FuelAnalysis .. objective n15
  FuelVerification -- vehicle: «subject»
  FuelVerification .. objective n18

not represented:
  - part def CaseExamples::Tool holds no case; a case rendering does not show it
