# PlantViews::loopView — interconnection rendering (render asInterconnectionDiagram)
classes: {
  definition: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14 } }
  usage: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; border-radius: 8 } }
  pin: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 10 } }
  edge: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
  connection: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 3 } }
}
n0: "«part def»\nLoop" {
  class: definition
  link: "https://example.test/src/interconnection.sysml#L16"
  n1: "«part»\npump" {
    class: usage
    link: "https://example.test/src/interconnection.sysml#L17"
    "n1.0": "outlet" { class: pin }
    n2: "«item»\nwaterOut" { class: usage; link: "https://example.test/src/interconnection.sysml#L6" }
  }
  n3: "«part»\ntank" {
    class: usage
    link: "https://example.test/src/interconnection.sysml#L18"
    "n3.0": "inlet" { class: pin }
    n4: "«item»\nwaterIn" { class: usage; link: "https://example.test/src/interconnection.sysml#L11" }
  }
  n5: "«part»\nsensor" {
    class: usage
    link: "https://example.test/src/interconnection.sysml#L22"
    n6: "«item»\nwaterOut" { class: usage; link: "https://example.test/src/interconnection.sysml#L6" }
  }
}
n0.n1."n1.0" -- n0.n3."n3.0": { class: connection; link: "https://example.test/src/interconnection.sysml#L19" }
n0.n1.n2 -> n0.n3.n4: { class: edge; link: "https://example.test/src/interconnection.sysml#L20" }
