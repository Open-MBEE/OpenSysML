---
config:
  fontFamily: "Helvetica, Arial, sans-serif"
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; } .cluster-label .nodeLabel { text-align: center; }"
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
---
%% GeneralViews::requirementView — requirement rendering (view def GeneralView, filter @RequirementDefinition or @RequirementUsage)
%% not represented: 4 exposed standard library element(s) not drawn; a requirement rendering draws the model's own elements
flowchart TD
  n0["`*«requirement def»*
**MassRequirement**
id R1, “The total mass of the vehicle shall not exceed the stated...”`"]
  n1["`*«requirement def»*
**StoppingRequirement**
id R2, “The vehicle shall stop within the stated distance.”`"]
  n2["`*«requirement def»*
**EmergencyStopRequirement**
id R3`"]
  n3("`*«requirement»*
**vehicleMass**
id R1.1, verdict pass by Cases::light, fail by Cases::heavy`")
  n4("`*«requirement»*
**chassisMass**
id R1.2, verdict pass by Cases::chassis`")
  n5("`*«requirement»*
**emergencyStop**
id R3.1, verdict inconclusive by Cases::stop (no verdict bound), error by Cases::brake (division by zero)`")
  n6["`*«part def»*
**LightChassis**`"]
  n7("`*«part»*
**vehicle**`")
  n8("`*«part»*
**heavyVehicle**`")
  n9("`*«action»*
**brake**`")
  n10["`*«verification def»*
**MassTest**`"]
  n11("`*«verification»*
**lightMassTest**`")
  n12("`*«verification»*
**heavyMassTest**`")
  n13["`*«verification def»*
**StopTest**`"]
  n14("`*«verification»*
**stopTest**`")
  n2 -->|"specialization"| n1
  n3 -.->|"typing"| n0
  n4 -.->|"typing"| n0
  n5 -.->|"typing"| n2
  n4 -.->|"derive"| n3
  n6 -.->|"refine"| n4
  n7 -.->|"satisfy"| n3
  n8 -.->|"satisfy"| n3
  n7 -.->|"satisfy"| n5
  n5 -.-> n9
  n10 -.->|"verify"| n3
  n11 -.->|"verify"| n3
  n12 -.->|"verify"| n3
  n13 -.->|"verify"| n5
  n14 -.->|"verify"| n5
  style n3 fill:#EEBF99,stroke:#D55E00
  style n4 fill:#99D8C7,stroke:#009E73
  style n5 fill:#EBC9DC,stroke:#CC79A7
