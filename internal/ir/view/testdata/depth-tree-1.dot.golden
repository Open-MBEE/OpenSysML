// view: DepthViews::depth1
// kind: tree
// stated: render asTreeDiagram
// not represented: 3 elements nested deeper than 1 level not shown
// layout: dot
digraph "DepthViews::depth1" {
  graph [fontname="Helvetica"];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  "n0" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>vehicle</b>>];
  "n1" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>mass</b>>];
  "n0" -> "n1" [arrowhead=none];
  "n2" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>wheel</b><br/>nested deeper than 1 level; not shown>];
  "n0" -> "n2" [arrowhead=none];
  "n3" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>engine</b><br/>nested deeper than 1 level; not shown>];
  "n4" [style="rounded,filled", label=<<font point-size="10"><i>«port»</i></font><br/><b>fuelIn</b>>];
  "n3" -> "n4" [arrowhead=none];
  "n0" -> "n3" [arrowhead=none];
}
