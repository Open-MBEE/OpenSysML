MixedExamples::mixedDiagram - mixed rendering (render asMixedDiagram)

package MixedExamples
  port def FluidPort
  part def BaseUnit
  part def Pump
    port outlet
  part def Tank
    port inlet
  part def Plant
    part pump
      port outlet
    part tank
      port inlet
  connection def Connection
    part a
    part b
  state def Ready (declares no states)
  state def Modes
    start
    state ready (initial)
  action def Operate
    initial start
    action 'step'
    final done
  use case def Inspection
  subject plant
  actor operator
  objective (Inspect the plant and report its operating state.)
  perform action run (declares no nodes)
  exhibit state mode
    start
    state ready (initial)
  part def Person
  view mixedDiagram
  view mixedLayout

relationships:
  start of Modes -> ready
  start -> 'step'
  'step' -> done
  Inspection -- plant: «subject»
  operator -- Inspection
  Inspection .. objective n12
  start of mode -> ready
  pump.outlet -- tank.inlet
  ready --:|> Ready
  plant --:|> Plant
  operator --:|> Person
  run -> Operate: «perform»
  mode -> Modes: «exhibit»
  Pump --|> BaseUnit: «specializes»
  outlet --:|> FluidPort
  Tank --|> BaseUnit: «specializes»
  inlet --:|> FluidPort
  Plant --|> BaseUnit: «specializes»
  pump --:|> Pump
  tank --:|> Tank
