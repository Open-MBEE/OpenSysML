FlowViews::driveView - action rendering (render asInterconnectionDiagram, view def ActionFlowView)

action def Drive
  initial start
  action provide
    in ^fuel
    out ^torque
  action monitor
    action flow
    in reading
    initial begin
    action record
  assign tally (speed := speed + 1)
  fork split
  join sync
  final done
  action park
  decision check

flow:
  begin -> record
  start -> split
  provide -> sync
  provide.torque => monitor.reading
  monitor -> sync
  tally -> sync
  split -> provide
  split -> monitor
  split -> tally
  sync -> check
  park -> done
  check -> done: [speed > 0]
  check -> park: else
