FlowViews::driveView - action rendering (render asInterconnectionDiagram, view def ActionFlowView)

action def Drive
  initial start
  action provide
  action monitor (own flow)
    initial begin
    action record
  action tally
  fork split
  join sync
  final done
  action park
  decision check

flow:
  begin -> record
  start -> split
  provide -> sync
  provide => monitor
  monitor -> sync
  tally -> sync
  split -> provide
  split -> monitor
  split -> tally
  sync -> check
  park -> done
  check -> done: [speed > 0]
  check -> park
