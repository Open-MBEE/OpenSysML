n14 --> n2 : <U+00AB>exhibit<U+00BB> [[https://example.test/src/mixed.sysml#L49]]
n21 --|> n20 : [[https://example.test/src/mixed.sysml#L8]]
n22 --:|> n19 : [[https://example.test/src/mixed.sysml#L9]]
n23 --|> n20 : [[https://example.test/src/mixed.sysml#L12]]
n24 --:|> n19 : [[https://example.test/src/mixed.sysml#L13]]
n25 --|> n20 : [[https://example.test/src/mixed.sysml#L16]]
n26 --:|> n21 : [[https://example.test/src/mixed.sysml#L17]]
n27 --:|> n23 : [[https://example.test/src/mixed.sysml#L18]]
@enduml
