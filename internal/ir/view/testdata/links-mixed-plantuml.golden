n23 o-- n24 : [[https://example.test/src/mixed.sysml#L13]]
n0 +-- n25 : [[https://example.test/src/mixed.sysml#L16]]
n25 *-- n26 : [[https://example.test/src/mixed.sysml#L17]]
n25 *-- n27 : [[https://example.test/src/mixed.sysml#L18]]
n0 +-- n28 : [[https://example.test/src/mixed.sysml#L22]]
n28 o-- n29 : [[https://example.test/src/mixed.sysml#L23]]
n28 o-- n30 : [[https://example.test/src/mixed.sysml#L24]]
n0 +-- n1 : [[https://example.test/src/mixed.sysml#L27]]
n0 +-- n2 : [[https://example.test/src/mixed.sysml#L29]]
n0 +-- n5 : [[https://example.test/src/mixed.sysml#L34]]
n0 +-- n9 : [[https://example.test/src/mixed.sysml#L42]]
n0 +-- n31 : [[https://example.test/src/mixed.sysml#L52]]
n0 *-- n17 : [[https://example.test/src/mixed.sysml#L54]]
n0 *-- n18 : [[https://example.test/src/mixed.sysml#L59]]
n3 --:|> n1 : [[https://example.test/src/mixed.sysml#L31]]
n10 --:|> n25 : [[https://example.test/src/mixed.sysml#L43]]
n11 --:|> n31 : [[https://example.test/src/mixed.sysml#L44]]
