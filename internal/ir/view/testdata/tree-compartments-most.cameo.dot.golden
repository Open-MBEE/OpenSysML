// view: CompartmentDemoViews::controllers
// kind: tree
// stated: render asTreeDiagram
// not represented: 4 member(s) drawn as compartment rows of their owner
// layout: dot
digraph "CompartmentDemoViews::controllers" {
  graph [fontname="Arial", fontcolor="#424242"];
  node [shape=box, style=filled, fillcolor="#FFCC99:#FFFAD4", gradientangle=0, color="#99795C", fontname="Arial", fontsize=11, fontcolor="#424242", penwidth=1];
  edge [color="#424242", fontname="Arial", fontsize=9, fontcolor="#424242", penwidth=1, arrowhead=open];
  subgraph "cluster_frame" {
    label=<<b>bdd</b> [Block] Sensor [ controllers ]>;
    labeljust=l;
    labelloc=t;
    fontsize=11;
    color="#5B5B59";
    penwidth=1;
    margin=8;
    "n0" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td><font point-size="9">«part def»</font><br/><b>Sensor</b></td></tr><hr/><tr><td><font point-size="9">attributes</font></td></tr><tr><td align="left">label : String<br/>reading : Real</td></tr></table>>];
    "n3" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td><font point-size="9">«part def»</font><br/><b>Controller</b></td></tr><hr/><tr><td><font point-size="9">attributes</font></td></tr><tr><td align="left">enabled : Boolean</td></tr><hr/><tr><td><font point-size="9">parts</font></td></tr><tr><td align="left">sensor : Sensor</td></tr></table>>];
  }
  "n3" -> "n0" [headlabel="sensor", dir=back, arrowtail=diamond];
}
