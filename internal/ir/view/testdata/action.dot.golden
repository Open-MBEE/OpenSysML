// view: FlowViews::driveView
// kind: action
// stated: render asInterconnectionDiagram, view def ActionFlowView
// layout: dot
digraph "FlowViews::driveView" {
  graph [fontname="Helvetica", compound=true];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  subgraph "cluster_frame" {
    label=<<font point-size="10"><i>«view»</i></font> <b>FlowViews::driveView</b> : ActionFlowView>;
    labeljust=l;
    labelloc=t;
    penwidth=0.5;
    margin=8;
    subgraph "cluster_n0" {
      label=<<font point-size="10"><i>«action def»</i></font><br/><b>Drive</b>>;
      color=black;
      penwidth=0.5;
      "n0" [shape=point, style=invis, width=0, height=0, label=""];
      "n1" [shape=circle, fillcolor=black, label="", width=0.2];
      "n2" [shape=plain, style=solid, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td width="6"></td><td port="n2.0" border="1" style="rounded" fixedsize="true" width="10" height="10" bgcolor="white"><font point-size="7">↓</font></td><td align="left"><font point-size="8">^fuel</font></td><td width="6"></td></tr><tr><td colspan="4"><table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="white" style="rounded"><tr><td><font point-size="10"><i>«action»</i></font><br/><b>provide</b></td></tr></table></td></tr><tr><td width="6"></td><td port="n2.1" border="1" style="rounded" fixedsize="true" width="10" height="10" bgcolor="white"><font point-size="7">↓</font></td><td align="left"><font point-size="8">^torque</font></td><td width="6"></td></tr></table>>];
      subgraph "cluster_n3" {
        label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td><font point-size="10"><i>«action»</i></font><br/><b>monitor</b></td></tr><hr/><tr><td><font point-size="10">action flow</font></td></tr></table>>;
        color=black;
        penwidth=0.5;
        "n3" [shape=point, style=invis, width=0, height=0, label=""];
        "n3.0" [shape=box, style="rounded,filled", label="→", xlabel="reading", fontsize=8, width=0.16666666666666666, height=0.16666666666666666, fixedsize=true];
        "n4" [shape=circle, fillcolor=black, label="", width=0.2];
        "n5" [style="rounded,filled", label=<<font point-size="10"><i>«action»</i></font><br/><b>record</b>>];
      }
      "n6" [style="rounded,filled", label=<<font point-size="10"><i>«assign»</i></font><br/><b>tally</b><br/>speed := speed + 1>];
      "n7" [label=<<font point-size="10"><i>«fork»</i></font><br/><b>split</b>>];
      "n8" [label=<<font point-size="10"><i>«join»</i></font><br/><b>sync</b>>];
      "n9" [shape=doublecircle, fillcolor=black, label="", width=0.2];
      "n10" [style="rounded,filled", label=<<font point-size="10"><i>«action»</i></font><br/><b>park</b>>];
      "n11" [label=<<font point-size="10"><i>«decision»</i></font><br/><b>check</b>>];
    }
    { rank=min; "frame_tr" [shape=none, margin=0, label=<<font point-size="10">expose Flows::Drive</font>>]; }
  }
  "n4" -> "n5" [style=dashed, arrowhead=vee];
  "n1" -> "n7" [style=dashed, arrowhead=vee];
  "n2" -> "n8" [style=dashed, arrowhead=vee];
  "n2":"n2.1" -> "n3.0";
  "n3" -> "n8" [style=dashed, arrowhead=vee, ltail="cluster_n3"];
  "n6" -> "n8" [style=dashed, arrowhead=vee];
  "n7" -> "n2" [style=dashed, arrowhead=vee];
  "n7" -> "n3" [style=dashed, arrowhead=vee, lhead="cluster_n3"];
  "n7" -> "n6" [style=dashed, arrowhead=vee];
  "n8" -> "n11" [style=dashed, arrowhead=vee];
  "n10" -> "n9" [style=dashed, arrowhead=vee];
  "n11" -> "n9" [label="[speed > 0]", style=dashed, arrowhead=vee];
  "n11" -> "n10" [label="else", style=dashed, arrowhead=vee];
}
