// view: FlowViews::driveView
// kind: action
// stated: render asInterconnectionDiagram, view def ActionFlowView
// layout: dot
digraph "FlowViews::driveView" {
  graph [fontname="Helvetica", compound=true];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  subgraph "cluster_n0" {
    label=<<font point-size="10"><i>«action def»</i></font><br/><b>Drive</b>>;
    color=black;
    penwidth=0.5;
    "n0" [shape=point, style=invis, width=0, height=0, label=""];
    "n1" [shape=circle, fillcolor=black, label="", width=0.2];
    "n2" [style="rounded,filled", label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td port="n2.0" border="1" fixedsize="true" width="10" height="10"></td><td align="left"><font point-size="8">fuel</font></td></tr><tr><td colspan="2"><font point-size="10"><i>«action»</i></font><br/><b>provide : Provide</b></td></tr><tr><td port="n2.1" border="1" fixedsize="true" width="10" height="10"></td><td align="left"><font point-size="8">torque</font></td></tr></table>>];
    subgraph "cluster_n3" {
      label=<<font point-size="10"><i>«action»</i></font><br/><b>monitor</b><br/>own flow>;
      color=black;
      penwidth=0.5;
      "n3" [shape=point, style=invis, width=0, height=0, label=""];
      "n3.0" [shape=box, label="", xlabel="reading", fontsize=8, width=0.16666666666666666, height=0.16666666666666666, fixedsize=true];
      "n5" [shape=circle, fillcolor=black, label="", width=0.2];
      "n6" [style="rounded,filled", label=<<font point-size="10"><i>«action»</i></font><br/><b>record</b>>];
    }
    "n7" [style="rounded,filled", label=<<font point-size="10"><i>«action»</i></font><br/><b>tally</b>>];
    "n8" [label=<<font point-size="10"><i>«fork»</i></font><br/><b>split</b>>];
    "n9" [label=<<font point-size="10"><i>«join»</i></font><br/><b>sync</b>>];
    "n10" [shape=doublecircle, fillcolor=black, label="", width=0.2];
    "n11" [style="rounded,filled", label=<<font point-size="10"><i>«action»</i></font><br/><b>park</b>>];
    "n12" [label=<<font point-size="10"><i>«decision»</i></font><br/><b>check</b>>];
  }
  "n5" -> "n6";
  "n1" -> "n8";
  "n2" -> "n9";
  "n2":"n2.1" -> "n3.0" [style=dashed];
  "n3" -> "n9" [ltail="cluster_n3"];
  "n7" -> "n9";
  "n8" -> "n2";
  "n8" -> "n3" [lhead="cluster_n3"];
  "n8" -> "n7";
  "n9" -> "n12";
  "n11" -> "n10";
  "n12" -> "n10" [label="[speed > 0]"];
  "n12" -> "n11";
}
