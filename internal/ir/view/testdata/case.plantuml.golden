@startuml
' CaseExamples::caseDiagram — case rendering (render asCaseDiagram)
' not represented: part def CaseExamples::Tool holds no case; a case rendering does not show it
<style>
root {
  BackGroundColor white
  FontName SansSerif
  FontSize 14
  FontColor black
  LineColor #181818
  HorizontalAlignment left
}
element {
  BackGroundColor white
  LineColor #181818
  LineThickness 0.5
  RoundCorner 0
  Shadowing 0.0
}
start, end, activityBar {
  BackGroundColor black
}
arrow {
  LineColor #181818
  LineThickness 1
  FontSize 13
}
note {
  BackGroundColor #FEFFDD
  FontSize 13
}
.usage {
  RoundCorner 20
}
.package {
  LineThickness 1.5
}
.region {
  LineStyle 4
}
</style>
skinparam wrapWidth 300
hide stereotype
left to right direction
usecase "<size:10>//«use case»//</size>\n**CaseExamples::'Provide Transportation' : 'Enter Vehicle'**" as n0 <<use case>> <<usage>>
rectangle "<size:10>//«subject»//</size>\n**vehicle : Vehicle**" as n1 <<subject>> <<usage>>
actor "<size:10>//«actor»//</size>\n**driver : Person**" as n2 <<actor>> <<usage>>
note "**objective**\nTransport the vehicle and its passengers safely." as n3
usecase "<size:10>//«use case def»//</size>\n**CaseExamples::'Add Fuel'**" as n4 <<use case def>>
rectangle "<size:10>//«subject»//</size>\n**vehicle : Vehicle**" as n5 <<subject>> <<usage>>
actor "<size:10>//«actor»//</size>\n**fueler : Person**" as n6 <<actor>> <<usage>>
usecase "<size:10>//«include use case»//</size>\n**'enter vehicle' : 'Enter Vehicle'**" as n7 <<include use case>> <<usage>>
rectangle "<size:10>//«subject»//</size>\n**vehicle**" as n8 <<subject>> <<usage>>
actor "<size:10>//«actor»//</size>\n**driver**" as n9 <<actor>> <<usage>>
usecase "<size:10>//«use case»//</size>\n**'Drive Vehicle'**" as n10 <<use case>> <<usage>>
rectangle "<size:10>//«subject»//</size>\n**vehicle**" as n11 <<subject>> <<usage>>
actor "<size:10>//«actor»//</size>\n**driver**" as n12 <<actor>> <<usage>>
usecase "<size:10>//«analysis def»//</size>\n**CaseExamples::FuelAnalysis**" as n13 <<analysis def>>
rectangle "<size:10>//«subject»//</size>\n**vehicle : Vehicle**" as n14 <<subject>> <<usage>>
note "**objective**\nEstimate the fuel remaining after a journey." as n15
usecase "<size:10>//«verification def»//</size>\n**CaseExamples::FuelVerification**" as n16 <<verification def>>
rectangle "<size:10>//«subject»//</size>\n**vehicle : Vehicle**" as n17 <<subject>> <<usage>>
note "**objective**" as n18
n0 -- n1 : «subject»
n2 -- n0
n0 .. n3
n4 -- n5 : «subject»
n6 -- n4
n0 ..> n4 : «include»
n0 ..> n7 : «include»
n7 -- n8 : «subject»
n9 -- n7
n0 *-- n10
n10 -- n11 : «subject»
n12 -- n10
n13 -- n14 : «subject»
n13 .. n15
n16 -- n17 : «subject»
n16 .. n18
@enduml
