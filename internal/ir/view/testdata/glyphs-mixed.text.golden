NotationGlyphs::Diagrams::mixedGlyphs - mixed rendering (render asMixedDiagram)

requirement def LevelReq
  frame safety
requirement NotationGlyphs::levelReq
requirement capacity
  require constraint capacity::levelReq
    subject plant
      part tank
      part pump
      part spare
    require constraint keepLevel
    assume constraint lowLevel
    require constraint bounded
      in x
    assume constraint tight
      in x
  assert constraint asserted
constraint NotationGlyphs::bounded
  in x
constraint NotationGlyphs::tight
  in x
view tankView
part def Tank
  attribute level

relationships:
  NotationGlyphs::levelReq ..> LevelReq
  tankView ..> Tank: «expose»
  LevelReq -> NotationGlyphs::bounded: «require»
  LevelReq -> NotationGlyphs::tight: «assume»
  capacity -> NotationGlyphs::levelReq: «require»
