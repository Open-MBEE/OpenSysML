// view: AbstractViews::familyLinks
// kind: interconnection
// stated: render asInterconnectionDiagram
// layout: dot
digraph "AbstractViews::familyLinks" {
  graph [fontname="Helvetica"];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  subgraph "cluster_n0" {
    label=<<font point-size="10"><i>«abstract part»</i></font><br/><b>vehicleFamily</b>>;
    color=black;
    penwidth=0.5;
    "n0" [shape=point, style=invis, width=0, height=0, label=""];
    "n1" [style="rounded,filled", label=<<font point-size="10"><i>«abstract port»</i></font><br/><b>fuel</b>>];
    "n2" [style="rounded,filled", label=<<font point-size="10"><i>«abstract part»</i></font><br/><b>engine</b>>];
    "n3" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>chassis</b>>];
    "n4" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>^mass</b>>];
  }
  "n2" -> "n3" [arrowhead=none, penwidth=3];
}
