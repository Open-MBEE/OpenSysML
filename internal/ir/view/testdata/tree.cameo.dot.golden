// view: VehicleViews::vehicleView
// kind: tree
// layout: dot
digraph "VehicleViews::vehicleView" {
  graph [fontname="Arial", fontcolor="#424242"];
  node [shape=box, style=filled, fillcolor="#FFCC99:#FFFAD4", gradientangle=0, color="#99795C", fontname="Arial", fontsize=11, fontcolor="#424242", penwidth=1];
  edge [color="#424242", fontname="Arial", fontsize=9, fontcolor="#424242", penwidth=1, arrowhead=open];
  subgraph "cluster_frame" {
    label=<<b>bdd</b> [Block] Vehicle [ vehicleView ]>;
    labeljust=l;
    labelloc=t;
    fontsize=11;
    color="#5B5B59";
    penwidth=1;
    margin=8;
    "n0" [label=<<font point-size="9">«part def»</font><br/><b>Vehicle</b>>];
    "n1" [label=<<font point-size="9">«part»</font><br/><b>engine</b>>];
    "n2" [label=<<font point-size="9">«attribute»</font><br/><b>power</b>>];
    "n3" [label=<<font point-size="9">«part»</font><br/><b>cylinder</b>>];
    "n4" [label=<<font point-size="9">«part»</font><br/><b>wheels</b>>];
    "n5" [label=<<b>connect</b>>];
  "n0" -> "n5" [arrowhead=none, dir=back, arrowtail=diamond];
    "n6" [label=<<font point-size="9">«view»</font><br/><b>engineSubview</b>>];
    "n7" [label=<<font point-size="9">«part def»</font><br/><b>Engine</b>>];
    "n8" [label=<<font point-size="9">«attribute»</font><br/><b>power</b>>];
    "n9" [label=<<font point-size="9">«part»</font><br/><b>cylinder</b>>];
  "n6" -> "n7" [arrowhead=none, dir=back, arrowtail=diamond];
  }
  "n0" -> "n1" [dir=back, arrowtail=diamond];
  "n0" -> "n4" [dir=back, arrowtail=diamond];
  "n1" -> "n7" [arrowhead=onormaldotdot];
  "n1" -> "n2" [dir=back, arrowtail=odiamond];
  "n1" -> "n3" [dir=back, arrowtail=diamond];
  "n7" -> "n8" [dir=back, arrowtail=odiamond];
  "n7" -> "n9" [dir=back, arrowtail=diamond];
}
