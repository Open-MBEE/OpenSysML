---
config:
  fontFamily: "Helvetica, Arial, sans-serif"
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; } .cluster-label .nodeLabel { text-align: center; }"
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
---
%% GeneralViews::packageView — package rendering (view def GeneralView, filter @Package)
flowchart TD
  n0["`*«package»*
**VehicleStructure**`"]
  n1["`*«package»*
**Powertrain**`"]
  n2["`*«package»*
**VehicleRequirements**`"]
  n3["`*«package»*
**VehicleVerification**`"]
  n4["`*«package»*
**GeneralViews**`"]
  n0 --- n1
  n2 -.->|"private import ::*"| n0
  n3 -.->|"private import ::*"| n0
  n3 -.->|"private import ::*"| n1
  n3 -.->|"private import ::*"| n2
