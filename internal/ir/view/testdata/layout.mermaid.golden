---
config:
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; }"
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
  flowchart:
    subGraphTitleMargin:
      bottom: 24
---
%% PlantViews::placedView — interconnection rendering (render asInterconnectionDiagram)
%% canvas: unit=px w=1200 h=800
%% layout: n1 x=300 y=40 collapsed
%% layout: n2 x=500 y=40 w=120 h=60
%% route: n1->n2 400,70 450,120 500,70
flowchart LR
  subgraph n0 ["`**Loop**
*«part def»*`"]
    direction LR
    n1("`**pump : Pump**
*«part»*`")
    n2("`**tank : Tank**
*«part»*`")
    note0@{ shape: notch-rect, label: "always" }
    note1@{ shape: notch-rect, label: "anchored" }
    note2@{ shape: notch-rect, label: "check pressure" }
  end
  note3@{ shape: notch-rect, label: "free" }
  n1 ===|"supply"| n2
  note0 -.- n1
  note1 -.- n2
  note2 -.- n1
  style n1 fill:#FFE8BD,stroke:#333333,font-family:Arial,font-size:11px,font-weight:bold
  classDef note fill:#FEFFDD,stroke:#181818
  class note0,note1,note2,note3 note
  linkStyle 0 stroke:#0000FF,stroke-width:3px
