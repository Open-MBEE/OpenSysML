// view: InheritedPrefixViews::part1Tree
// kind: tree
// stated: render asTreeDiagram
// layout: dot
digraph "InheritedPrefixViews::part1Tree" {
  graph [fontname="Helvetica"];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  "n0" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>part1</b>>];
  "n1" [style="rounded,filled", label=<<font point-size="10"><i>«port»</i></font><br/><b>^aPort</b>>];
  "n2" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>^mass</b>>];
  "n3" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>^engine</b>>];
  "n0" -> "n1" [dir=back, arrowtail=odiamond];
  "n0" -> "n2" [dir=back, arrowtail=odiamond];
  "n0" -> "n3" [dir=back, arrowtail=diamond];
}
