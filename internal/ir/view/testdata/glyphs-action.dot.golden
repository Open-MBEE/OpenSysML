// view: NotationGlyphs::Diagrams::fillGlyphs
// kind: action
// stated: view def ActionFlowView
// layout: dot
digraph "NotationGlyphs::Diagrams::fillGlyphs" {
  graph [fontname="Helvetica"];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  subgraph "cluster_frame" {
    label=<<font point-size="10"><i>«view»</i></font> <b>NotationGlyphs::Diagrams::fillGlyphs</b> : ActionFlowView>;
    labeljust=l;
    labelloc=t;
    penwidth=0.5;
    margin=8;
    subgraph "cluster_n0" {
      label=<<font point-size="10"><i>«action def»</i></font><br/><b>Fill</b>>;
      color=black;
      penwidth=0.5;
      "n0" [shape=point, style=invis, width=0, height=0, label=""];
      "n1" [style="rounded,filled", label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td colspan="2"><font point-size="10"><i>«action»</i></font><br/><b>open</b></td></tr><tr><td port="n1.0" border="1" fixedsize="true" width="10" height="10"></td><td align="left"><font point-size="8">water</font></td></tr></table>>];
      "n2" [style="rounded,filled", label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td port="n2.0" border="1" fixedsize="true" width="10" height="10"></td><td align="left"><font point-size="8">water</font></td></tr><tr><td colspan="2"><font point-size="10"><i>«action»</i></font><br/><b>pour</b></td></tr></table>>];
    }
    { rank=min; "frame_tr" [shape=none, margin=0, label=<<font point-size="10">expose Fill</font>>]; }
  }
  "n1":"n1.0" -> "n2":"n2.0" [label="«succession flow»", style=dashed];
}
