---
config:
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; }"
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
  flowchart:
    subGraphTitleMargin:
      bottom: 24
---
%% PlantViews::loopView — interconnection rendering (render asInterconnectionDiagram)
flowchart LR
  subgraph n0 ["`**Loop**
*«part def»*`"]
    direction LR
    n1("`**pump : Pump**
*«part»*`")
    n2("`**tank : Tank**
*«part»*`")
    n3("`**sensor : Pump**
*«part»*`")
  end
  n1 ===|"supply"| n2
  n1 -.->|"of Water"| n2
  classDef palette0 fill:#F5D999,stroke:#E69F00
  class n1,n2,n3 palette0
  linkStyle 0 stroke-width:3px
