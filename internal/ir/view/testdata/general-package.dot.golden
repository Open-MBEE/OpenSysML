// view: GeneralViews::packageView
// kind: package
// stated: view def GeneralView, filter @Package
// layout: dot
digraph "GeneralViews::packageView" {
  graph [fontname="Helvetica"];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  subgraph "cluster_frame" {
    label=<<font point-size="10"><i>«view»</i></font> <b>GeneralViews::packageView</b> : GeneralView>;
    labeljust=l;
    labelloc=t;
    penwidth=0.5;
    margin=8;
    "n0" [style="rounded,filled", label=<<font point-size="10"><i>«package»</i></font><br/><b>VehicleStructure</b>>];
    "n1" [style="rounded,filled", label=<<font point-size="10"><i>«package»</i></font><br/><b>Powertrain</b>>];
    "n2" [style="rounded,filled", label=<<font point-size="10"><i>«package»</i></font><br/><b>VehicleRequirements</b>>];
    "n3" [style="rounded,filled", label=<<font point-size="10"><i>«package»</i></font><br/><b>VehicleVerification</b>>];
    "n4" [style="rounded,filled", label=<<font point-size="10"><i>«package»</i></font><br/><b>GeneralViews</b>>];
    { rank=min; "frame_tr" [shape=none, margin=0, label=<<font point-size="10">expose VehicleStructure<br/>expose VehicleStructure::Powertrain<br/>expose VehicleRequirements<br/>expose VehicleVerification<br/>expose GeneralViews</font>>]; }
    { rank=max; "frame_bl" [shape=none, margin=0, label=<<font point-size="10">filter @SysML::Package</font>>]; }
  }
  "n0" -> "n1" [dir=back, arrowtail=odot, taillabel="+", labeldistance=0.4, labelangle=0];
  "n2" -> "n0" [label="«private import»*", arrowhead=vee, style=dashed];
  "n3" -> "n0" [label="«private import»*", arrowhead=vee, style=dashed];
  "n3" -> "n1" [label="«private import»*", arrowhead=vee, style=dashed];
  "n3" -> "n2" [label="«private import»*", arrowhead=vee, style=dashed];
}
