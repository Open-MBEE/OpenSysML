    penwidth=1;
    margin=8;
    "n0" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td><font point-size="9">«part def»</font><br/><b>Hub</b></td></tr><hr/><tr><td><font point-size="9">ports</font></td></tr><tr><td align="left">input : DataPort<br/>input.clock : ClockPort<br/>output : DataPort<br/>output.sync : ClockPort<br/>output.clock : ClockPort</td></tr></table>>];
