  "n13" -> "n14" [arrowhead=none, dir=back, arrowtail=diamond];
  "n0" -> "n13" [arrowhead=none, dir=back, arrowtail=diamond];
    "n15" [label=<<font point-size="9">«part def»</font><br/><b>Buffer</b>>];
  }
