  "n0" -> "n1" [arrowhead=none, dir=back, arrowtail=diamond];
    "n12" [label=<<font point-size="9">«part»</font><br/><b>buffer</b>>];
  "n0" -> "n12" [arrowhead=none, dir=back, arrowtail=diamond];
    "n13" [label=<<font point-size="9">«part»</font><br/><b>slot</b>>];
