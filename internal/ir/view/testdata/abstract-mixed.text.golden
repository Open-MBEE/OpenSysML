AbstractViews::familyMixed - mixed rendering (render asMixedDiagram)

abstract part def Vehicle
  attribute mass
abstract part vehicleFamily
  abstract port fuel
  abstract part engine
  part chassis
variation part def Models
  variant sedan
    abstract part ^engine
    part ^chassis

relationships:
  engine -- chassis
  engine -- chassis
  Vehicle o-- mass
  vehicleFamily o-- fuel
  vehicleFamily *-- engine
  vehicleFamily *-- chassis
  Models o-- sedan
  vehicleFamily --:|> Vehicle
  Models --|> Vehicle
