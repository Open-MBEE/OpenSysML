// view: CaseExamples::caseDiagram
// kind: case
// stated: render asCaseDiagram
// not represented: part def CaseExamples::Tool holds no case; a case rendering does not show it
// layout: dot
digraph "CaseExamples::caseDiagram" {
  graph [fontname="Helvetica", rankdir=LR];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  "n0" [shape=ellipse, label=<<font point-size="10"><i>«use case»</i></font><br/><b>CaseExamples::&#39;Provide Transportation&#39; : &#39;Enter Vehicle&#39;</b>>, URL="https://example.test/src/case.sysml#L26", tooltip="CaseExamples::'Provide Transportation'"];
  "n1" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle : Vehicle</b>>, URL="https://example.test/src/case.sysml#L27", tooltip="CaseExamples::'Provide Transportation'::vehicle"];
