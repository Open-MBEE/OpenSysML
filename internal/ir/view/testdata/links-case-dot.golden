  "n11" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle</b>>, URL="https://example.test/src/case.sysml#L44", tooltip="CaseExamples::'Provide Transportation'::'Drive Vehicle'::vehicle"];
  "n12" [shape=box, label=<<font point-size="10"><i>«actor»</i></font><br/><b>driver</b>>, URL="https://example.test/src/case.sysml#L45", tooltip="CaseExamples::'Provide Transportation'::'Drive Vehicle'::driver"];
