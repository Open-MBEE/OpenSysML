  "n7" [shape=ellipse, label=<<font point-size="10"><i>«include use case»</i></font><br/><b>&#39;enter vehicle&#39; : &#39;Enter Vehicle&#39;</b>>, URL="https://example.test/src/case.sysml#L38", tooltip="CaseExamples::'Provide Transportation'::'enter vehicle'"];
  "n8" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle</b>>, URL="https://example.test/src/case.sysml#L39", tooltip="CaseExamples::'Provide Transportation'::'enter vehicle'::vehicle"];
