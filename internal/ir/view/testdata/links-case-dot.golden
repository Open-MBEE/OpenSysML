  "n0" -> "n4" [label="«include»", style=dashed, URL="https://example.test/src/case.sysml#L34", tooltip="CaseExamples::'Provide Transportation'::addFuel"];
  "n0" -> "n7" [label="«include»", style=dashed, URL="https://example.test/src/case.sysml#L39", tooltip="CaseExamples::'Provide Transportation'::'enter vehicle'"];
  "n7" -> "n8" [label="«subject»", dir=none, URL="https://example.test/src/case.sysml#L40", tooltip="CaseExamples::'Provide Transportation'::'enter vehicle'::vehicle"];
  "n9" -> "n7" [dir=none, URL="https://example.test/src/case.sysml#L41", tooltip="CaseExamples::'Provide Transportation'::'enter vehicle'::driver"];
  "n0" -> "n10" [arrowtail=diamond, dir=back, URL="https://example.test/src/case.sysml#L44", tooltip="CaseExamples::'Provide Transportation'::'Drive Vehicle'"];
  "n10" -> "n11" [label="«subject»", dir=none, URL="https://example.test/src/case.sysml#L45", tooltip="CaseExamples::'Provide Transportation'::'Drive Vehicle'::vehicle"];
  "n12" -> "n10" [dir=none, URL="https://example.test/src/case.sysml#L46", tooltip="CaseExamples::'Provide Transportation'::'Drive Vehicle'::driver"];
  "n13" -> "n14" [label="«subject»", dir=none, URL="https://example.test/src/case.sysml#L51", tooltip="CaseExamples::FuelAnalysis::vehicle"];
