// view: CaseExamples::caseDiagram
// kind: case
// stated: render asCaseDiagram
// not represented: part def CaseExamples::Tool holds no case; a case rendering does not show it
// layout: dot
digraph "CaseExamples::caseDiagram" {
  graph [fontname="Helvetica", rankdir=LR];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  "n0" [shape=ellipse, label=<<font point-size="10"><i>«use case»</i></font><br/><b>&#39;Provide Transportation&#39;</b>>, URL="https://example.test/src/case.sysml#L27", tooltip="CaseExamples::'Provide Transportation'"];
  "n1" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle</b>>, URL="https://example.test/src/case.sysml#L28", tooltip="CaseExamples::'Provide Transportation'::vehicle"];
  "n2" [shape=box, label=<<font point-size="10"><i>«actor»</i></font><br/><b>driver</b>>, URL="https://example.test/src/case.sysml#L29", tooltip="CaseExamples::'Provide Transportation'::driver"];
  "n3" [shape=note, label=<<b>objective</b><br/>Transport the vehicle and its passengers safely.>, URL="https://example.test/src/case.sysml#L30", tooltip="case.sysml:30:3"];
  "n4" [shape=ellipse, label=<<font point-size="10"><i>«use case»</i></font><br/><b>addFuel</b>>, URL="https://example.test/src/case.sysml#L25", tooltip="CaseExamples::addFuel"];
  "n5" [shape=box, label=<<font point-size="10"><i>«actor»</i></font><br/><b>fueler</b>>, URL="https://example.test/src/case.sysml#L18", tooltip="CaseExamples::'Add Fuel'::fueler"];
  "n6" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle</b>>, URL="https://example.test/src/case.sysml#L17", tooltip="CaseExamples::'Add Fuel'::vehicle"];
  "n7" [shape=ellipse, label=<<font point-size="10"><i>«include use case»</i></font><br/><b>&#39;enter vehicle&#39;</b>>, URL="https://example.test/src/case.sysml#L39", tooltip="CaseExamples::'Provide Transportation'::'enter vehicle'"];
  "n8" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle</b>>, URL="https://example.test/src/case.sysml#L40", tooltip="CaseExamples::'Provide Transportation'::'enter vehicle'::vehicle"];
  "n9" [shape=box, label=<<font point-size="10"><i>«actor»</i></font><br/><b>driver</b>>, URL="https://example.test/src/case.sysml#L41", tooltip="CaseExamples::'Provide Transportation'::'enter vehicle'::driver"];
  "n10" [shape=ellipse, label=<<font point-size="10"><i>«use case»</i></font><br/><b>&#39;Drive Vehicle&#39;</b>>, URL="https://example.test/src/case.sysml#L44", tooltip="CaseExamples::'Provide Transportation'::'Drive Vehicle'"];
  "n11" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle</b>>, URL="https://example.test/src/case.sysml#L45", tooltip="CaseExamples::'Provide Transportation'::'Drive Vehicle'::vehicle"];
  "n12" [shape=box, label=<<font point-size="10"><i>«actor»</i></font><br/><b>driver</b>>, URL="https://example.test/src/case.sysml#L46", tooltip="CaseExamples::'Provide Transportation'::'Drive Vehicle'::driver"];
  "n13" [shape=ellipse, label=<<font point-size="10"><i>«analysis def»</i></font><br/><b>FuelAnalysis</b>>, URL="https://example.test/src/case.sysml#L50", tooltip="CaseExamples::FuelAnalysis"];
  "n14" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle</b>>, URL="https://example.test/src/case.sysml#L51", tooltip="CaseExamples::FuelAnalysis::vehicle"];
  "n15" [shape=note, label=<<b>objective</b><br/>Estimate the fuel remaining after a journey.>, URL="https://example.test/src/case.sysml#L52", tooltip="case.sysml:52:3"];
  "n16" [shape=ellipse, label=<<font point-size="10"><i>«verification def»</i></font><br/><b>FuelVerification</b>>, URL="https://example.test/src/case.sysml#L57", tooltip="CaseExamples::FuelVerification"];
  "n17" [shape=box, label=<<font point-size="10"><i>«subject»</i></font><br/><b>vehicle</b>>, URL="https://example.test/src/case.sysml#L58", tooltip="CaseExamples::FuelVerification::vehicle"];
  "n18" [shape=note, label=<<b>objective</b>>, URL="https://example.test/src/case.sysml#L59", tooltip="case.sysml:59:3"];
  "n0" -> "n1" [label="«subject»", dir=none, URL="https://example.test/src/case.sysml#L28", tooltip="CaseExamples::'Provide Transportation'::vehicle"];
