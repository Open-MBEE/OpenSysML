// view: MixedExamples::mixedDiagram
// kind: mixed
// stated: render asMixedDiagram
// layout: dot
digraph "MixedExamples::mixedDiagram" {
  graph [fontname="Arial", fontcolor="#424242", compound=true];
  node [shape=box, style=filled, fillcolor="#FFCC99:#FFFAD4", gradientangle=0, color="#99795C", fontname="Arial", fontsize=11, fontcolor="#424242", penwidth=1];
  edge [color="#424242", fontname="Arial", fontsize=9, fontcolor="#424242", penwidth=1, arrowhead=open];
  subgraph "cluster_frame" {
    label=<<b>mixed</b> [Package] MixedExamples [ mixedDiagram ]>;
    labeljust=l;
    labelloc=t;
    fontsize=11;
    color="#5B5B59";
    penwidth=1;
    margin=8;
    subgraph "cluster_n0" {
      label="";
      style=filled;
      fillcolor="#FFCC99:#FFFAD4";
      gradientangle=0;
      color="#99795C";
      penwidth=1;
      "n0" [shape=point, style=invis, width=0, height=0, label=""];
      "n19" [label=<<font point-size="9">«port def»</font><br/><b>FluidPort</b>>];
      "n20" [label=<<font point-size="9">«part def»</font><br/><b>BaseUnit</b>>];
      subgraph "cluster_n21" {
        label=<<font point-size="9">«part def»</font><br/><b>Pump</b>>;
        style=filled;
        fillcolor="#FFCC99:#FFFAD4";
        gradientangle=0;
        color="#99795C";
        penwidth=1;
        "n21" [shape=point, style=invis, width=0, height=0, label=""];
        "n22" [label=<<font point-size="9">«port»</font><br/><b>outlet</b>>];
      }
      subgraph "cluster_n23" {
        label=<<font point-size="9">«part def»</font><br/><b>Tank</b>>;
        style=filled;
        fillcolor="#FFCC99:#FFFAD4";
        gradientangle=0;
        color="#99795C";
        penwidth=1;
        "n23" [shape=point, style=invis, width=0, height=0, label=""];
        "n24" [label=<<font point-size="9">«port»</font><br/><b>inlet</b>>];
      }
      subgraph "cluster_n25" {
        label=<<font point-size="9">«part def»</font><br/><b>Plant</b>>;
        style=filled;
        fillcolor="#FFCC99:#FFFAD4";
        gradientangle=0;
        color="#99795C";
        penwidth=1;
        "n25" [shape=point, style=invis, width=0, height=0, label=""];
        "n26" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td colspan="4"><table border="1" cellborder="0" cellspacing="0" cellpadding="6"><tr><td><font point-size="9">«part»</font><br/><b>pump</b></td></tr></table></td></tr><tr><td></td><td port="n26.0" border="1" fixedsize="true" width="10" height="10" bgcolor="#FFFFFF"></td><td align="left"><font point-size="8">outlet</font></td><td></td></tr></table>>];
        "n27" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td></td><td port="n27.0" border="1" fixedsize="true" width="10" height="10" bgcolor="#FFFFFF"></td><td align="left"><font point-size="8">inlet</font></td><td></td></tr><tr><td colspan="4"><table border="1" cellborder="0" cellspacing="0" cellpadding="6"><tr><td><font point-size="9">«part»</font><br/><b>tank</b></td></tr></table></td></tr></table>>];
      }
      subgraph "cluster_n28" {
        label=<<font point-size="9">«connection def»</font><br/><b>Connection</b>>;
        style=filled;
        fillcolor="#FFCC99:#FFFAD4";
        gradientangle=0;
        color="#99795C";
        penwidth=1;
        "n28" [shape=point, style=invis, width=0, height=0, label=""];
        "n29" [label=<<font point-size="9">«part»</font><br/><b>a</b>>];
        "n30" [label=<<font point-size="9">«part»</font><br/><b>b</b>>];
      }
      "n1" [style="rounded,filled", fillcolor="#FFFFCC:#FFFFF2", color="#5B5B59", label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td><font point-size="9">«state def»</font><br/><b>Ready</b></td></tr><hr/><tr><td align="left">declares no states</td></tr></table>>];
      subgraph "cluster_n2" {
        label=<<font point-size="9">«state def»</font><br/><b>Modes</b>>;
        style="rounded,filled";
        fillcolor="#FFFFCC:#FFFFF2";
        gradientangle=0;
        color="#5B5B59";
        penwidth=1;
        "n2" [shape=point, style=invis, width=0, height=0, label=""];
        "n4" [shape=circle, fillcolor=black, width=0.2, height=0.2, fixedsize=true, label=""];
        "n3" [style="rounded,filled", fillcolor="#FFFFCC:#FFFFF2", color="#5B5B59", label=<<b>ready</b>>];
      }
      subgraph "cluster_n5" {
        label=<<font point-size="9">«action def»</font><br/><b>Operate</b>>;
        style="rounded,filled";
        fillcolor="#E1E1C3:#F7F7EF";
        gradientangle=0;
        color="#424242";
        penwidth=1;
        "n5" [shape=point, style=invis, width=0, height=0, label=""];
        "n6" [shape=circle, fillcolor=black, width=0.2, height=0.2, fixedsize=true, label=""];
        "n7" [style="rounded,filled", fillcolor="#E1E1C3:#F7F7EF", color="#424242", label=<<b>step</b>>];
        "n8" [shape=doublecircle, fillcolor=black, width=0.2, height=0.2, fixedsize=true, label=""];
      }
      "n9" [shape=ellipse, label=<<font point-size="9">«use case def»</font><br/><b>Inspection</b>>];
      "n10" [shape=box, label=<<font point-size="9">«subject»</font><br/><b>plant</b>>];
      "n11" [shape=box, label=<<font point-size="9">«actor»</font><br/><b>operator</b>>];
      "n12" [shape=note, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td><b>objective</b></td></tr><hr/><tr><td align="left">Inspect the plant and report its operating state.</td></tr></table>>];
      "n13" [style="rounded,filled", fillcolor="#E1E1C3:#F7F7EF", color="#424242", label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td><font point-size="9">«perform action»</font><br/><b>run</b></td></tr><hr/><tr><td align="left">declares no nodes</td></tr></table>>];
      subgraph "cluster_n14" {
        label=<<font point-size="9">«exhibit state»</font><br/><b>mode</b>>;
        style="rounded,filled";
        fillcolor="#FFFFCC:#FFFFF2";
        gradientangle=0;
        color="#5B5B59";
        penwidth=1;
        "n14" [shape=point, style=invis, width=0, height=0, label=""];
        "n16" [shape=circle, fillcolor=black, width=0.2, height=0.2, fixedsize=true, label=""];
        "n15" [style="rounded,filled", fillcolor="#FFFFCC:#FFFFF2", color="#5B5B59", label=<<b>ready</b>>];
      }
      "n31" [label=<<font point-size="9">«part def»</font><br/><b>Person</b>>];
      "n17" [label=<<font point-size="9">«view»</font><br/><b>mixedDiagram</b>>];
      "n18" [label=<<font point-size="9">«view»</font><br/><b>mixedLayout</b>>];
    }
  }
  "n4" -> "n3" [arrowhead=vee];
  "n6" -> "n7" [style=dashed, arrowhead=vee];
  "n7" -> "n8" [style=dashed, arrowhead=vee];
  "n9" -> "n10" [label="«subject»", dir=none];
  "n11" -> "n9" [dir=none];
  "n9" -> "n12" [dir=none, style=dashed];
  "n16" -> "n15" [arrowhead=vee];
  "n26":"n26.0" -> "n27":"n27.0" [arrowhead=none];
  "n3" -> "n1" [arrowhead=onormaldotdot];
  "n10" -> "n25" [arrowhead=onormaldotdot, lhead="cluster_n25"];
  "n11" -> "n31" [arrowhead=onormaldotdot];
  "n13" -> "n5" [label="«perform»", arrowhead=vee, lhead="cluster_n5"];
  "n14" -> "n2" [label="«exhibit»", arrowhead=vee, ltail="cluster_n14", lhead="cluster_n2"];
  "n21" -> "n20" [label="«specializes»", arrowhead=empty, ltail="cluster_n21"];
  "n22" -> "n19" [arrowhead=onormaldotdot];
  "n23" -> "n20" [label="«specializes»", arrowhead=empty, ltail="cluster_n23"];
  "n24" -> "n19" [arrowhead=onormaldotdot];
  "n25" -> "n20" [label="«specializes»", arrowhead=empty, ltail="cluster_n25"];
  "n26" -> "n21" [arrowhead=onormaldotdot, lhead="cluster_n21"];
  "n27" -> "n23" [arrowhead=onormaldotdot, lhead="cluster_n23"];
}
