---
config:
  flowchart:
    subGraphTitleMargin:
      bottom: 48
---
%% FlowViews::driveView — action rendering (render asInterconnectionDiagram, view def ActionFlowView)
flowchart TD
  subgraph n0 ["Drive<br>«action def»"]
    direction TD
    n1["initial"]
    n2["provide : Provide<br>«action»"]
    subgraph n3 ["monitor<br>«action»<br>own flow"]
      direction TD
      n4["initial"]
      n5["record<br>«action»"]
    end
    n6["tally<br>«action»"]
    n7["split<br>«fork»"]
    n8["sync<br>«join»"]
    n9["final"]
    n10["park<br>«action»"]
    n11["check<br>«decision»"]
  end
  n4 --> n5
  n1 --> n7
  n2 --> n8
  n2 -.->|"torque to reading"| n3
  n3 --> n8
  n6 --> n8
  n7 --> n2
  n7 --> n3
  n7 --> n6
  n8 --> n11
  n10 --> n9
  n11 -->|"[speed #gt; 0]"| n9
  n11 --> n10
