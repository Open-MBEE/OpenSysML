---
config:
  themeCSS: ".cluster-label .nodeLabel { text-align: center; }"
  flowchart:
    subGraphTitleMargin:
      bottom: 48
---
%% FlowViews::driveView — action rendering (render asInterconnectionDiagram, view def ActionFlowView)
flowchart TD
  subgraph n0 ["«action def»<br>Drive"]
    direction TD
    n1["initial"]
    n2["«action»<br>provide : Provide"]
    subgraph n3 ["«action»<br>monitor<br>own flow"]
      direction TD
      n5["initial"]
      n6["«action»<br>record"]
    end
    n7["«action»<br>tally"]
    n8["«fork»<br>split"]
    n9["«join»<br>sync"]
    n10["final"]
    n11["«action»<br>park"]
    n12["«decision»<br>check"]
  end
  n5 --> n6
  n1 --> n8
  n2 --> n9
  n2 -.->|"torque to reading"| n3
  n3 --> n9
  n7 --> n9
  n8 --> n2
  n8 --> n3
  n8 --> n7
  n9 --> n12
  n11 --> n10
  n12 -->|"[speed #gt; 0]"| n10
  n12 --> n11
