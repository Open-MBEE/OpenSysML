---
config:
  themeCSS: ".cluster-label .nodeLabel { text-align: center; }"
  flowchart:
    subGraphTitleMargin:
      bottom: 24
---
%% TypedViews::cycleView — action rendering (view def ActionFlowView)
flowchart TD
  subgraph n0 ["«action»<br>run : Cycle"]
    direction TD
    n1["initial"]
    n2["«action»<br>warm : Warm"]
    n3["final"]
  end
  n1 --> n2
  n2 --> n3
