// view: FilteredWalk::structure
// kind: tree
// stated: render asTreeDiagram
// layout: dot
digraph "FilteredWalk::structure" {
  graph [fontname="Helvetica"];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  "n0" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>rover</b>>];
  "n1" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>chassis</b>>];
  "n2" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>axle</b>>];
  "n3" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>radio</b>>];
  "n4" [style="rounded,filled", label=<<font point-size="10"><i>«port»</i></font><br/><b>^rx</b>>];
  "n5" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>gps</b>>];
  "n6" [style="rounded,filled", label=<<b>connect</b>>];
  "n0" -> "n6" [arrowhead=none];
  "n7" [style="rounded,filled", label=<<b>connect</b>>];
  "n0" -> "n7" [arrowhead=none];
  "n0" -> "n1" [dir=back, arrowtail=diamond];
  "n0" -> "n3" [dir=back, arrowtail=diamond];
  "n0" -> "n5" [dir=back, arrowtail=diamond];
  "n1" -> "n2" [dir=back, arrowtail=diamond];
  "n3" -> "n4" [dir=back, arrowtail=odiamond];
}
