---
config:
  fontFamily: "Helvetica, Arial, sans-serif"
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; } .cluster-label .nodeLabel { text-align: center; }"
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
  flowchart:
    subGraphTitleMargin:
      bottom: 72
---
%% ActionFormViews::monitorView — action rendering (render asInterconnectionDiagram, view def ActionFlowView)
flowchart TD
  subgraph n0 ["`*«action def»* **Monitor**
parameters
in sensor
out alarm`"]
    direction TD
    n1@{ shape: f-circ, label: "" }
    n2("`⚑ *«accept action»*
**acceptReading**
reading : Reading
parameters
out reading
inout ^payload
in ^receiver`")
    n3("`⭓ *«send action»*
**sendAlarm**
Alarm to sensor
parameters
in ^payload
in ^sender
in ^receiver`")
    n4("`*«assign»*
**tally**
count := count + 1`")
    subgraph n5 ["«loop» wait<br>while condition<br>count #lt; 10"]
      direction TD
      n5_anchor[" "]
      subgraph n6 ["`**loop body**`"]
        direction TD
        n7("`*«action»*
**poll**`")
        n8("`*«action»*
**record**`")
      end
    end
    subgraph n9 ["`*«loop»* **sweep**
for iterator
i in 1..3`"]
      direction TD
      n9_anchor[" "]
      subgraph n10 ["`**loop body**`"]
        direction TD
        n11("`*«action»*
**'step'**`")
      end
    end
    subgraph n12 ["«if» choose<br>if condition<br>count #gt; 5"]
      direction TD
      n12_anchor[" "]
      subgraph n13 ["`**then body**`"]
        direction TD
        n14("`*«action»*
**raise**`")
      end
      subgraph n15 ["`**else body**`"]
        direction TD
        n16("`*«action»*
**lower**`")
      end
    end
    n17@{ shape: cross-circ, label: "" }
  end
  n7 -.-> n8
  n1 -.-> n2
  n2 -.-> n4
  n3 -.-> n5_anchor
  n4 -.-> n3
  n5_anchor -.-> n9_anchor
  n9_anchor -.-> n12_anchor
  n12_anchor -.-> n17
  classDef anchor fill:none,stroke:none
  class n12_anchor,n5_anchor,n9_anchor anchor
