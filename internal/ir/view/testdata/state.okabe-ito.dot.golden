// view: MachineViews::vehicleStates
// kind: state
// stated: view def StateTransitionView
// layout: dot
digraph "MachineViews::vehicleStates" {
  graph [fontname="Helvetica", compound=true];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  subgraph "cluster_frame" {
    label=<<font point-size="10"><i>«view»</i></font> <b>MachineViews::vehicleStates</b> : StateTransitionView>;
    labeljust=l;
    labelloc=t;
    penwidth=0.5;
    margin=8;
    subgraph "cluster_n0" {
      label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td><font point-size="10"><i>«state def»</i></font><br/><b>VehicleStates</b></td></tr><hr/><tr><td><font point-size="10">state transition</font></td></tr></table>>;
      color=black;
      penwidth=0.5;
      "n0" [shape=point, style=invis, width=0, height=0, label=""];
      "n5" [shape=point, fillcolor=black, label=""];
      "n1" [style="rounded,filled", fillcolor="#EEBF99", color="#D55E00", penwidth=1, label=<<font point-size="10"><i>«state»</i></font><br/><b>off</b><br/>initial>];
      subgraph "cluster_n2" {
        label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td><font point-size="10"><i>«state»</i></font><br/><b>operating</b></td></tr><hr/><tr><td><font point-size="10">state transition</font></td></tr></table>>;
        color=black;
        penwidth=0.5;
        "n2" [shape=point, style=invis, width=0, height=0, label=""];
        "n6" [shape=point, fillcolor=black, label=""];
        "n3" [style="rounded,filled", fillcolor="#EEBF99", color="#D55E00", penwidth=1, label=<<font point-size="10"><i>«state»</i></font><br/><b>idle</b><br/>initial>];
        "n4" [style="rounded,filled", fillcolor="#EEBF99", color="#D55E00", penwidth=1, label=<<font point-size="10"><i>«state»</i></font><br/><b>moving</b>>];
      }
    }
    { rank=min; "frame_tr" [shape=none, margin=0, label=<<font point-size="10">expose Machines::VehicleStates</font>>]; }
  }
  "n5" -> "n1" [arrowhead=vee];
  "n6" -> "n3" [arrowhead=vee];
  "n1" -> "n2" [arrowhead=vee, lhead="cluster_n2"];
  "n2" -> "n1" [arrowhead=vee, ltail="cluster_n2"];
  "n3" -> "n4" [label="accept Signal [temperature > 0]", arrowhead=vee];
  "n4" -> "n3" [arrowhead=vee];
}
