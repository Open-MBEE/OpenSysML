// view: VehicleViews::vehicleView
// kind: tree
// layout: dot
digraph "VehicleViews::vehicleView" {
  graph [fontname="Helvetica"];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  "n0" [label=<<font point-size="10"><i>«part def»</i></font><br/><b>Vehicle</b>>];
  "n1" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>engine</b>>];
  "n0" -> "n1" [arrowhead=none];
  "n2" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>wheels</b>>];
  "n0" -> "n2" [arrowhead=none];
  "n3" [style="rounded,filled", label=<<b>connect</b>>];
  "n0" -> "n3" [arrowhead=none];
  "n4" [style="rounded,filled", label=<<font point-size="10"><i>«view»</i></font><br/><b>engineSubview</b>>];
  "n5" [label=<<font point-size="10"><i>«part def»</i></font><br/><b>Engine</b>>];
  "n6" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>power</b>>];
  "n5" -> "n6" [arrowhead=none];
  "n7" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>cylinder</b>>];
  "n5" -> "n7" [arrowhead=none];
  "n4" -> "n5" [arrowhead=none];
  "n0" -> "n5" [headlabel="engine", dir=back, arrowtail=diamond];
}
