# OrderingViews::deadlockView — sequence rendering (view def SequenceView)
# not represented: successions form a cycle (answering, heard to sent); the messages are shown in declaration order
classes: {
  usage: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; border-radius: 8 } }
  succession: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1; stroke-dash: 3 } }
  open: { target-arrowhead: { shape: arrow }; style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
}
sequence: "" {
  shape: sequence_diagram
  n0: "«part»\nnear" {
    class: usage
    n2: "«event occurrence»\nsent" { class: usage }
    n5: "«event occurrence»\nheard" { class: usage }
  }
  n1: "«part»\nfar" {
    class: usage
    n3: "«event occurrence»\ntaken" { class: usage }
    n4: "«event occurrence»\nspoke" { class: usage }
  }
  n0.n2 -> n1.n3: "ask of Tick" { class: open }
  n1.n3 -> n1.n4: "answering" { class: succession }
  n1.n4 -> n0.n5: "reply of Tick" { class: open }
  n0.n5 -> n0.n2: { class: succession }
}
