# OrderingViews::relayView — sequence rendering (view def SequenceView)
classes: {
  usage: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; border-radius: 8 } }
  succession: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1; stroke-dash: 3 } }
  open: { target-arrowhead: { shape: arrow }; style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
}
sequence: "" {
  shape: sequence_diagram
  n0: "«part»\nleft" {
    class: usage
    n2: "«event occurrence»\nlateSent" { class: usage }
    n4: "«event occurrence»\nearlySent" { class: usage }
  }
  n1: "«part»\nright" {
    class: usage
    n3: "«event occurrence»\nlateTaken" { class: usage }
    n5: "«event occurrence»\nearlyTaken" { class: usage }
  }
  n0.n4 -> n1.n5: "early of Tick" { class: open }
  n1.n5 -> n0.n2: { class: succession }
  n0.n2 -> n1.n3: "late of Tick" { class: open }
}
