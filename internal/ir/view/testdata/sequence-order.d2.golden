# OrderingViews::relayView — sequence rendering (view def SequenceView)
classes: {
  usage: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; border-radius: 8 } }
  flow: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1; stroke-dash: 3 } }
}
sequence: "" {
  shape: sequence_diagram
  n0: "left" { class: usage }
  n1: "right" { class: usage }
  n0 -> n1: "early" { class: flow }
  n0 -> n1: "late" { class: flow }
}
