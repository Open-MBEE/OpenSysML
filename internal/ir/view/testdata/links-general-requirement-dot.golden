// view: GeneralViews::requirementView
// kind: requirement
// stated: view def GeneralView, filter @RequirementDefinition or @RequirementUsage
// not represented: 4 exposed standard library element(s) not drawn; a requirement rendering draws the model's own elements
// layout: dot
digraph "GeneralViews::requirementView" {
  graph [fontname="Helvetica"];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  "n0" [label=<<font point-size="10"><i>«requirement def»</i></font><br/><b>VehicleRequirements::MassRequirement</b><br/>id R1, “The total mass of the vehicle shall not exceed the stated...”>, URL="https://example.test/src/general.sysml#L33", tooltip="VehicleRequirements::MassRequirement"];
  "n1" [label=<<font point-size="10"><i>«requirement def»</i></font><br/><b>VehicleRequirements::StoppingRequirement</b><br/>id R2, “The vehicle shall stop within the stated distance.”>, URL="https://example.test/src/general.sysml#L39", tooltip="VehicleRequirements::StoppingRequirement"];
  "n2" [label=<<font point-size="10"><i>«requirement def»</i></font><br/><b>VehicleRequirements::EmergencyStopRequirement</b><br/>id R3>, URL="https://example.test/src/general.sysml#L42", tooltip="VehicleRequirements::EmergencyStopRequirement"];
  "n3" [style="rounded,filled", label=<<font point-size="10"><i>«requirement»</i></font><br/><b>VehicleRequirements::vehicleMass : MassRequirement</b><br/>id R1.1>, URL="https://example.test/src/general.sysml#L44", tooltip="VehicleRequirements::vehicleMass"];
  "n4" [style="rounded,filled", label=<<font point-size="10"><i>«requirement»</i></font><br/><b>VehicleRequirements::chassisMass : MassRequirement</b><br/>id R1.2>, URL="https://example.test/src/general.sysml#L47", tooltip="VehicleRequirements::chassisMass"];
  "n5" [style="rounded,filled", label=<<font point-size="10"><i>«requirement»</i></font><br/><b>VehicleRequirements::emergencyStop : EmergencyStopRequirement</b><br/>id R3.1>, URL="https://example.test/src/general.sysml#L48", tooltip="VehicleRequirements::emergencyStop"];
  "n6" [label=<<font point-size="10"><i>«part def»</i></font><br/><b>VehicleStructure::LightChassis</b>>, URL="https://example.test/src/general.sysml#L10", tooltip="VehicleStructure::LightChassis"];
  "n7" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>VehicleStructure::vehicle : Vehicle</b>>, URL="https://example.test/src/general.sysml#L14", tooltip="VehicleStructure::vehicle"];
  "n8" [style="rounded,filled", label=<<font point-size="10"><i>«part»</i></font><br/><b>VehicleStructure::heavyVehicle : Vehicle</b>>, URL="https://example.test/src/general.sysml#L17", tooltip="VehicleStructure::heavyVehicle"];
  "n9" [style="rounded,filled", label=<<font point-size="10"><i>«action»</i></font><br/><b>VehicleStructure::brake : Brake</b>>, URL="https://example.test/src/general.sysml#L20", tooltip="VehicleStructure::brake"];
  "n10" [label=<<font point-size="10"><i>«verification def»</i></font><br/><b>VehicleVerification::MassTest</b>>, URL="https://example.test/src/general.sysml#L67", tooltip="VehicleVerification::MassTest"];
  "n11" [label=<<font point-size="10"><i>«verification def»</i></font><br/><b>VehicleVerification::StopTest</b>>, URL="https://example.test/src/general.sysml#L80", tooltip="VehicleVerification::StopTest"];
  "n2" -> "n1" [arrowhead=empty, URL="https://example.test/src/general.sysml#L42", tooltip="VehicleRequirements::EmergencyStopRequirement"];
  "n3" -> "n0" [arrowhead=empty, style=dashed, URL="https://example.test/src/general.sysml#L44", tooltip="VehicleRequirements::vehicleMass"];
  "n4" -> "n0" [arrowhead=empty, style=dashed, URL="https://example.test/src/general.sysml#L47", tooltip="VehicleRequirements::chassisMass"];
  "n5" -> "n2" [arrowhead=empty, style=dashed, URL="https://example.test/src/general.sysml#L48", tooltip="VehicleRequirements::emergencyStop"];
  "n4" -> "n3" [label="derive", arrowhead=vee, style=dashed, URL="https://example.test/src/general.sysml#L50", tooltip="general.sysml:50:2"];
  "n6" -> "n4" [label="refine", arrowhead=vee, style=dashed, URL="https://example.test/src/general.sysml#L54", tooltip="general.sysml:54:2"];
  "n7" -> "n3" [label="satisfy", arrowhead=vee, style=dashed, URL="https://example.test/src/general.sysml#L56", tooltip="general.sysml:56:2"];
  "n8" -> "n3" [label="satisfy", arrowhead=vee, style=dashed, URL="https://example.test/src/general.sysml#L57", tooltip="general.sysml:57:2"];
  "n7" -> "n5" [label="satisfy", arrowhead=vee, style=dashed, URL="https://example.test/src/general.sysml#L58", tooltip="general.sysml:58:2"];
  "n5" -> "n9" [label="allocate", arrowhead=vee, style=dashed, URL="https://example.test/src/general.sysml#L59", tooltip="general.sysml:59:2"];
  "n10" -> "n3" [label="verify", arrowhead=vee, style=dashed, URL="https://example.test/src/general.sysml#L70", tooltip="VehicleVerification::MassTest::vehicleMass"];
  "n11" -> "n5" [label="verify", arrowhead=vee, style=dashed, URL="https://example.test/src/general.sysml#L83", tooltip="VehicleVerification::StopTest::emergencyStop"];
