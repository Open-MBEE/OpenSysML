---
config:
  fontFamily: "Helvetica, Arial, sans-serif"
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; } .cluster-label .nodeLabel { text-align: center; }"
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
---
%% CaseExamples::caseDiagram — case rendering (render asCaseDiagram)
%% not represented: part def CaseExamples::Tool holds no case; a case rendering does not show it
flowchart LR
  n0(["`*«use case»*
**CaseExamples::'Provide Transportation' : 'Enter Vehicle'**`"])
  n1["`*«subject»*
**vehicle : Vehicle**`"]
  n2["`*«actor»*
**driver : Person**`"]
  n3@{ shape: notch-rect, label: "objective<br>Transport the vehicle and its passengers safely." }
  n4(["`*«use case def»*
**CaseExamples::'Add Fuel'**`"])
  n5["`*«subject»*
**vehicle : Vehicle**`"]
  n6["`*«actor»*
**fueler : Person**`"]
  n7@{ shape: notch-rect, label: "«objective»<br>obj" }
  n8(["`*«include use case»*
**'enter vehicle' : 'Enter Vehicle'**`"])
  n9["`*«subject»*
**vehicle**`"]
  n10["`*«actor»*
**driver**`"]
  n11@{ shape: notch-rect, label: "«objective»<br>obj" }
  n12(["`*«use case»*
**'Drive Vehicle'**`"])
  n13["`*«subject»*
**vehicle**`"]
  n14["`*«actor»*
**driver**`"]
  n15@{ shape: notch-rect, label: "«objective»<br>obj" }
  n16(["`*«analysis def»*
**CaseExamples::FuelAnalysis**`"])
  n17["`*«subject»*
**vehicle : Vehicle**`"]
  n18@{ shape: notch-rect, label: "objective<br>Estimate the fuel remaining after a journey." }
  n19(["`*«verification def»*
**CaseExamples::FuelVerification**`"])
  n20["`*«subject»*
**vehicle : Vehicle**`"]
  n21@{ shape: notch-rect, label: "objective" }
  n0 ---|"«subject»"| n1
  n2 --- n0
  n0 -.- n3
  n4 ---|"«subject»"| n5
  n6 --- n4
  n4 -.- n7
  n0 -.->|"«include»"| n4
  n0 -.->|"«include»"| n8
  n8 ---|"«subject»"| n9
  n10 --- n8
  n8 -.- n11
  n0 ---|"«composition»"| n12
  n12 ---|"«subject»"| n13
  n14 --- n12
  n12 -.- n15
  n16 ---|"«subject»"| n17
  n16 -.- n18
  n19 ---|"«subject»"| n20
  n19 -.- n21
