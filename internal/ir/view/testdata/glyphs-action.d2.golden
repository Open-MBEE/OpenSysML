# NotationGlyphs::Diagrams::fillGlyphs — action rendering (view def ActionFlowView)
classes: {
  definition: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14 } }
  usage: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; border-radius: 8 } }
  pin: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 10 } }
  successionflow: { target-arrowhead: { shape: triangle; style: { filled: true } }; style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1; stroke-dash: 3 } }
}
n0: "«action def»\nFill" {
  class: definition
  n1: "«action»\nopen" {
    class: usage
    "n1.0": "water" { class: pin }
  }
  n2: "«action»\npour" {
    class: usage
    "n2.0": "water" { class: pin }
  }
}
n0.n1."n1.0" -> n0.n2."n2.0": "«succession flow»" { class: successionflow }
