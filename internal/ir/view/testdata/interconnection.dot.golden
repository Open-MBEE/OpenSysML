// view: PlantViews::loopView
// kind: interconnection
// stated: render asInterconnectionDiagram
// layout: dot
digraph "PlantViews::loopView" {
  graph [fontname="Helvetica", compound=true];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  subgraph "cluster_n0" {
    label=<<font point-size="10"><i>«part def»</i></font><br/><b>Loop</b>>;
    color=black;
    penwidth=0.5;
    "n0" [shape=point, style=invis, width=0, height=0, label=""];
    subgraph "cluster_n1" {
      label=<<font point-size="10"><i>«part»</i></font><br/><b>pump</b>>;
      color=black;
      penwidth=0.5;
      "n1" [shape=point, style=invis, width=0, height=0, label=""];
      "n1.0" [shape=box, label="", xlabel="outlet", fontsize=8, width=0.16666666666666666, height=0.16666666666666666, fixedsize=true];
      "n2" [style="rounded,filled", label=<<font point-size="10"><i>«item»</i></font><br/><b>waterOut</b>>];
    }
    subgraph "cluster_n3" {
      label=<<font point-size="10"><i>«part»</i></font><br/><b>tank</b>>;
      color=black;
      penwidth=0.5;
      "n3" [shape=point, style=invis, width=0, height=0, label=""];
      "n3.0" [shape=box, label="", xlabel="inlet", fontsize=8, width=0.16666666666666666, height=0.16666666666666666, fixedsize=true];
      "n4" [style="rounded,filled", label=<<font point-size="10"><i>«item»</i></font><br/><b>waterIn</b>>];
    }
    subgraph "cluster_n5" {
      label=<<font point-size="10"><i>«part»</i></font><br/><b>sensor</b>>;
      color=black;
      penwidth=0.5;
      "n5" [shape=point, style=invis, width=0, height=0, label=""];
      "n6" [style="rounded,filled", label=<<font point-size="10"><i>«item»</i></font><br/><b>waterOut</b>>];
    }
  }
  "n1.0" -> "n3.0" [arrowhead=none, penwidth=3];
  "n2" -> "n4" [style=dashed];
}
