// view: NotationGlyphs::Diagrams::lineGlyphs
// kind: interconnection
// stated: render asInterconnectionDiagram
// layout: dot
digraph "NotationGlyphs::Diagrams::lineGlyphs" {
  graph [fontname="Helvetica"];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  subgraph "cluster_n0" {
    label=<<font point-size="10"><i>«part»</i></font><br/><b>line</b>>;
    color=black;
    penwidth=0.5;
    "n0" [shape=point, style=invis, width=0, height=0, label=""];
    subgraph "cluster_n1" {
      label=<<font point-size="10"><i>«part»</i></font><br/><b>a</b>>;
      color=black;
      penwidth=0.5;
      "n1" [shape=point, style=invis, width=0, height=0, label=""];
      "n2" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>level</b>>];
    }
    subgraph "cluster_n3" {
      label=<<font point-size="10"><i>«part»</i></font><br/><b>b</b>>;
      color=black;
      penwidth=0.5;
      "n3" [shape=point, style=invis, width=0, height=0, label=""];
      "n4" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>level</b>>];
    }
  }
  "n2" -> "n4" [label="«succession flow»", style=dashed];
}
