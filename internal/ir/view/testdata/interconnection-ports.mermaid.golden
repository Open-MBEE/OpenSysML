---
config:
  flowchart:
    subGraphTitleMargin:
      bottom: 24
---
%% ToasterViews::toasterView — interconnection rendering (render asInterconnectionDiagram)
flowchart LR
  subgraph n0 ["Toaster<br>«part def»"]
    direction LR
    subgraph n1 ["heating : HeatingSystem<br>«part»"]
      direction LR
      n1.0["durationIn : ~DurationPort<br>«port»"]
    end
    subgraph n2 ["control : ControlSystem<br>«part»"]
      direction LR
      n2.0["durationOut : DurationPort<br>«port»"]
    end
    n3["chassis : Chassis<br>«part»"]
  end
  n2.0 ---|"durationInterface"| n1.0
  n2.0 -.->|"of Real"| n1.0
