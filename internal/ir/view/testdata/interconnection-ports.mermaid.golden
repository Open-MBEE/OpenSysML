---
config:
  fontFamily: "Helvetica, Arial, sans-serif"
  theme: base
  themeCSS: ".edgeLabel rect { opacity: 1 !important; } .cluster-label .nodeLabel { text-align: center; }"
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    clusterBkg: "#FFFFFF"
    clusterBorder: "#181818"
    edgeLabelBackground: "#FFFFFF"
  flowchart:
    subGraphTitleMargin:
      bottom: 24
---
%% ToasterViews::toasterView — interconnection rendering (render asInterconnectionDiagram)
flowchart LR
  subgraph n0 ["`*«part def»*
**Toaster**`"]
    direction LR
    subgraph n1 ["`*«part»*
**heating : HeatingSystem**`"]
      direction LR
      n1.0["durationIn"]
    end
    subgraph n2 ["`*«part»*
**control : ControlSystem**`"]
      direction LR
      n2.0["durationOut"]
    end
    n3("`*«part»*
**chassis : Chassis**`")
  end
  n2.0 ===|"durationInterface"| n1.0
  n2.0 -.->|"of Real"| n1.0
  linkStyle 0 stroke-width:3px
