VehicleViews::vehicleView - tree rendering (the view states no rendering; a tree is the default)

part def Vehicle
  part engine
    attribute ^power
    part ^cylinder
  part wheels
  connect
view engineSubview
  part def Engine
    attribute power
    part cylinder

relationships:
  Vehicle *-- engine
  Vehicle *-- wheels
  engine --:|> Engine
  engine o-- power
  engine *-- cylinder
  Engine o-- power
  Engine *-- cylinder
