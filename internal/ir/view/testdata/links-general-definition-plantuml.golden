@startuml
' GeneralViews::definitionView — definition rendering (view def GeneralView, filter @Definition or @Usage)
<style>
root {
  BackGroundColor white
  FontName SansSerif
  FontSize 14
  FontColor black
  LineColor #181818
  HorizontalAlignment left
}
element {
  BackGroundColor white
  LineColor #181818
  LineThickness 0.5
  RoundCorner 0
  Shadowing 0.0
}
start, end, activityBar {
  BackGroundColor black
}
arrow {
  LineColor #181818
  LineThickness 1
  FontSize 13
}
note {
  BackGroundColor #FEFFDD
  FontSize 13
}
.usage {
  RoundCorner 20
}
.package {
  LineThickness 1.5
}
.region {
  LineStyle 4
}
</style>
skinparam wrapWidth 300
hide stereotype
hide circle
hide empty members
class "**Vehicle**" as n0 <<part def>> [[https://example.test/src/general.sysml#L4]]
class "**Chassis**" as n1 <<part def>> [[https://example.test/src/general.sysml#L9]]
class "**LightChassis**" as n2 <<part def>> [[https://example.test/src/general.sysml#L10]]
class "**Driver**" as n3 <<part def>> [[https://example.test/src/general.sysml#L11]]
class "**Brake**" as n4 <<action def>> [[https://example.test/src/general.sysml#L12]]
class "**vehicle**" as n5 <<part>> <<usage>> [[https://example.test/src/general.sysml#L14]]
class "**heavyVehicle**" as n6 <<part>> <<usage>> [[https://example.test/src/general.sysml#L17]]
class "**brake**" as n7 <<action>> <<usage>> [[https://example.test/src/general.sysml#L20]]
class "**Vehicle::mass**" as n8 <<attribute>> <<usage>> [[https://example.test/src/general.sysml#L5]]
class "**chassis**" as n9 <<part>> <<usage>> [[https://example.test/src/general.sysml#L6]]
class "**driver**" as n10 <<part>> <<usage>> [[https://example.test/src/general.sysml#L7]]
class "**vehicle::mass**" as n11 <<attribute>> <<usage>> [[https://example.test/src/general.sysml#L15]]
class "**heavyVehicle::mass**" as n12 <<attribute>> <<usage>> [[https://example.test/src/general.sysml#L18]]
class "**Engine**" as n13 <<part def>> [[https://example.test/src/general.sysml#L23]]
n2 --|> n1 : [[https://example.test/src/general.sysml#L10]]
n5 ..|> n0 : [[https://example.test/src/general.sysml#L14]]
n6 ..|> n0 : [[https://example.test/src/general.sysml#L17]]
n7 ..|> n4 : [[https://example.test/src/general.sysml#L20]]
n0 o-- n8 : [[https://example.test/src/general.sysml#L5]]
n9 ..|> n1 : [[https://example.test/src/general.sysml#L6]]
n0 *-- n9 : [[https://example.test/src/general.sysml#L6]]
n10 ..|> n3 : [[https://example.test/src/general.sysml#L7]]
n0 o-- n10 : [[https://example.test/src/general.sysml#L7]]
n11 --|> n8 : redefines [[https://example.test/src/general.sysml#L15]]
n5 o-- n11 : [[https://example.test/src/general.sysml#L15]]
n12 --|> n8 : redefines [[https://example.test/src/general.sysml#L18]]
n6 o-- n12 : [[https://example.test/src/general.sysml#L18]]
@enduml
