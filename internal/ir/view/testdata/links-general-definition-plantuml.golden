@startuml
' GeneralViews::definitionView — definition rendering (view def GeneralView, filter @Definition or @Usage)
<style>
root {
  BackGroundColor white
  FontName SansSerif
  FontSize 14
  FontColor black
  LineColor #181818
  HorizontalAlignment left
}
element {
  BackGroundColor white
  LineColor #181818
  LineThickness 0.5
  RoundCorner 0
  Shadowing 0.0
}
start, end, activityBar {
  BackGroundColor black
}
arrow {
  LineColor #181818
  LineThickness 1
  FontSize 13
}
note {
  BackGroundColor #FEFFDD
  FontSize 13
}
.usage {
  RoundCorner 20
}
.package {
  LineThickness 1.5
}
.region {
  LineStyle 4
}
</style>
skinparam wrapWidth 300
hide stereotype
hide circle
hide empty members
class "<size:10>//«part def»//</size>\n**Vehicle**" as n0 <<part def>> [[https://example.test/src/general.sysml#L4]]
class "<size:10>//«part def»//</size>\n**Chassis**" as n1 <<part def>> [[https://example.test/src/general.sysml#L9]]
class "<size:10>//«part def»//</size>\n**LightChassis**" as n2 <<part def>> [[https://example.test/src/general.sysml#L10]]
class "<size:10>//«part def»//</size>\n**Driver**" as n3 <<part def>> [[https://example.test/src/general.sysml#L11]]
class "<size:10>//«action def»//</size>\n**Brake**" as n4 <<action def>> [[https://example.test/src/general.sysml#L12]]
class "<size:10>//«part»//</size>\n**vehicle : Vehicle**" as n5 <<part>> <<usage>> [[https://example.test/src/general.sysml#L14]]
class "<size:10>//«part»//</size>\n**heavyVehicle : Vehicle**" as n6 <<part>> <<usage>> [[https://example.test/src/general.sysml#L17]]
class "<size:10>//«action»//</size>\n**brake : Brake**" as n7 <<action>> <<usage>> [[https://example.test/src/general.sysml#L20]]
class "<size:10>//«attribute»//</size>\n**mass : Real**" as n8 <<attribute>> <<usage>> [[https://example.test/src/general.sysml#L5]]
class "<size:10>//«part»//</size>\n**chassis : Chassis**" as n9 <<part>> <<usage>> [[https://example.test/src/general.sysml#L6]]
class "<size:10>//«part»//</size>\n**driver : Driver**" as n10 <<part>> <<usage>> [[https://example.test/src/general.sysml#L7]]
class "<size:10>//«attribute»//</size>\n**mass**" as n11 <<attribute>> <<usage>> [[https://example.test/src/general.sysml#L15]]
class "<size:10>//«attribute»//</size>\n**mass**" as n12 <<attribute>> <<usage>> [[https://example.test/src/general.sysml#L18]]
class "<size:10>//«part def»//</size>\n**Powertrain::Engine**" as n13 <<part def>> [[https://example.test/src/general.sysml#L23]]
n2 --|> n1 : [[https://example.test/src/general.sysml#L10]]
n5 ..|> n0 : [[https://example.test/src/general.sysml#L14]]
n6 ..|> n0 : [[https://example.test/src/general.sysml#L17]]
n7 ..|> n4 : [[https://example.test/src/general.sysml#L20]]
n0 o-- n8 : [[https://example.test/src/general.sysml#L5]]
n9 ..|> n1 : [[https://example.test/src/general.sysml#L6]]
n0 *-- n9 : [[https://example.test/src/general.sysml#L6]]
n10 ..|> n3 : [[https://example.test/src/general.sysml#L7]]
n0 o-- n10 : [[https://example.test/src/general.sysml#L7]]
n11 --|> n8 : redefines [[https://example.test/src/general.sysml#L15]]
n5 o-- n11 : [[https://example.test/src/general.sysml#L15]]
n12 --|> n8 : redefines [[https://example.test/src/general.sysml#L18]]
n6 o-- n12 : [[https://example.test/src/general.sysml#L18]]
@enduml
