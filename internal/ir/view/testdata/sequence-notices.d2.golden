# NoticeViews::handshakeView — sequence rendering (view def SequenceView)
# not represented: attribute def Kit::Level has no place in a sequence rendering; it is not shown
# not represented: a connect in Talk::Handshake states no direction; a sequence rendering shows directed messages only
# not represented: message pending states no source and target; no message is drawn
# not represented: message adrift attaches to monitor.tapped, which is on no lifeline the rendering shows; no message is drawn
classes: {
  usage: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; border-radius: 8 } }
  pin: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 10 } }
  edge: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
  open: { target-arrowhead: { shape: arrow }; style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
}
sequence: "" {
  shape: sequence_diagram
  n0: "«part»\ncaller" {
    class: usage
    n2: "outbox" { class: pin }
    n4: "«event occurrence»\nsent" { class: usage }
    n5: "«event occurrence»\nheard" { class: usage }
  }
  n1: "«part»\ncallee" {
    class: usage
    n3: "inbox" { class: pin }
  }
  n0.n2 -> n1.n3: "of Ping" { class: edge }
  n0.n4 -> n0.n5: "echo of Ping" { class: open }
}
