GeneralViews::requirementView - requirement rendering (view def GeneralView, filter @RequirementDefinition or @RequirementUsage)

requirement def MassRequirement (id R1, “The total mass of the vehicle shall not exceed the stated...”)
requirement def StoppingRequirement (id R2, “The vehicle shall stop within the stated distance.”)
requirement def EmergencyStopRequirement (id R3)
requirement vehicleMass (id R1.1, verdict pass by Cases::light, fail by Cases::heavy)
requirement chassisMass (id R1.2, verdict pass by Cases::chassis)
requirement emergencyStop (id R3.1, verdict inconclusive by Cases::stop (no verdict bound), error by Cases::brake (division by zero))
part def LightChassis
part vehicle
part heavyVehicle
action brake
verification def MassTest
verification lightMassTest
verification heavyMassTest
verification def StopTest
verification stopTest

relationships:
  EmergencyStopRequirement --|> StoppingRequirement
  vehicleMass --:|> MassRequirement
  chassisMass --:|> MassRequirement
  emergencyStop --:|> EmergencyStopRequirement
  chassisMass ..> vehicleMass: «derive»
  LightChassis ..> chassisMass: «refine»
  vehicle -> vehicleMass: «satisfy»
  heavyVehicle -> vehicleMass: «satisfy»
  vehicle -> emergencyStop: «satisfy»
  emergencyStop -> brake: «allocate»
  MassTest -> vehicleMass: «verify»
  lightMassTest -> vehicleMass: «verify»
  heavyMassTest -> vehicleMass: «verify»
  StopTest -> emergencyStop: «verify»
  stopTest -> emergencyStop: «verify»

not represented:
  - 4 exposed standard library element(s) not drawn; a requirement rendering draws the model's own elements
