---
config:
  themeCSS: ".cluster-label .nodeLabel { text-align: center; }"
  flowchart:
    subGraphTitleMargin:
      bottom: 24
---
%% PlantViews::loopView — interconnection rendering (render asInterconnectionDiagram)
flowchart LR
  subgraph n0 ["«part def»<br>Loop"]
    direction LR
    subgraph n1 ["«part»<br>pump : Pump"]
      direction LR
      n1.0["outlet"]
    end
    subgraph n2 ["«part»<br>tank : Tank"]
      direction LR
      n2.0["inlet"]
    end
    n3["«part»<br>sensor : Pump"]
  end
  n1.0 ---|"supply"| n2.0
  n1 -.->|"of Water"| n2
