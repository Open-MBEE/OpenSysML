---
config:
  flowchart:
    subGraphTitleMargin:
      bottom: 24
---
%% PlantViews::loopView — interconnection rendering (render asInterconnectionDiagram)
flowchart LR
  subgraph n0 ["Loop<br>«part def»"]
    direction LR
    subgraph n1 ["pump : Pump<br>«part»"]
      direction LR
      n1.0["outlet : FluidPort<br>«port»"]
    end
    subgraph n2 ["tank : Tank<br>«part»"]
      direction LR
      n2.0["inlet : FluidPort<br>«port»"]
    end
    subgraph n3 ["sensor : Pump<br>«part»"]
      direction LR
      n3.0["outlet : FluidPort<br>«port»"]
    end
  end
  n1.0 ---|"supply"| n2.0
  n1 -.->|"of Water"| n2
