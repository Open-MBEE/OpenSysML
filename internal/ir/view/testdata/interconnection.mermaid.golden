---
config:
  flowchart:
    subGraphTitleMargin:
      bottom: 24
---
%% PlantViews::loopView — interconnection rendering (render asInterconnectionDiagram)
flowchart LR
  subgraph n0 ["Loop<br>«part def»"]
    direction LR
    n1["pump : Pump<br>«part»<br>port outlet : FluidPort"]
    n2["tank : Tank<br>«part»<br>port inlet : FluidPort"]
    n3["sensor : Pump<br>«part»<br>port outlet : FluidPort"]
  end
  n1 ---|"supply"| n2
  n1 -.->|"of Water"| n2
