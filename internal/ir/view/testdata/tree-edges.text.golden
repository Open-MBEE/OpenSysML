FleetViews::structure - tree rendering (the view states no rendering; a tree is the default)

part def Vehicle
  part chassis
    attribute mass
  part wheels
  part driver
  attribute total
  part def Cabin
  part cabin
  part radio
  part trailer
part def SportsCar
  part chassis
    attribute mass
  part spare
  part wheels
  part driver
  attribute total
  part cabin
  part radio
  part trailer
part def Chassis
  attribute mass
part def LightChassis
  attribute mass
part def Wheel
part def Driver
attribute def Mass
part fleetCar
  part chassis
    attribute mass
  part wheels
  part driver
  attribute total
  part cabin
  part radio
  part trailer

relationships:
  Vehicle *-- Chassis: chassis
  Vehicle *-- Wheel: wheels
  Vehicle o-- Driver: driver
  Vehicle o-- Mass: total
  SportsCar --|> Vehicle
  SportsCar *-- LightChassis: chassis
  SportsCar *-- Wheel: spare
  chassis --||> chassis
  spare --|> wheels
  Chassis o-- Mass: mass
  LightChassis --|> Chassis
  mass --||> mass
  fleetCar --:|> Vehicle
