FleetViews::structure - tree rendering (the view states no rendering; a tree is the default)

part def Vehicle
  part chassis
    attribute mass
  part wheels
  part driver
  attribute total
  part def Cabin
  part cabin
  part radio
  part trailer
part def SportsCar
  part chassis
    attribute mass
  part spare
  part wheels
  part driver
  attribute total
  part cabin
  part radio
  part trailer
part def Chassis
  attribute mass
part def LightChassis
  attribute mass
part def Wheel
part def Driver
attribute def Mass
part fleetCar
  part chassis
    attribute mass
  part wheels
  part driver
  attribute total
  part cabin
  part radio
  part trailer

relationships:
  Vehicle *-- chassis
  Vehicle *-- wheels
  Vehicle o-- driver
  Vehicle o-- total
  Vehicle *-- cabin
  Vehicle *-- radio
  Vehicle *-- trailer
  chassis ..|> Chassis
  chassis o-- mass
  wheels ..|> Wheel
  driver ..|> Driver
  total ..|> Mass
  cabin ..|> Cabin
  SportsCar --|> Vehicle
  SportsCar *-- chassis
  SportsCar *-- spare
  SportsCar *-- wheels
  SportsCar o-- driver
  SportsCar o-- total
  SportsCar *-- cabin
  SportsCar *-- radio
  SportsCar *-- trailer
  chassis --|> chassis: redefines
  chassis ..|> LightChassis
  chassis o-- mass
  spare ..|> Wheel
  spare --|> wheels: subsets
  Chassis o-- mass
  mass ..|> Mass
  LightChassis --|> Chassis
  LightChassis o-- mass
  mass --|> mass: redefines
  fleetCar ..|> Vehicle
  fleetCar *-- chassis
  fleetCar *-- wheels
  fleetCar o-- driver
  fleetCar o-- total
  fleetCar *-- cabin
  fleetCar *-- radio
  fleetCar *-- trailer
