# FlowViews::driveView — action rendering (render asInterconnectionDiagram, view def ActionFlowView)
# not represented: 1 pin(s) not drawn (provide.fuel); D2 draws the pins an edge ends at
# not represented: 2 fork/join name(s) (split, sync); D2's fork bar draws no label
classes: {
  definition: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14 } }
  usage: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; border-radius: 8 } }
  pin: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 10 } }
  initial: { shape: oval; width: 18; height: 18; style: { fill: black; stroke: black } }
  final: { shape: oval; width: 22; height: 22; style: { fill: black; stroke: black; double-border: true } }
  bar: { shape: rectangle; width: 80; height: 8; style: { fill: black; stroke: black } }
  choice: { shape: diamond; style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14 } }
  edge: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1 } }
  flow: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1; stroke-dash: 3 } }
}
n0: "«action def»\nDrive" {
  class: definition
  n1: "" { class: initial }
  n2: "«action»\nprovide : Provide" {
    class: usage
    "n2.1": "torque" { class: pin }
  }
  n3: "«action»\nmonitor\nown flow" {
    class: usage
    "n3.0": "reading" { class: pin }
    n4: "" { class: initial }
    n5: "«action»\nrecord" { class: usage }
  }
  n6: "«action»\ntally" { class: usage }
  n7: "" { class: bar }
  n8: "" { class: bar }
  n9: "" { class: final }
  n10: "«action»\npark" { class: usage }
  n11: "«decision»\ncheck" { class: choice }
}
n0.n3.n4 -> n0.n3.n5: { class: edge }
n0.n1 -> n0.n7: { class: edge }
n0.n2 -> n0.n8: { class: edge }
n0.n2."n2.1" -> n0.n3."n3.0": "torque to reading" { class: flow }
n0.n3 -> n0.n8: { class: edge }
n0.n6 -> n0.n8: { class: edge }
n0.n7 -> n0.n2: { class: edge }
n0.n7 -> n0.n3: { class: edge }
n0.n7 -> n0.n6: { class: edge }
n0.n8 -> n0.n11: { class: edge }
n0.n10 -> n0.n9: { class: edge }
n0.n11 -> n0.n9: "[speed > 0]" { class: edge }
n0.n11 -> n0.n10: { class: edge }
