  "n3" [style="rounded,filled", label=<<b>attribute</b>>];
  "n4" [label=<<font point-size="10"><i>«part def»</i></font><br/><b>Sensor</b>>];
  "n5" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>a</b>>];
  "n6" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>b</b>>];
  "n7" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>gain</b>>];
  "n8" [style="rounded,filled", label=<<font point-size="10"><i>«calc»</i></font><br/><b>sum</b>>];
  "n9" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>x</b>>];
  "n10" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>^y</b>>];
  "n11" [style="rounded,filled", label=<<b>attribute</b>>];
  "n4" -> "n8" [arrowhead=none];
  "n12" [style="rounded,filled", label=<<font point-size="10"><i>«calc»</i></font><br/><b>scaled</b>>];
  "n13" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>factor</b>>];
  "n14" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>^x</b>>];
  "n15" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>^count</b>>];
  "n16" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>^doubled</b>>];
  "n17" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>^r</b>>];
  "n4" -> "n12" [arrowhead=none];
  "n0" -> "n1" [dir=back, arrowtail=odiamond];
  "n0" -> "n2" [dir=back, arrowtail=odiamond];
  "n0" -> "n3" [dir=back, arrowtail=odiamond];
  "n4" -> "n5" [dir=back, arrowtail=odiamond];
  "n4" -> "n6" [dir=back, arrowtail=odiamond];
  "n4" -> "n7" [dir=back, arrowtail=odiamond];
  "n8" -> "n9" [dir=back, arrowtail=odiamond];
  "n8" -> "n10" [dir=back, arrowtail=odiamond];
  "n8" -> "n11" [dir=back, arrowtail=odiamond];
  "n12" -> "n13" [dir=back, arrowtail=odiamond];
