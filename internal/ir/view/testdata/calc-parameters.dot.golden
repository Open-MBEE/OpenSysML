// view: ParameterCalcViews::calculations
// kind: tree
// stated: render asTreeDiagram
// layout: dot
digraph "ParameterCalcViews::calculations" {
  graph [fontname="Helvetica"];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  subgraph "cluster_frame" {
    label=<<font point-size="10"><i>«view»</i></font> <b>ParameterCalcViews::calculations</b>>;
    labeljust=l;
    labelloc=t;
    penwidth=0.5;
    margin=8;
    "n0" [shape=plain, style=solid, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td width="6"></td><td port="n0.0" border="1" style="rounded" fixedsize="true" width="10" height="10" bgcolor="white"><font point-size="7">↓</font></td><td align="left"><font point-size="8">x</font></td><td width="6"></td><td port="n0.1" border="1" style="rounded" fixedsize="true" width="10" height="10" bgcolor="white"><font point-size="7">↓</font></td><td align="left"><font point-size="8">y</font></td><td width="6"></td></tr><tr><td colspan="7"><table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="white" style="rounded"><tr><td><font point-size="10"><i>«calc»</i></font><br/><b>add</b></td></tr></table></td></tr><tr><td width="6"></td><td port="n0.2" border="1" style="rounded" fixedsize="true" width="10" height="10" bgcolor="white"><font point-size="7">↓</font></td><td align="left"><font point-size="8">result</font></td><td width="6"></td><td width="6"></td><td width="6"></td><td width="6"></td></tr></table>>];
    "n1" [label=<<font point-size="10"><i>«part def»</i></font><br/><b>Sensor</b>>];
    "n2" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>a</b>>];
    "n3" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>b</b>>];
    "n4" [style="rounded,filled", label=<<font point-size="10"><i>«attribute»</i></font><br/><b>gain</b>>];
    "n5" [shape=plain, style=solid, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td width="6"></td><td port="n5.0" border="1" style="rounded" fixedsize="true" width="10" height="10" bgcolor="white"><font point-size="7">↓</font></td><td align="left"><font point-size="8">x</font></td><td width="6"></td><td port="n5.1" border="1" style="rounded" fixedsize="true" width="10" height="10" bgcolor="white"><font point-size="7">↓</font></td><td align="left"><font point-size="8">^y</font></td><td width="6"></td></tr><tr><td colspan="7"><table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="white" style="rounded"><tr><td><font point-size="10"><i>«calc»</i></font><br/><b>sum</b></td></tr></table></td></tr><tr><td width="6"></td><td port="n5.2" border="1" style="rounded" fixedsize="true" width="10" height="10" bgcolor="white"><font point-size="7">↓</font></td><td align="left"><font point-size="8">^result</font></td><td width="6"></td><td width="6"></td><td width="6"></td><td width="6"></td></tr></table>>];
  "n1" -> "n5" [arrowhead=none];
    "n6" [shape=plain, style=solid, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td width="6"></td><td port="n6.0" border="1" style="rounded" fixedsize="true" width="10" height="10" bgcolor="white"><font point-size="7">↓</font></td><td align="left"><font point-size="8">^x</font></td><td width="6"></td><td port="n6.1" border="1" style="rounded" fixedsize="true" width="10" height="10" bgcolor="white"><font point-size="7">↓</font></td><td align="left"><font point-size="8">factor</font></td><td width="6"></td><td port="n6.2" border="1" style="rounded" fixedsize="true" width="10" height="10" bgcolor="white"><font point-size="7">↕</font></td><td align="left"><font point-size="8">^count</font></td><td width="6"></td></tr><tr><td colspan="10"><table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="white" style="rounded"><tr><td><font point-size="10"><i>«calc»</i></font><br/><b>scaled</b></td></tr></table></td></tr><tr><td width="6"></td><td port="n6.3" border="1" style="rounded" fixedsize="true" width="10" height="10" bgcolor="white"><font point-size="7">↓</font></td><td align="left"><font point-size="8">^doubled</font></td><td width="6"></td><td port="n6.4" border="1" style="rounded" fixedsize="true" width="10" height="10" bgcolor="white"><font point-size="7">↓</font></td><td align="left"><font point-size="8">^r</font></td><td width="6"></td><td width="6"></td><td width="6"></td><td width="6"></td></tr></table>>];
  "n1" -> "n6" [arrowhead=none];
    { rank=min; "frame_tr" [shape=none, margin=0, label=<<font point-size="10">expose ParameterCalcs::add<br/>expose ParameterCalcs::Sensor</font>>]; }
  }
  "n1" -> "n2" [dir=back, arrowtail=odiamond];
  "n1" -> "n3" [dir=back, arrowtail=odiamond];
  "n1" -> "n4" [dir=back, arrowtail=odiamond];
}
