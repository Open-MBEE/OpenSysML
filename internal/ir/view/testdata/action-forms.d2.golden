# ActionFormViews::monitorView — action rendering (render asInterconnectionDiagram, view def ActionFlowView)
classes: {
  definition: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14 } }
  usage: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; border-radius: 8 } }
  initial: { shape: oval; width: 18; height: 18; style: { fill: black; stroke: black } }
  terminate: { shape: oval; width: 22; height: 22; style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; bold: true } }
  succession: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 1; stroke-dash: 3 } }
}
n0: "«action def»\nMonitor\nparameters\nin sensor\nout alarm" {
  class: definition
  n1: "" { class: initial }
  n2: "«accept action»\nacceptReading\nreading : Reading\nparameters\nout reading\ninout ^payload\nin ^receiver" { class: usage }
  n3: "«send action»\nsendAlarm\nAlarm to sensor\nparameters\nin ^payload\nin ^sender\nin ^receiver" { class: usage }
  n4: "«assign»\ntally\ncount := count + 1" { class: usage }
  n5: "«loop»\nwait\nwhile condition\ncount < 10" {
    class: usage
    n6: "loop body" {
      class: usage
      n7: "«action»\npoll" { class: usage }
      n8: "«action»\nrecord" { class: usage }
    }
  }
  n9: "«loop»\nsweep\nfor iterator\ni in 1..3" {
    class: usage
    n10: "loop body" {
      class: usage
      n11: "«action»\n'step'" { class: usage }
    }
  }
  n12: "«if»\nchoose\nif condition\ncount > 5" {
    class: usage
    n13: "then body" {
      class: usage
      n14: "«action»\nraise" { class: usage }
    }
    n15: "else body" {
      class: usage
      n16: "«action»\nlower" { class: usage }
    }
  }
  n17: "✕" { class: terminate }
}
n0.n5.n6.n7 -> n0.n5.n6.n8: { class: succession }
n0.n1 -> n0.n2: { class: succession }
n0.n2 -> n0.n4: { class: succession }
n0.n3 -> n0.n5: { class: succession }
n0.n4 -> n0.n3: { class: succession }
n0.n5 -> n0.n9: { class: succession }
n0.n9 -> n0.n12: { class: succession }
n0.n12 -> n0.n17: { class: succession }
