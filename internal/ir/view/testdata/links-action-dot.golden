// view: FlowViews::driveView
// kind: action
// stated: render asInterconnectionDiagram, view def ActionFlowView
// layout: dot
digraph "FlowViews::driveView" {
  graph [fontname="Helvetica", compound=true];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  subgraph "cluster_n0" {
    label=<<font point-size="10"><i>«action def»</i></font><br/><b>Drive</b>>;
    color=black;
    penwidth=0.5;
    URL="https://example.test/src/action.sysml#L11";
    tooltip="Flows::Drive";
    "n0" [shape=point, style=invis, width=0, height=0, label=""];
    "n1" [shape=circle, fillcolor=black, label="", width=0.2, URL="https://example.test/src/action.sysml#L14", tooltip="Flows::Drive::start"];
    "n2" [style="rounded,filled", label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td port="n2.0" border="1" fixedsize="true" width="10" height="10"></td><td align="left"><font point-size="8">fuel</font></td></tr><tr><td colspan="2"><font point-size="10"><i>«action»</i></font><br/><b>provide : Provide</b></td></tr><tr><td port="n2.1" border="1" fixedsize="true" width="10" height="10"></td><td align="left"><font point-size="8">torque</font></td></tr></table>>, URL="https://example.test/src/action.sysml#L16", tooltip="Flows::Drive::provide"];
    subgraph "cluster_n3" {
      label=<<font point-size="10"><i>«action»</i></font><br/><b>monitor</b><br/>own flow>;
      color=black;
      penwidth=0.5;
      URL="https://example.test/src/action.sysml#L20";
      tooltip="Flows::Drive::monitor";
      "n3" [shape=point, style=invis, width=0, height=0, label=""];
      "n3.0" [shape=box, label="", xlabel="reading", fontsize=8, width=0.16666666666666666, height=0.16666666666666666, fixedsize=true];
      "n4" [shape=circle, fillcolor=black, label="", width=0.2, URL="https://example.test/src/action.sysml#L22", tooltip="Flows::Drive::monitor::begin"];
      "n5" [style="rounded,filled", label=<<font point-size="10"><i>«action»</i></font><br/><b>record</b>>, URL="https://example.test/src/action.sysml#L23", tooltip="Flows::Drive::monitor::record"];
    }
    "n6" [style="rounded,filled", label=<<font point-size="10"><i>«action»</i></font><br/><b>tally</b>>, URL="https://example.test/src/action.sysml#L29", tooltip="Flows::Drive::tally"];
    "n7" [label=<<font point-size="10"><i>«fork»</i></font><br/><b>split</b>>, URL="https://example.test/src/action.sysml#L33", tooltip="Flows::Drive::split"];
    "n8" [label=<<font point-size="10"><i>«join»</i></font><br/><b>sync</b>>, URL="https://example.test/src/action.sysml#L34", tooltip="Flows::Drive::sync"];
    "n9" [shape=doublecircle, fillcolor=black, label="", width=0.2, URL="https://example.test/src/action.sysml#L35", tooltip="action.sysml:35:3"];
    "n10" [style="rounded,filled", label=<<font point-size="10"><i>«action»</i></font><br/><b>park</b>>, URL="https://example.test/src/action.sysml#L36", tooltip="Flows::Drive::park"];
    "n11" [label=<<font point-size="10"><i>«decision»</i></font><br/><b>check</b>>, URL="https://example.test/src/action.sysml#L46", tooltip="Flows::Drive::check"];
  }
  "n4" -> "n5" [URL="https://example.test/src/action.sysml#L24", tooltip="action.sysml:24:4"];
  "n1" -> "n7" [URL="https://example.test/src/action.sysml#L38", tooltip="action.sysml:38:3"];
  "n2" -> "n8" [URL="https://example.test/src/action.sysml#L41", tooltip="action.sysml:41:3"];
  "n2":"n2.1" -> "n3.0" [style=dashed, URL="https://example.test/src/action.sysml#L52", tooltip="action.sysml:52:3"];
  "n3" -> "n8" [URL="https://example.test/src/action.sysml#L42", tooltip="action.sysml:42:3", ltail="cluster_n3"];
  "n6" -> "n8" [URL="https://example.test/src/action.sysml#L44", tooltip="action.sysml:44:3"];
  "n7" -> "n2" [URL="https://example.test/src/action.sysml#L39", tooltip="action.sysml:39:3"];
  "n7" -> "n3" [URL="https://example.test/src/action.sysml#L40", tooltip="action.sysml:40:3", lhead="cluster_n3"];
