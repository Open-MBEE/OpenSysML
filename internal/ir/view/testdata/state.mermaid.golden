%% MachineViews::vehicleStates — state rendering (view def StateTransitionView)
stateDiagram-v2
  state "«state def»<br>VehicleStates" as n0 {
    state "«state»<br>off<br>initial" as n1
    state "«state»<br>operating" as n2 {
      state "«state»<br>idle<br>initial" as n3
      state "«state»<br>moving" as n4
      [*] --> n3
    }
    [*] --> n1
  }
  n1 --> n2
  n2 --> n1
  n3 --> n4 : accept Signal [temperature #gt; 0]
  n4 --> n3
