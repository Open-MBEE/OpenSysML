// view: LaneShapes::assembleView
// kind: action
// stated: view def ActionFlowView
// layout: dot
digraph "LaneShapes::assembleView" {
  graph [fontname="Helvetica", compound=true];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  subgraph "cluster_frame" {
    label=<<font point-size="10"><i>«view»</i></font> <b>LaneShapes::assembleView</b> : ActionFlowView>;
    labeljust=l;
    labelloc=t;
    penwidth=0.5;
    margin=8;
    subgraph "cluster_n0" {
      label=<<font point-size="10"><i>«action»</i></font><br/><b>assemble</b>>;
      color=black;
      penwidth=0.5;
      "n0" [shape=point, style=invis, width=0, height=0, label=""];
      "n1" [style="rounded,filled", label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td><font point-size="10"><i>«action»</i></font><br/><b>fetch</b></td></tr><hr/><tr><td><font point-size="10">performed by</font></td></tr><tr><td align="left">loader<br/>bench</td></tr></table>>];
      subgraph "cluster_n2" {
        label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td><font point-size="10"><i>«action»</i></font><br/><b>build</b></td></tr><hr/><tr><td><font point-size="10">action flow</font></td></tr></table>>;
        color=black;
        penwidth=0.5;
        "n2" [shape=point, style=invis, width=0, height=0, label=""];
        subgraph "cluster_n5" {
          label=<<font point-size="10"><i>«performer»</i></font><br/><b>Robot</b><br/>perform actions>;
          style=dashed;
          color=black;
          penwidth=0.5;
          "n5" [shape=point, style=invis, width=0, height=0, label=""];
          "n3" [style="rounded,filled", label=<<font point-size="10"><i>«action»</i></font><br/><b>cut</b>>];
          "n4" [style="rounded,filled", label=<<font point-size="10"><i>«action»</i></font><br/><b>weld</b>>];
        }
      }
      subgraph "cluster_n11" {
        label=<<font point-size="10"><i>«performer»</i></font><br/><b>supervise</b><br/>perform actions>;
        style=dashed;
        color=black;
        penwidth=0.5;
        "n11" [shape=point, style=invis, width=0, height=0, label=""];
        "n6" [style="rounded,filled", label=<<font point-size="10"><i>«action»</i></font><br/><b>inspect</b>>];
      }
      subgraph "cluster_n12" {
        label=<<font point-size="10"><i>«performer»</i></font><br/><b>: Robot</b><br/>perform actions>;
        style=dashed;
        color=black;
        penwidth=0.5;
        "n12" [shape=point, style=invis, width=0, height=0, label=""];
        "n7" [style="rounded,filled", label=<<font point-size="10"><i>«action»</i></font><br/><b>pack</b>>];
      }
      "n8" [shape=circle, fillcolor=black, label="", width=0.2];
    }
    { rank=min; "frame_tr" [shape=none, margin=0, label=<<font point-size="10">expose assemble</font>>]; }
  }
  "n3" -> "n4" [style=dashed, arrowhead=vee];
  "n1" -> "n2" [style=dashed, arrowhead=vee, lhead="cluster_n2"];
  "n2" -> "n6" [style=dashed, arrowhead=vee, ltail="cluster_n2"];
  "n6" -> "n7" [style=dashed, arrowhead=vee];
  "n8" -> "n1" [style=dashed, arrowhead=vee];
}
