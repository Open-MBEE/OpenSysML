// view: MachineViews::vehicleStates
// kind: state
// stated: view def StateTransitionView
// layout: dot
digraph "MachineViews::vehicleStates" {
  graph [fontname="Arial", fontcolor="#424242", compound=true];
  node [shape=box, style=filled, fillcolor="#FFCC99:#FFFAD4", gradientangle=0, color="#99795C", fontname="Arial", fontsize=11, fontcolor="#424242", penwidth=1];
  edge [color="#424242", fontname="Arial", fontsize=9, fontcolor="#424242", penwidth=1, arrowhead=open];
  subgraph "cluster_frame" {
    label=<<b>stm</b> [State Machine] VehicleStates [ vehicleStates ]>;
    labeljust=l;
    labelloc=t;
    fontsize=11;
    color="#5B5B59";
    penwidth=1;
    margin=8;
    subgraph "cluster_n0" {
      label=<<font point-size="9">«state def»</font><br/><b>VehicleStates</b>>;
      style="rounded,filled";
      fillcolor="#FFFFCC:#FFFFF2";
      gradientangle=0;
      color="#5B5B59";
      penwidth=1;
      "n0" [shape=point, style=invis, width=0, height=0, label=""];
      "n5" [shape=point, fillcolor=black, label=""];
      "n1" [style="rounded,filled", fillcolor="#FFFFCC:#FFFFF2", color="#5B5B59", label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td><b>off</b></td></tr><hr/><tr><td align="left">initial</td></tr></table>>];
      subgraph "cluster_n2" {
        label=<<b>operating</b>>;
        style="rounded,filled";
        fillcolor="#FFFFCC:#FFFFF2";
        gradientangle=0;
        color="#5B5B59";
        penwidth=1;
        "n2" [shape=point, style=invis, width=0, height=0, label=""];
        "n6" [shape=point, fillcolor=black, label=""];
        "n3" [style="rounded,filled", fillcolor="#FFFFCC:#FFFFF2", color="#5B5B59", label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="2"><tr><td><b>idle</b></td></tr><hr/><tr><td align="left">initial</td></tr></table>>];
        "n4" [style="rounded,filled", fillcolor="#FFFFCC:#FFFFF2", color="#5B5B59", label=<<b>moving</b>>];
      }
    }
  }
  "n5" -> "n1";
  "n6" -> "n3";
  "n1" -> "n2" [lhead="cluster_n2"];
  "n2" -> "n1" [ltail="cluster_n2"];
  "n3" -> "n4" [label="accept Signal [temperature > 0]"];
  "n4" -> "n3";
}
