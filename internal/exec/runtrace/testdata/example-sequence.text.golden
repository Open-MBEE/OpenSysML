  RunTimeline::mission.instrument => RunTimeline::mission.controller: t=3 Ack (seq = 1)
  RunTimeline::mission.controller => RunTimeline::mission.instrument: t=5 Ping (seq = 1)
  RunTimeline::mission.instrument => RunTimeline::mission.controller: t=5 Ack (seq = 1)
