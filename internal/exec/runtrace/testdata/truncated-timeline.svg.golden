<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="760" height="170" viewBox="0 0 760 170" font-family="Helvetica, Arial, sans-serif" font-size="12">
<title>timeline of a run to t = 4</title>
<desc>the trace of a run to t = 4</desc>
<rect width="760" height="170" fill="#ffffff"/>
<text x="16" y="28" font-weight="bold">timeline of a run to t = 4</text>
<text x="16" y="44" fill="#666666">not represented: 3 earlier records up to t = 2 were dropped; a lane starts at its first state entry kept</text>
<text x="16" y="60" fill="#666666">not represented: 1 state held for no time is listed in the text form</text>
<line x1="86" y1="122" x2="406" y2="122" stroke="#333333"/>
<line x1="86" y1="122" x2="86" y2="126" stroke="#333333"/>
<text x="86" y="140" text-anchor="middle" fill="#333333">t = 0</text>
<line x1="406" y1="122" x2="406" y2="126" stroke="#333333"/>
<text x="406" y="140" text-anchor="middle" fill="#333333">t = 4</text>
<g id="l0">
<rect x="86" y="84" width="320" height="28" fill="#f4f6f8"/>
<text x="16" y="103">#1.modes</text>
<g id="l0s0"><title>held&#xA;t = 4, held for no time (open at the end of the run)</title><line x1="406" y1="84" x2="406" y2="112" stroke="#c0392b" stroke-width="2"/></g>
</g>
<line id="cursor" x1="406" y1="79" x2="406" y2="122" stroke="#c0392b" stroke-width="1.5"></line>
</svg>
