---
config:
  fontFamily: "Helvetica, Arial, sans-serif"
  theme: base
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "14px"
    primaryColor: "#FFFFFF"
    secondaryColor: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
    background: "#FFFFFF"
    primaryBorderColor: "#181818"
    primaryTextColor: "#000000"
    lineColor: "#181818"
    textColor: "#000000"
    noteBkgColor: "#FEFFDD"
    noteBorderColor: "#181818"
    noteTextColor: "#000000"
    actorBkg: "#FFFFFF"
    actorBorder: "#181818"
    actorTextColor: "#000000"
    actorLineColor: "#181818"
    signalColor: "#181818"
    signalTextColor: "#000000"
    labelBoxBkgColor: "#FFFFFF"
    labelBoxBorderColor: "#181818"
    labelTextColor: "#000000"
    loopTextColor: "#000000"
    activationBorderColor: "#181818"
    activationBkgColor: "#FFFFFF"
    sequenceNumberColor: "#000000"
---
%% run — sequence rendering (the trace of a run to t = 6)
sequenceDiagram
  participant n0 as «object»<br>'mission.controller' : Controller
  participant n1 as «object»<br>'mission.instrument' : Instrument
  n0->>n1: t=1 Ping (seq = 1)
  n1->>n0: t=1 Ack (seq = 1)
  n0->>n1: t=3 Ping (seq = 1)
  n1->>n0: t=3 Ack (seq = 1)
  n0->>n1: t=5 Ping (seq = 1)
  n1->>n0: t=5 Ack (seq = 1)
