<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="563" height="138" viewBox="0 0 563 138" font-family="Helvetica, Arial, sans-serif" font-size="12">
<title>timeline of a run to t = 2 (animated)</title>
<desc>the trace of a run to t = 2</desc>
<rect width="563" height="138" fill="#ffffff"/>
<text x="16" y="28" font-weight="bold">timeline of a run to t = 2 (animated)</text>
<line x1="93" y1="90" x2="533" y2="90" stroke="#333333"/>
<line x1="93" y1="90" x2="93" y2="94" stroke="#333333"/>
<text x="93" y="108" text-anchor="middle" fill="#333333">t = 0</text>
<line x1="313" y1="90" x2="313" y2="94" stroke="#333333"/>
<text x="313" y="108" text-anchor="middle" fill="#333333">t = 1</text>
<line x1="533" y1="90" x2="533" y2="94" stroke="#333333"/>
<text x="533" y="108" text-anchor="middle" fill="#333333">t = 2</text>
<g id="l0">
<rect x="93" y="52" width="440" height="28" fill="#f4f6f8"/>
<text x="16" y="71">box.modes</text>
<g id="l0s0"><title>left.waiting | right.waiting&#xA;t = 0 to 1</title><rect x="93" y="55" width="220" height="22" rx="3" fill="#8fb6e0" stroke="#3b6ea5"><animate attributeName="fill-opacity" calcMode="discrete" values="1;0.25" keyTimes="0;0.3333" dur="3s" repeatCount="indefinite"/></rect><text x="203" y="71" text-anchor="middle">left.waiting | right.waiting</text></g>
<g id="l0s1"><title>done | waiting (time)&#xA;t = 1 to 2 (open at the end of the run)</title><rect x="313" y="55" width="220" height="22" rx="3" fill="#8fb6e0" stroke="#3b6ea5"><animate attributeName="fill-opacity" calcMode="discrete" values="0.25;1" keyTimes="0;0.3333" dur="3s" repeatCount="indefinite"/></rect><text x="423" y="71" text-anchor="middle">done | waiting (time)</text></g>
<g><title>choice: choice entering open: next left.waiting(entry), right.waiting(entry) (unordered; took left.waiting(entry) first; independent)&#xA;t = 0</title><path d="M93 61l5 5l-5 5l-5 -5z" fill="#f1c40f" stroke="#7d6608"/></g>
</g>
<line id="cursor" x1="533" y1="47" x2="533" y2="90" stroke="#c0392b" stroke-width="1.5"><animate attributeName="x1" values="93;533;533" keyTimes="0;0.6667;1" dur="3s" repeatCount="indefinite"/><animate attributeName="x2" values="93;533;533" keyTimes="0;0.6667;1" dur="3s" repeatCount="indefinite"/></line>
</svg>
