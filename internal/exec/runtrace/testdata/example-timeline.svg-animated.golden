<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="1519" height="192" viewBox="0 0 1519 192" font-family="Helvetica, Arial, sans-serif" font-size="12">
<title>timeline of a run to t = 6 (animated)</title>
<desc>the trace of a run to t = 6</desc>
