<text x="1289" y="162" text-anchor="middle" fill="#333333">t = 5</text>
<line x1="1489" y1="144" x2="1489" y2="148" stroke="#333333"/>
<text x="1489" y="162" text-anchor="middle" fill="#333333">t = 6</text>
<g id="l0">
<rect x="289" y="68" width="1200" height="28" fill="#f4f6f8"/>
<text x="16" y="87">RunTimeline::mission.controller.modes</text>
<g id="l0s0"><title>waiting | charged&#xA;t = 0 to 1</title><rect x="289" y="71" width="200" height="22" rx="3" fill="#8fb6e0" stroke="#3b6ea5"><animate attributeName="fill-opacity" calcMode="discrete" values="1;0.25" keyTimes="0;0.1481" dur="9s" repeatCount="indefinite"/></rect><text x="389" y="87" text-anchor="middle">waiting | charged</text></g>
<g id="l0s1"><title>acknowledged | charged (time, accept Ack)&#xA;t = 1 to 2</title><rect x="489" y="71" width="200" height="22" rx="3" fill="#8fb6e0" stroke="#3b6ea5"><animate attributeName="fill-opacity" calcMode="discrete" values="0.25;1;0.25" keyTimes="0;0.1481;0.2963" dur="9s" repeatCount="indefinite"/></rect><text x="589" y="87" text-anchor="middle">acknowledged | charged (t…</text></g>
<g><title>through sending&#xA;t = 1</title><line x1="489" y1="68" x2="489" y2="96" stroke="#c0392b" stroke-width="2"/><animate attributeName="opacity" calcMode="discrete" values="0;1" keyTimes="0;0.1481" dur="9s" repeatCount="indefinite"/></g>
<g id="l0s2"><title>waiting | charged (time)&#xA;t = 2 to 3</title><rect x="689" y="71" width="200" height="22" rx="3" fill="#8fb6e0" stroke="#3b6ea5"><animate attributeName="fill-opacity" calcMode="discrete" values="0.25;1;0.25" keyTimes="0;0.2963;0.4444" dur="9s" repeatCount="indefinite"/></rect><text x="789" y="87" text-anchor="middle">waiting | charged (time)</text></g>
