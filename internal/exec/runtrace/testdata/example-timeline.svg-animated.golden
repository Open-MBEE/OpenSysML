<text x="16" y="28" font-weight="bold">timeline of a run to t = 6 (animated)</text>
<text x="16" y="44" fill="#666666">not represented: 1 state held for no time is listed in the text form</text>
<line x1="289" y1="144" x2="1489" y2="144" stroke="#333333"/>
<line x1="289" y1="144" x2="289" y2="148" stroke="#333333"/>
<text x="289" y="162" text-anchor="middle" fill="#333333">t = 0</text>
<line x1="489" y1="144" x2="489" y2="148" stroke="#333333"/>
<text x="489" y="162" text-anchor="middle" fill="#333333">t = 1</text>
<line x1="689" y1="144" x2="689" y2="148" stroke="#333333"/>
<text x="689" y="162" text-anchor="middle" fill="#333333">t = 2</text>
