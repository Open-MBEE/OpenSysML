<g><title>through sending&#xA;t = 3</title><line x1="889" y1="68" x2="889" y2="96" stroke="#c0392b" stroke-width="2"/><animate attributeName="opacity" calcMode="discrete" values="0;1" keyTimes="0;0.4444" dur="9s" repeatCount="indefinite"/></g>
<g id="l0s4"><title>waiting | charged (time)&#xA;t = 4 to 5</title><rect x="1089" y="71" width="200" height="22" rx="3" fill="#8fb6e0" stroke="#3b6ea5"><animate attributeName="fill-opacity" calcMode="discrete" values="0.25;1;0.25" keyTimes="0;0.5926;0.7407" dur="9s" repeatCount="indefinite"/></rect><text x="1189" y="87" text-anchor="middle">waiting | charged (time)</text></g>
