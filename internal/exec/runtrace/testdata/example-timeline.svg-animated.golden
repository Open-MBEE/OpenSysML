<text x="1089" y="162" text-anchor="middle" fill="#333333">t = 4</text>
<line x1="1189" y1="144" x2="1189" y2="148" stroke="#333333"/>
<text x="1189" y="162" text-anchor="middle" fill="#333333">t = 4.5</text>
