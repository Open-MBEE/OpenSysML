<g id="l1s4"><title>waiting (time)&#xA;t = 4.5 to 5</title><rect x="1189" y="109" width="100" height="22" rx="3" fill="#8fb6e0" stroke="#3b6ea5"><animate attributeName="fill-opacity" calcMode="discrete" values="0.25;1;0.25" keyTimes="0;0.6667;0.7407" dur="9s" repeatCount="indefinite"/></rect><text x="1239" y="125" text-anchor="middle">waiting (ti…</text></g>
<g id="l1s5"><title>acknowledged (accept Ping)&#xA;t = 5 to 6 (open at the end of the run)</title><rect x="1289" y="109" width="200" height="22" rx="3" fill="#8fb6e0" stroke="#3b6ea5"><animate attributeName="fill-opacity" calcMode="discrete" values="0.25;1" keyTimes="0;0.7407" dur="9s" repeatCount="indefinite"/></rect><text x="1389" y="125" text-anchor="middle">acknowledged (accept Ping)</text></g>
