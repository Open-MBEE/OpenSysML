  eval feature x -> 0
  eval literal 1 -> 1
eval operator == -> false
exit: idle
stmt action body
  stmt assign log
      eval feature log -> ""
      eval literal "go(effect);" -> "go(effect);"
    eval operator + -> "go(effect);"
enter: work (entry action)
