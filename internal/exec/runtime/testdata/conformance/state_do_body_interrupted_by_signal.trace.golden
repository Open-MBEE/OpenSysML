choice at t=0.0: next do busy, dispatch accept Stop (unordered; took do busy first; order-dependent: log)
do: busy
stmt action body
enter action node: state behavior work
  stmt assign log
      eval feature log -> ""
      eval literal "s1 " -> "s1 "
    eval operator + -> "s1 "
exit: busy (exit action)
