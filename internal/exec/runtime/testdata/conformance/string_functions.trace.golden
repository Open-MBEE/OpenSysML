enter calc test::firstTwo
  bind text = "héllo" [argument]
  stmt return
      eval feature text -> "héllo"
      eval literal 1 -> 1
        eval literal "hé" -> "hé"
        enter calc StringFunctions::Length
          bind x = "hé" [argument]
        exit calc StringFunctions::Length -> 2
      eval invoke Length -> 2
      enter calc StringFunctions::Substring
        bind x = "héllo" [argument]
        bind lower = 1 [argument]
        bind upper = 2 [argument]
      exit calc StringFunctions::Substring -> "hé"
    eval invoke Substring -> "hé"
exit calc test::firstTwo -> "hé"
