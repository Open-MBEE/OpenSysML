exit: idle (exit action)
stmt action body
  stmt assign log
      eval feature log -> ""
      eval literal "idle(exit);" -> "idle(exit);"
    eval operator + -> "idle(exit);"
stmt action body
  stmt assign x
    eval literal 2 -> 2
  stmt assign log
      eval feature log -> "idle(exit);"
      eval literal "check;" -> "check;"
    eval operator + -> "idle(exit);check;"
  eval feature x -> 2
  eval literal 1 -> 1
eval operator > -> true
stmt action body
  stmt assign log
      eval feature log -> "idle(exit);check;"
      eval literal "bad;" -> "bad;"
    eval operator + -> "idle(exit);check;bad;"
transition: idle -> stop (event: accept Check)
terminate: stop
