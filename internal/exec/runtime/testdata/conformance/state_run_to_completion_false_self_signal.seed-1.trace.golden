exit: start
enter: working (entry action)
stmt action body
  stmt send
transition: start -> working
choice entry at t=0.0: next dispatch accept Ping, working(entry) (unordered; took working(entry) first)
enter: step (entry action)
stmt action body
  stmt assign hits
      eval feature hits -> 0
      eval literal 1 -> 1
    eval operator + -> 1
exit: step
exit: working
enter: done
transition: step -> done (event: accept Ping)
