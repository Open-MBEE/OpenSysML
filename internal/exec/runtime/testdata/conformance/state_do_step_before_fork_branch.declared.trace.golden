exit: idle
choice fork split: next split->a(effect), split->b(effect) (unordered; took split->a(effect) first)
enter: work
enter: a
stmt action body
  stmt assign log
      eval feature log -> ""
      eval literal "T1.2(effect) " -> "T1.2(effect) "
    eval operator + -> "T1.2(effect) "
enter: b (entry action)
stmt action body
  stmt assign log
      eval feature log -> "T1.2(effect) "
      eval literal "b(entry) " -> "b(entry) "
    eval operator + -> "T1.2(effect) b(entry) "
transition: idle -> split
do: a
stmt action body
  stmt assign log
      eval feature log -> "T1.2(effect) b(entry) "
      eval literal "did " -> "did "
    eval operator + -> "T1.2(effect) b(entry) did "
