{
    "type": "state",
    "libraries": true,
    "schedule": "reverse",
    "events": [
        {"signal": "Ping"},
        {"signal": "Leave"}
    ],
    "finalState": "done",
    "stateVisits": ["start", "outer", "a1", "b1", "waited", "done"],
    "outputs": {
        "worked": {"type": "Integer", "value": 1}
    }
}
