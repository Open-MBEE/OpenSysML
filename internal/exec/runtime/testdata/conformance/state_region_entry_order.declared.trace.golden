exit: idle
enter: work
choice entering work: next left(entry), right(entry) (unordered; took left(entry) first; order-dependent: log)
stmt action body
  stmt assign log
      eval feature log -> ""
      eval literal "left(entry) " -> "left(entry) "
    eval operator + -> "left(entry) "
choice entering work: next l(entry), right(entry) (unordered; took l(entry) first; order-dependent: log)
enter: l (entry action)
stmt action body
  stmt assign log
      eval feature log -> "left(entry) "
      eval literal "l(entry) " -> "l(entry) "
    eval operator + -> "left(entry) l(entry) "
stmt action body
  stmt assign log
      eval feature log -> "left(entry) l(entry) "
      eval literal "right(entry) " -> "right(entry) "
    eval operator + -> "left(entry) l(entry) right(entry) "
enter: r (entry action)
stmt action body
  stmt assign log
      eval feature log -> "left(entry) l(entry) right(entry) "
      eval literal "r(entry) " -> "r(entry) "
    eval operator + -> "left(entry) l(entry) right(entry) r(entry) "
transition: idle -> work (event: accept Go)
