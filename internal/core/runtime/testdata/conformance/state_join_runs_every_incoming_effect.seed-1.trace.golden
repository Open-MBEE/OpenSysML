exit: start
enter: Outer
enter: Work
enter: l1
enter: r1
transition: start -> Work (event: accept go)
choice join sync: states l1, r1 react (unordered; took r1 first)
exit: r1
stmt assign log
    eval feature log -> ""
    eval literal "right(effect) " -> "right(effect) "
  eval operator + -> "right(effect) "
exit: l1
stmt assign log
    eval feature log -> "right(effect) "
    eval literal "left(effect) " -> "left(effect) "
  eval operator + -> "right(effect) left(effect) "
exit: Work
exit: Outer (exit action)
stmt assign log
    eval feature log -> "right(effect) left(effect) "
    eval literal "outer(exit) " -> "outer(exit) "
  eval operator + -> "right(effect) left(effect) outer(exit) "
stmt assign log
    eval feature log -> "right(effect) left(effect) outer(exit) "
    eval literal "sync(effect) " -> "sync(effect) "
  eval operator + -> "right(effect) left(effect) outer(exit) sync(effect) "
enter: Rest (entry action)
stmt assign log
    eval feature log -> "right(effect) left(effect) outer(exit) sync(effect) "
    eval literal "rest(entry)" -> "rest(entry)"
  eval operator + -> "right(effect) left(effect) outer(exit) sync(effect) rest(entry)"
transition: Work -> Rest
exit: Rest
enter: done
transition: Rest -> done
