exit: idle
choice fork split: next split->a(effect), split->b(effect) (unordered; took split->a(effect) first)
stmt assign log
    eval feature log -> ""
    eval literal "T1.1(effect) " -> "T1.1(effect) "
  eval operator + -> "T1.1(effect) "
choice fork split: next work(entry), split->b(effect) (unordered; took work(entry) first)
enter: work (entry action)
stmt assign log
    eval feature log -> "T1.1(effect) "
    eval literal "work(entry) " -> "work(entry) "
  eval operator + -> "T1.1(effect) work(entry) "
choice fork split: next a(entry), split->b(effect) (unordered; took a(entry) first)
enter: a
stmt assign log
    eval feature log -> "T1.1(effect) work(entry) "
    eval literal "T1.2(effect) " -> "T1.2(effect) "
  eval operator + -> "T1.1(effect) work(entry) T1.2(effect) "
enter: b
transition: idle -> split
