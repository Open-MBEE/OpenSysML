exit: lstart (exit action)
stmt action body
  stmt assign log
      eval feature log -> ""
      eval literal "l;" -> "l;"
    eval operator + -> "l;"
enter: done
transition: lstart -> done (event: accept First)
exit: rstart (exit action)
stmt action body
  stmt assign log
      eval feature log -> "l;"
      eval literal "r;" -> "r;"
    eval operator + -> "l;r;"
enter: done
transition: rstart -> done (event: accept Second)
exit: done
exit: done
exit: busy (exit action)
stmt action body
  stmt assign log
      eval feature log -> "l;r;"
      eval literal "busy;" -> "busy;"
    eval operator + -> "l;r;busy;"
enter: idle
transition: busy -> idle (event: accept Reset)
