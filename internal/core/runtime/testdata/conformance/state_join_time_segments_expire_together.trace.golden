choice events at t=1.0: time a1 1->sync, time b1 1->sync (unordered; dispatched time a1 1->sync first)
choice join sync: states a1, b1 react (unordered; took a1 first)
exit: a1
stmt assign log
    eval feature log -> ""
    eval literal "a " -> "a "
  eval operator + -> "a "
exit: b1
stmt assign log
    eval feature log -> "a "
    eval literal "b " -> "b "
  eval operator + -> "a b "
exit: Work
stmt assign log
    eval feature log -> "a b "
    eval literal "sync" -> "sync"
  eval operator + -> "a b sync"
enter: done
transition: Work -> done (event: time)
