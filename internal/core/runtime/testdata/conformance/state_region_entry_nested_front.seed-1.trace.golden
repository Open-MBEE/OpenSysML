exit: idle
enter: work
choice entering work: next inner(entry), right(entry) (unordered; took right(entry) first)
stmt assign log
    eval feature log -> ""
    eval literal "right(entry) " -> "right(entry) "
  eval operator + -> "right(entry) "
choice entering work: next inner(entry), r(entry) (unordered; took inner(entry) first)
enter: inner
choice entering work: next p(entry), q(entry), r(entry) (unordered; took r(entry) first)
enter: r
choice entering work: next p(entry), q(entry) (unordered; took p(entry) first)
stmt assign log
    eval feature log -> "right(entry) "
    eval literal "p(entry) " -> "p(entry) "
  eval operator + -> "right(entry) p(entry) "
choice entering work: next p1(entry), q(entry) (unordered; took p1(entry) first)
enter: p1
stmt assign log
    eval feature log -> "right(entry) p(entry) "
    eval literal "q(entry) " -> "q(entry) "
  eval operator + -> "right(entry) p(entry) q(entry) "
enter: q1
transition: idle -> work (event: accept Go)
