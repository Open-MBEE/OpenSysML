exit: inner (exit action)
stmt action body
  stmt assign log
      eval feature log -> ""
      eval literal "inner;" -> "inner;"
    eval operator + -> "inner;"
enter: done
transition: inner -> done (event: accept Go)
exit: done
exit: outer (exit action)
stmt action body
  stmt assign log
      eval feature log -> "inner;"
      eval literal "outer;" -> "outer;"
    eval operator + -> "inner;outer;"
enter: next (entry action)
stmt action body
  stmt assign log
      eval feature log -> "inner;outer;"
      eval literal "next;" -> "next;"
    eval operator + -> "inner;outer;next;"
transition: done -> next
