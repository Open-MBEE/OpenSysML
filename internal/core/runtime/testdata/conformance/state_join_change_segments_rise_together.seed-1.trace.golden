exit: start
stmt assign level
  eval literal 3 -> 3
enter: Work
choice entering Work: next a1(entry), b1(entry) (unordered; took b1(entry) first)
enter: b1
enter: a1
transition: start -> Work
  eval feature level -> 3
  eval literal 1 -> 1
eval operator > -> true
  eval feature level -> 3
  eval literal 2 -> 2
eval operator > -> true
choice on change: states a1, b1 react (unordered; took a1 first)
choice join sync: states a1, b1 react (unordered; took a1 first)
exit: a1
stmt assign log
    eval feature log -> ""
    eval literal "a " -> "a "
  eval operator + -> "a "
exit: b1
stmt assign log
    eval feature log -> "a "
    eval literal "b " -> "b "
  eval operator + -> "a b "
exit: Work
stmt assign log
    eval feature log -> "a b "
    eval literal "sync" -> "sync"
  eval operator + -> "a b sync"
enter: done
transition: Work -> done (event: change)
