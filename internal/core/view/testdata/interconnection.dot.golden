// view: PlantViews::loopView
// kind: interconnection
// stated: render asInterconnectionDiagram
// layout: dot
digraph "PlantViews::loopView" {
  node [shape=box];
  subgraph "cluster_n0" {
    label=<<b>Plant::Loop</b><br/><font point-size="10">«part def»</font>>;
    "n0" [shape=point, style=invis, width=0, height=0, label=""];
    "n1" [label=<<b>pump : Pump</b><br/><font point-size="10">«part»</font>>];
    "n2" [label=<<b>tank : Tank</b><br/><font point-size="10">«part»</font>>];
    "n3" [label=<<b>sensor : Pump</b><br/><font point-size="10">«part»</font>>];
  }
  "n1" -> "n2" [label="supply", arrowhead=none];
  "n1" -> "n2" [label="of Water", style=dashed];
}
