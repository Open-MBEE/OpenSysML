// view: MachineViews::vehicleStates
// kind: state
// stated: view def StateTransitionView
// layout: dot
digraph "MachineViews::vehicleStates" {
  graph [compound=true];
  node [shape=box];
  subgraph "cluster_n0" {
    label="state def Machines::VehicleStates";
    "n5" [shape=point, label=""];
    "n1" [shape=box, style=rounded, label="state off\ninitial"];
    subgraph "cluster_n2" {
      label="state operating";
      "n6" [shape=point, label=""];
      "n3" [shape=box, style=rounded, label="state idle\ninitial"];
      "n4" [shape=box, style=rounded, label="state moving"];
    }
  }
  "n5" -> "n1";
  "n6" -> "n3";
  "n1" -> "n6" [lhead="cluster_n2"];
  "n6" -> "n1" [ltail="cluster_n2"];
  "n3" -> "n4" [label="idle_to_moving: accept Signal [temperature > 0]"];
  "n4" -> "n3";
}
