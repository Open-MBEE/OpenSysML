// view: MachineViews::vehicleStates
// kind: state
// stated: view def StateTransitionView
// layout: dot
digraph "MachineViews::vehicleStates" {
  graph [compound=true];
  node [shape=box];
  subgraph "cluster_n0" {
    label=<<b>Machines::VehicleStates</b><br/><font point-size="10">«state def»</font>>;
    "n0" [shape=point, style=invis, width=0, height=0, label=""];
    "n5" [shape=point, label=""];
    "n1" [shape=box, style=rounded, label=<<b>off</b><br/><font point-size="10">«state»</font><br/>initial>];
    subgraph "cluster_n2" {
      label=<<b>operating</b><br/><font point-size="10">«state»</font>>;
      "n2" [shape=point, style=invis, width=0, height=0, label=""];
      "n6" [shape=point, label=""];
      "n3" [shape=box, style=rounded, label=<<b>idle</b><br/><font point-size="10">«state»</font><br/>initial>];
      "n4" [shape=box, style=rounded, label=<<b>moving</b><br/><font point-size="10">«state»</font>>];
    }
  }
  "n5" -> "n1";
  "n6" -> "n3";
  "n1" -> "n2" [lhead="cluster_n2"];
  "n2" -> "n1" [ltail="cluster_n2"];
  "n3" -> "n4" [label="idle_to_moving: accept Signal [temperature > 0]"];
  "n4" -> "n3";
}
