%% FlowViews::driveView — action rendering (render asInterconnectionDiagram, view def ActionFlowView)
flowchart TD
  subgraph n0 ["Flows::Drive<br>«action def»"]
    n1["start<br>«initial»"]
    n2["provide : Provide<br>«action»"]
    subgraph n3 ["monitor<br>«action»<br>own flow"]
      n5["begin<br>«initial»"]
      n6["record<br>«action»"]
    end
    n7["tally<br>«action»"]
    n8["split<br>«fork»"]
    n9["sync<br>«join»"]
    n10["done<br>«final»"]
    n11["park<br>«action»"]
    n12["check<br>«decision»"]
  end
  n5 --> n6
  n1 --> n8
  n2 --> n9
  n2 -.->|"torque to reading"| n3
  n3 --> n9
  n7 --> n9
  n8 --> n2
  n8 --> n3
  n8 --> n7
  n9 --> n12
  n11 --> n10
  n12 -->|"[speed #gt; 0]"| n10
  n12 --> n11
