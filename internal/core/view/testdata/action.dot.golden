// view: FlowViews::driveView
// kind: action
// stated: render asInterconnectionDiagram, view def ActionFlowView
// layout: dot
digraph "FlowViews::driveView" {
  graph [fontname="Helvetica", compound=true];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  subgraph "cluster_n0" {
    label=<<b>Flows::Drive</b><br/><font point-size="10"><i>«action def»</i></font>>;
    color=black;
    penwidth=0.5;
    "n0" [shape=point, style=invis, width=0, height=0, label=""];
    "n1" [shape=circle, label=<<b>start</b><br/><font point-size="10"><i>«initial»</i></font>>];
    "n2" [style="rounded,filled", label=<<b>provide : Provide</b><br/><font point-size="10"><i>«action»</i></font>>];
    subgraph "cluster_n3" {
      label=<<b>monitor</b><br/><font point-size="10"><i>«action»</i></font><br/>own flow>;
      color=black;
      penwidth=0.5;
      "n3" [shape=point, style=invis, width=0, height=0, label=""];
      "n5" [shape=circle, label=<<b>begin</b><br/><font point-size="10"><i>«initial»</i></font>>];
      "n6" [style="rounded,filled", label=<<b>record</b><br/><font point-size="10"><i>«action»</i></font>>];
    }
    "n7" [style="rounded,filled", label=<<b>tally</b><br/><font point-size="10"><i>«action»</i></font>>];
    "n8" [label=<<b>split</b><br/><font point-size="10"><i>«fork»</i></font>>];
    "n9" [label=<<b>sync</b><br/><font point-size="10"><i>«join»</i></font>>];
    "n10" [shape=doublecircle, label=<<b>done</b><br/><font point-size="10"><i>«final»</i></font>>];
    "n11" [style="rounded,filled", label=<<b>park</b><br/><font point-size="10"><i>«action»</i></font>>];
    "n12" [label=<<b>check</b><br/><font point-size="10"><i>«decision»</i></font>>];
  }
  "n5" -> "n6";
  "n1" -> "n8";
  "n2" -> "n9";
  "n2" -> "n3" [label="torque to reading", style=dashed, lhead="cluster_n3"];
  "n3" -> "n9" [ltail="cluster_n3"];
  "n7" -> "n9";
  "n8" -> "n2";
  "n8" -> "n3" [lhead="cluster_n3"];
  "n8" -> "n7";
  "n9" -> "n12";
  "n11" -> "n10";
  "n12" -> "n10" [label="[speed > 0]"];
  "n12" -> "n11";
}
