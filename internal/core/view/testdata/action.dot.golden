// view: FlowViews::driveView
// kind: action
// stated: render asInterconnectionDiagram, view def ActionFlowView
// layout: dot
digraph "FlowViews::driveView" {
  graph [compound=true];
  node [shape=box];
  subgraph "cluster_n0" {
    label=<<b>Flows::Drive</b><br/><font point-size="10">«action def»</font>>;
    "n0" [shape=point, style=invis, width=0, height=0, label=""];
    "n1" [shape=circle, label=<<b>start</b><br/><font point-size="10">«initial»</font>>];
    "n2" [label=<<b>provide : Provide</b><br/><font point-size="10">«action»</font>>];
    subgraph "cluster_n3" {
      label=<<b>monitor</b><br/><font point-size="10">«action»</font><br/>own flow>;
      "n3" [shape=point, style=invis, width=0, height=0, label=""];
      "n5" [shape=circle, label=<<b>begin</b><br/><font point-size="10">«initial»</font>>];
      "n6" [label=<<b>record</b><br/><font point-size="10">«action»</font>>];
    }
    "n7" [label=<<b>tally</b><br/><font point-size="10">«action»</font>>];
    "n8" [label=<<b>split</b><br/><font point-size="10">«fork»</font>>];
    "n9" [label=<<b>sync</b><br/><font point-size="10">«join»</font>>];
    "n10" [shape=doublecircle, label=<<b>done</b><br/><font point-size="10">«final»</font>>];
    "n11" [label=<<b>park</b><br/><font point-size="10">«action»</font>>];
    "n12" [label=<<b>check</b><br/><font point-size="10">«decision»</font>>];
  }
  "n5" -> "n6";
  "n1" -> "n8";
  "n2" -> "n9";
  "n2" -> "n3" [label="torque to reading", style=dashed, lhead="cluster_n3"];
  "n3" -> "n9" [ltail="cluster_n3"];
  "n7" -> "n9";
  "n8" -> "n2";
  "n8" -> "n3" [lhead="cluster_n3"];
  "n8" -> "n7";
  "n9" -> "n12";
  "n11" -> "n10";
  "n12" -> "n10" [label="[speed > 0]"];
  "n12" -> "n11";
}
