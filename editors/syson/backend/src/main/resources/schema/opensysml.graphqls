extend type Mutation {
  runWithOpenSysML(input: RunWithOpenSysMLInput!): RunWithOpenSysMLPayload!
  publishWithOpenSysML(input: PublishWithOpenSysMLInput!): PublishWithOpenSysMLPayload!
}

enum RunOperation {
  INSTANTIATE
  EXECUTE_ACTION
  EXPLORE_ACTION
  EXECUTE_STATE
  EXPLORE_STATE
  VERIFY_CONSTRAINT
  VERIFY_REQUIREMENT
  VERIFY_SATISFACTION
  EVALUATE_CALC
  RUN_ANALYSIS
  VALIDATE_INSTANCE
  RENDER_DOCUMENT
  RUN_DOCUMENT_QUERY
}

enum RunDocumentForm {
  MARKDOWN
  HTML
}

input RunWithOpenSysMLInput {
  id: ID!
  editingContextId: ID!
  objectId: ID!
  operation: RunOperation!
  inputs: [RunInputValue!]
  events: [String!]
  arguments: [String!]
  schedule: String
  subject: String
  form: RunDocumentForm
}

input RunInputValue {
  name: String!
  expression: String!
}

union RunWithOpenSysMLPayload = ErrorPayload | RunWithOpenSysMLSuccessPayload

type RunWithOpenSysMLSuccessPayload {
  id: ID!
  messages: [Message]!
  result: OpenSysMLRunResult!
}

type OpenSysMLRunResult {
  modelHash: String!
  operation: RunOperation!
  target: String!
  ok: Boolean!
  verdict: String
  schedule: String
  finalTime: Float
  outputs: [OpenSysMLNamedValue!]!
  trace: [String!]!
  outcomes: [OpenSysMLRunOutcome!]!
  coverage: OpenSysMLCoverage
  resultText: String
  diagnostics: [OpenSysMLDiagnostic!]!
  verdicts: [OpenSysMLVerdict!]!
  instances: [OpenSysMLInstance!]!
  document: OpenSysMLDocument
  table: OpenSysMLTable
}

type OpenSysMLRunOutcome {
  outputs: [OpenSysMLNamedValue!]!
  finalState: String
  trace: [String!]!
  error: String
  linearizations: Int!
  witness: [String!]!
}

type OpenSysMLCoverage {
  states: [OpenSysMLCoverageEntry!]!
  transitions: [OpenSysMLCoverageEntry!]!
}

type OpenSysMLCoverageEntry {
  path: String!
  declaration: String!
  runs: Int!
}

type OpenSysMLNamedValue {
  name: String!
  value: String!
}

type OpenSysMLDiagnostic {
  severity: String!
  message: String!
  code: String!
  documentName: String
  line: Int
  qualifiedName: String
  elementId: String
  siriusId: String
}

type OpenSysMLVerdict {
  subject: String!
  kind: String!
  holds: Boolean!
  decided: Boolean!
  detail: String
  siriusId: String
}

type OpenSysMLInstance {
  id: Int!
  type: String!
  typeSiriusId: String
  featureValues: [OpenSysMLNamedValue!]!
}

type OpenSysMLDocument {
  form: RunDocumentForm!
  content: String!
  fileName: String!
}

type OpenSysMLTable {
  columns: [String!]!
  rows: [OpenSysMLTableRow!]!
}

type OpenSysMLTableRow {
  element: String!
  siriusId: String
  cells: [String!]!
}

input PublishWithOpenSysMLInput {
  id: ID!
  editingContextId: ID!
  project: String
  projectName: String
  branch: String
  message: String
  deleteMissing: Boolean!
  lastSeenCommit: String
  token: String
}

union PublishWithOpenSysMLPayload = ErrorPayload | PublishWithOpenSysMLSuccessPayload

type PublishWithOpenSysMLSuccessPayload {
  id: ID!
  messages: [Message]!
  result: OpenSysMLPublishResult!
}

type OpenSysMLPublishResult {
  ok: Boolean!
  branchMoved: Boolean!
  summary: String!
  server: String!
  project: String!
  projectName: String!
  createdProject: Boolean!
  branch: String!
  commit: String
  head: String!
  created: Int!
  updated: Int!
  deleted: Int!
  leftInPlace: Int!
  diagnostics: [OpenSysMLDiagnostic!]!
}
