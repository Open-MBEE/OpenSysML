{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "Generated by editors/vscode/tools/gengrammar from internal/core/lexer.Keywords() and lexer.ContextualWords(); do not edit by hand.",
  "name": "KerML",
  "scopeName": "source.kerml",
  "fileTypes": [
    "kerml"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#quoted-names"
    },
    {
      "include": "#declaration-names"
    },
    {
      "include": "#type-references"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords-declaration"
    },
    {
      "include": "#keywords-control"
    },
    {
      "include": "#keywords-modifier"
    },
    {
      "include": "#keywords-relationship"
    },
    {
      "include": "#keywords-operator"
    },
    {
      "include": "#keywords-other"
    },
    {
      "include": "#keywords-contextual"
    },
    {
      "include": "#qualified-names"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.source.kerml",
          "match": "//.*$"
        },
        {
          "name": "comment.block.source.kerml",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "constants": {
      "name": "constant.language.source.kerml",
      "match": "\\b(?:false|null|true)\\b"
    },
    "declaration-names": {
      "match": "\\b(def|package|namespace|alias|library)\\s+([A-Za-z_][A-Za-z0-9_]*|'[^']*')",
      "captures": {
        "1": {
          "name": "keyword.declaration.source.kerml"
        },
        "2": {
          "name": "entity.name.type.source.kerml"
        }
      }
    },
    "keywords-contextual": {
      "name": "keyword.other.contextual.source.kerml",
      "match": "\\b(?:junction|history|shallow|choice|chain|defer|deep|done|var)\\b"
    },
    "keywords-control": {
      "name": "keyword.control.source.kerml",
      "match": "\\b(?:succession|transition|terminate|parallel|exhibit|include|perform|require|satisfy|accept|assert|assign|decide|render|return|after|entry|first|merge|until|while|else|exit|fork|join|loop|send|then|when|for|via|at|do|if|to)\\b"
    },
    "keywords-declaration": {
      "name": "keyword.declaration.source.kerml",
      "match": "\\b(?:multiplicity|verification|interaction|requirement|allocation|classifier|connection|constraint|dependency|occurrence|attribute|connector|interface|metaclass|namespace|predicate|rendering|viewpoint|analysis|behavior|datatype|function|language|metadata|binding|comment|concern|feature|package|action|struct|assoc|class|event|state|calc|case|enum|expr|flow|item|part|port|step|type|view|def|doc|rep)\\b"
    },
    "keywords-modifier": {
      "name": "storage.modifier.source.kerml",
      "match": "\\b(?:individual|composite|nonunique|protected|timeslice|variation|abstract|constant|snapshot|standard|default|derived|library|ordered|portion|private|variant|member|public|const|inout|all|end|new|out|ref|in)\\b"
    },
    "keywords-operator": {
      "name": "keyword.operator.word.source.kerml",
      "match": "\\b(?:defined|hastype|implies|chains|istype|meta|and|not|xor|as|or)\\b"
    },
    "keywords-other": {
      "name": "keyword.other.source.kerml",
      "match": "\\b(?:stakeholder|objective|allocate|connect|message|subject|assume|expose|filter|locale|verify|about|actor|frame|bind|bool|from|inv|use|by|of)\\b"
    },
    "keywords-relationship": {
      "name": "keyword.other.relationship.source.kerml",
      "match": "\\b(?:specialization|subclassifier|redefinition|conjugation|differences|specializes|conjugates|disjoining|intersects|references|conjugate|featuring|inverting|redefines|disjoint|featured|crosses|inverse|subsets|subtype|import|subset|typing|unions|alias|typed)\\b"
    },
    "numbers": {
      "name": "constant.numeric.source.kerml",
      "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
    },
    "operators": {
      "name": "keyword.operator.source.kerml",
      "match": ":>>|::>|:>|=>|->|\\.\\.|\\*\\*|[=+\\-*/<>!&|^~?@]"
    },
    "qualified-names": {
      "name": "entity.name.namespace.source.kerml",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*::)"
    },
    "quoted-names": {
      "name": "entity.name.quoted.source.kerml",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.source.kerml",
          "match": "\\\\."
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.source.kerml",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.source.kerml",
          "match": "\\\\."
        }
      ]
    },
    "type-references": {
      "match": "(:>>|::>|:>|:)\\s*((?:[A-Za-z_][A-Za-z0-9_]*::)*(?:[A-Za-z_][A-Za-z0-9_]*|'[^']*'))",
      "captures": {
        "1": {
          "name": "keyword.operator.source.kerml"
        },
        "2": {
          "name": "entity.name.type.source.kerml"
        }
      }
    }
  }
}
