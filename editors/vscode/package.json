{
  "name": "opensysml-sysml",
  "displayName": "SysML v2 (OpenSysML)",
  "description": "SysML v2 and KerML syntax highlighting and language support backed by the OpenSysML language server.",
  "version": "0.1.0",
  "publisher": "open-mbee",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Open-MBEE/OpenSysML.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:sysml",
    "onLanguage:kerml",
    "onWebviewPanel:opensysml.diagram"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sysml",
        "aliases": [
          "SysML v2",
          "sysml"
        ],
        "extensions": [
          ".sysml"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "kerml",
        "aliases": [
          "KerML",
          "kerml"
        ],
        "extensions": [
          ".kerml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sysml",
        "scopeName": "source.sysml",
        "path": "./syntaxes/sysml.tmLanguage.json"
      },
      {
        "language": "kerml",
        "scopeName": "source.kerml",
        "path": "./syntaxes/kerml.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "SysML v2 (OpenSysML)",
      "properties": {
        "opensysml.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `sysml-lsp` executable. When empty, `sysml-lsp` is looked up on `PATH`."
        },
        "opensysml.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to the language server."
        },
        "opensysml.server.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the language server. Turn this off to keep syntax highlighting only."
        },
        "opensysml.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication with the language server."
        }
      }
    },
    "commands": [
      {
        "command": "opensysml.restartServer",
        "category": "SysML",
        "title": "Restart Language Server"
      },
      {
        "command": "opensysml.openDiagram",
        "category": "SysML",
        "title": "Open Diagram",
        "icon": "$(open-preview)"
      },
      {
        "command": "opensysml.exportDiagram",
        "category": "SysML",
        "title": "Export Diagram"
      },
      {
        "command": "opensysml.renderDocument",
        "category": "SysML",
        "title": "Render Document",
        "enablement": "opensysml.renderDocumentSupported"
      }
    ],
    "keybindings": [
      {
        "command": "opensysml.openDiagram",
        "key": "alt+d",
        "when": "(editorLangId == sysml || editorLangId == kerml) && !terminalFocus || activeWebviewPanelId == opensysml.diagram"
      },
      {
        "command": "opensysml.openDiagram",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus && (editorLangId == sysml || editorLangId == kerml) || activeWebviewPanelId == opensysml.diagram"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "opensysml.openDiagram",
          "group": "navigation",
          "when": "resourceLangId == sysml || resourceLangId == kerml"
        },
        {
          "command": "opensysml.exportDiagram",
          "group": "1_diagram",
          "when": "resourceLangId == sysml || resourceLangId == kerml"
        }
      ],
      "editor/context": [
        {
          "command": "opensysml.openDiagram",
          "group": "navigation@10",
          "when": "editorLangId == sysml || editorLangId == kerml"
        },
        {
          "command": "opensysml.exportDiagram",
          "group": "navigation@11",
          "when": "editorLangId == sysml || editorLangId == kerml"
        }
      ],
      "explorer/context": [
        {
          "command": "opensysml.openDiagram",
          "group": "navigation@10",
          "when": "resourceExtname == .sysml || resourceExtname == .kerml"
        }
      ]
    }
  },
  "scripts": {
    "grammar": "go run ./tools/gengrammar -out syntaxes",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/webview/tsconfig.json",
    "test": "node tools/test.mjs",
    "package": "npm run typecheck && npm test && npm run build -- --production && vsce package --no-dependencies --out opensysml-sysml.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/vscode": "1.86.0",
    "@vscode/vsce": "3.2.2",
    "esbuild": "0.25.0",
    "jsdom": "26.1.0",
    "type-fest": "4.41.0",
    "typescript": "5.7.3"
  }
}
