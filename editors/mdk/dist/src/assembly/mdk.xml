<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3">
  <id>mdk</id>
  <formats><format>zip</format></formats>
  <includeBaseDirectory>false</includeBaseDirectory>
  <dependencySets>
    <dependencySet>
      <outputDirectory>plugins/org.openmbee.opensysml.mdk</outputDirectory>
      <useProjectArtifact>false</useProjectArtifact>
      <useTransitiveDependencies>true</useTransitiveDependencies>
      <includes>
        <include>org.openmbee:opensysml-mdk-plugin</include>
      </includes>
      <fileMode>0644</fileMode>
    </dependencySet>
    <dependencySet>
      <outputDirectory>plugins/org.openmbee.mdk/extensions</outputDirectory>
      <useProjectArtifact>false</useProjectArtifact>
      <useTransitiveDependencies>false</useTransitiveDependencies>
      <includes>
        <include>org.openmbee:opensysml-mdk-bridge</include>
      </includes>
      <fileMode>0644</fileMode>
    </dependencySet>
  </dependencySets>
  <fileSets>
    <fileSet>
      <directory>target/bin</directory>
      <outputDirectory>plugins/org.openmbee.opensysml.mdk/bin</outputDirectory>
      <fileMode>0755</fileMode>
    </fileSet>
    <fileSet>
      <directory>target/lib</directory>
      <outputDirectory>plugins/org.openmbee.opensysml.mdk/lib</outputDirectory>
      <fileMode>0644</fileMode>
    </fileSet>
  </fileSets>
  <files>
    <file>
      <source>target/plugin.xml</source>
      <outputDirectory>plugins/org.openmbee.opensysml.mdk</outputDirectory>
    </file>
    <file>
      <source>src/main/resources/MDR_Plugin_OpenSysML_MDK_descriptor.xml</source>
      <outputDirectory>data/resourcemanager</outputDirectory>
      <filtered>true</filtered>
    </file>
  </files>
</assembly>
