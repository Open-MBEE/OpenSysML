<?xml version="1.0" encoding="UTF-8"?>
<!-- The model of element_form.xmi with every scalar property and reference an
     XML attribute, the serialization most SysML v1 tools export. -->
<xmi:XMI xmi:version="2.5.1" xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
         xmlns:uml="http://www.omg.org/spec/UML/20161101"
         xmlns:sysml="http://www.omg.org/spec/SysML/20181001/SysML">
  <uml:Model xmi:type="uml:Model" xmi:id="_m" name="Model">
    <packagedElement xmi:type="uml:Package" xmi:id="_pkg" name="VehicleExample">
      <packagedElement xmi:type="uml:Class" xmi:id="_vehicle" name="Vehicle">
        <ownedComment xmi:type="uml:Comment" xmi:id="_vehicle_cmt" body="The vehicle under design." annotatedElement="_vehicle"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_vehicle_engine" name="engine" visibility="public" aggregation="composite" type="_engine" association="_assoc">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_vehicle_engine_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_vehicle_engine_hi" value="1"/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_engine" name="Engine"/>
      <packagedElement xmi:type="uml:Association" xmi:id="_assoc" name="vehicle_engine" memberEnd="_vehicle_engine _assoc_vehicle">
        <ownedEnd xmi:type="uml:Property" xmi:id="_assoc_vehicle" name="vehicle" type="_vehicle" association="_assoc"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_req_mass" name="MassRequirement"/>
    </packagedElement>
  </uml:Model>
  <sysml:Block xmi:id="_st_vehicle" base_Class="_vehicle"/>
  <sysml:Block xmi:id="_st_engine" base_Class="_engine"/>
  <sysml:Requirement xmi:id="_st_req_mass" base_Class="_req_mass" id="R1" text="The vehicle shall have a mass of less than 1500 kg."/>
</xmi:XMI>
