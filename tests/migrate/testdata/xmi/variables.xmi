<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.5.1" xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
         xmlns:uml="http://www.omg.org/spec/UML/20161101"
         xmlns:sysml="http://www.omg.org/spec/SysML/20181001/SysML">
  <uml:Model xmi:type="uml:Model" xmi:id="_m" name="Model">
    <packagedElement xmi:type="uml:Package" xmi:id="_pkg" name="Vars">
      <packagedElement xmi:type="uml:Class" xmi:id="_ball" name="Ball"/>
      <packagedElement xmi:type="uml:OpaqueBehavior" xmi:id="_sum" name="Sum">
        <body>x + y</body>
        <ownedParameter xmi:type="uml:Parameter" xmi:id="_sumX" name="x" direction="in">
          <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
        </ownedParameter>
        <ownedParameter xmi:type="uml:Parameter" xmi:id="_sumY" name="y" direction="in">
          <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
        </ownedParameter>
        <ownedParameter xmi:type="uml:Parameter" xmi:id="_sumR" name="r" direction="return">
          <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
        </ownedParameter>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_play" name="Play">
        <node xmi:type="uml:InitialNode" xmi:id="_playInit"/>
        <node xmi:type="uml:ActivityFinalNode" xmi:id="_playFinal"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="_playE" source="_playInit" target="_playFinal"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_vars" name="Variables">
        <variable xmi:type="uml:Variable" xmi:id="_vCount" name="count" isOrdered="true">
          <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_vCountL" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_vCountU" value="*"/>
        </variable>
        <variable xmi:type="uml:Variable" xmi:id="_vBall" name="ball" type="_ball"/>
        <variable xmi:type="uml:Variable" xmi:id="_vAny" name="any"/>
        <variable xmi:type="uml:Variable" xmi:id="_vBag" name="bag" isUnique="false">
          <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_vBagL" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_vBagU" value="*"/>
        </variable>
        <node xmi:type="uml:InitialNode" xmi:id="_init"/>
        <node xmi:type="uml:ReadVariableAction" xmi:id="_read" name="read" variable="_vCount">
          <result xmi:type="uml:OutputPin" xmi:id="_readOut" name="result">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_readOutL" value="0"/>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_readOutU" value="*"/>
          </result>
        </node>
        <node xmi:type="uml:ClearVariableAction" xmi:id="_clear" name="clear" variable="_vCount"/>
        <node xmi:type="uml:ReadVariableAction" xmi:id="_readless" name="readless" variable="_vCount"/>
        <node xmi:type="uml:AddVariableValueAction" xmi:id="_add" name="add" variable="_vCount">
          <value xmi:type="uml:InputPin" xmi:id="_addVal" name="value">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          </value>
        </node>
        <node xmi:type="uml:AddVariableValueAction" xmi:id="_addAt" name="addAt" variable="_vCount">
          <value xmi:type="uml:InputPin" xmi:id="_addAtVal" name="value">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          </value>
          <insertAt xmi:type="uml:InputPin" xmi:id="_addAtPos" name="insertAt">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          </insertAt>
        </node>
        <node xmi:type="uml:AddVariableValueAction" xmi:id="_addAll" name="addAll" variable="_vCount" isReplaceAll="true">
          <value xmi:type="uml:InputPin" xmi:id="_addAllVal" name="value">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          </value>
        </node>
        <node xmi:type="uml:AddVariableValueAction" xmi:id="_addBag" name="addBag" variable="_vBag">
          <value xmi:type="uml:InputPin" xmi:id="_addBagVal" name="value">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          </value>
        </node>
        <node xmi:type="uml:RemoveVariableValueAction" xmi:id="_remove" name="remove" variable="_vCount">
          <value xmi:type="uml:InputPin" xmi:id="_removeVal" name="value">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          </value>
        </node>
        <node xmi:type="uml:RemoveVariableValueAction" xmi:id="_removeAt" name="removeAt" variable="_vCount">
          <removeAt xmi:type="uml:InputPin" xmi:id="_removeAtPos" name="removeAt">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          </removeAt>
        </node>
        <node xmi:type="uml:RemoveVariableValueAction" xmi:id="_removeBag" name="removeBag" variable="_vBag">
          <value xmi:type="uml:InputPin" xmi:id="_removeBagVal" name="value">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          </value>
        </node>
        <node xmi:type="uml:ReadVariableAction" xmi:id="_orphan" name="orphan" variable="_missing">
          <result xmi:type="uml:OutputPin" xmi:id="_orphanOut" name="result">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          </result>
        </node>
        <node xmi:type="uml:ReadVariableAction" xmi:id="_clash" name="clash" variable="_vCount">
          <result xmi:type="uml:OutputPin" xmi:id="_clashOut" name="count">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          </result>
        </node>
        <node xmi:type="uml:StructuredActivityNode" xmi:id="_nest" name="nest">
          <variable xmi:type="uml:Variable" xmi:id="_vInner" name="inner">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          </variable>
          <node xmi:type="uml:InitialNode" xmi:id="_nestInit"/>
          <node xmi:type="uml:ReadVariableAction" xmi:id="_nestRead" name="peek" variable="_vInner">
            <result xmi:type="uml:OutputPin" xmi:id="_nestReadOut" name="result">
              <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
            </result>
          </node>
          <edge xmi:type="uml:ControlFlow" xmi:id="_nestE" source="_nestInit" target="_nestRead"/>
        </node>
        <node xmi:type="uml:ActivityParameterNode" xmi:id="_feed" name="feed">
          <parameter xmi:idref="_feedP"/>
        </node>
        <node xmi:type="uml:ActivityFinalNode" xmi:id="_final"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="_e1" source="_init" target="_read"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="_e2" source="_read" target="_final"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_f1" source="_feed" target="_addVal"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_f2" source="_feed" target="_addAtVal"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_f3" source="_feed" target="_addAtPos"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_f4" source="_feed" target="_addAllVal"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_f5" source="_feed" target="_addBagVal"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_f6" source="_feed" target="_removeVal"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_f7" source="_feed" target="_removeAtPos"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_f8" source="_feed" target="_removeBagVal"/>
        <ownedParameter xmi:type="uml:Parameter" xmi:id="_feedP" name="feed" direction="in">
          <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
        </ownedParameter>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_buffers" name="Buffers">
        <node xmi:type="uml:InitialNode" xmi:id="_bufInit"/>
        <node xmi:type="uml:CentralBufferNode" xmi:id="_buf" name="buf" type="_ball"/>
        <node xmi:type="uml:CentralBufferNode" xmi:id="_fan" name="fan" type="_ball"/>
        <node xmi:type="uml:DataStoreNode" xmi:id="_store" name="store" type="_ball"/>
        <node xmi:type="uml:ActivityParameterNode" xmi:id="_bufIn" name="in">
          <parameter xmi:idref="_bufInP"/>
        </node>
        <node xmi:type="uml:ActivityParameterNode" xmi:id="_bufOut1" name="out1">
          <parameter xmi:idref="_bufOut1P"/>
        </node>
        <node xmi:type="uml:ActivityParameterNode" xmi:id="_bufOut2" name="out2">
          <parameter xmi:idref="_bufOut2P"/>
        </node>
        <node xmi:type="uml:ActivityParameterNode" xmi:id="_bufOut3" name="out3">
          <parameter xmi:idref="_bufOut3P"/>
        </node>
        <node xmi:type="uml:ActivityParameterNode" xmi:id="_bufOut4" name="out4">
          <parameter xmi:idref="_bufOut4P"/>
        </node>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_bf1" source="_bufIn" target="_buf"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_bf2" source="_buf" target="_bufOut1"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_bf3" source="_bufIn" target="_fan"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_bf4" source="_fan" target="_bufOut2"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_bf5" source="_fan" target="_bufOut3"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_bf6" source="_bufIn" target="_store"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_bf7" source="_store" target="_bufOut4"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="_bf8" source="_bufInit" target="_buf"/>
        <ownedParameter xmi:type="uml:Parameter" xmi:id="_bufInP" name="in" direction="in" type="_ball"/>
        <ownedParameter xmi:type="uml:Parameter" xmi:id="_bufOut1P" name="out1" direction="out" type="_ball"/>
        <ownedParameter xmi:type="uml:Parameter" xmi:id="_bufOut2P" name="out2" direction="out" type="_ball"/>
        <ownedParameter xmi:type="uml:Parameter" xmi:id="_bufOut3P" name="out3" direction="out" type="_ball"/>
        <ownedParameter xmi:type="uml:Parameter" xmi:id="_bufOut4P" name="out4" direction="out" type="_ball"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_reducing" name="Reducing">
        <node xmi:type="uml:InitialNode" xmi:id="_redInit"/>
        <node xmi:type="uml:ReduceAction" xmi:id="_reduce" name="reduce" isOrdered="true">
          <reducer xmi:type="uml:FunctionBehavior" href="http://www.omg.org/spec/FUML/20180501/fUML_Library.xmi#PrimitiveBehaviors-IntegerFunctions-plus"/>
          <collection xmi:type="uml:InputPin" xmi:id="_reduceIn" name="collection">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_reduceInL" value="0"/>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_reduceInU" value="*"/>
          </collection>
          <result xmi:type="uml:OutputPin" xmi:id="_reduceOut" name="result">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          </result>
        </node>
        <node xmi:type="uml:ReduceAction" xmi:id="_reduceModel" name="reduceModel" reducer="_sum">
          <collection xmi:type="uml:InputPin" xmi:id="_reduceModelIn" name="collection">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_reduceModelInL" value="0"/>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_reduceModelInU" value="*"/>
          </collection>
          <result xmi:type="uml:OutputPin" xmi:id="_reduceModelOut" name="result">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          </result>
        </node>
        <node xmi:type="uml:ReduceAction" xmi:id="_reduceNoOut" name="reduceNoOut">
          <reducer xmi:type="uml:FunctionBehavior" href="http://www.omg.org/spec/FUML/20180501/fUML_Library.xmi#PrimitiveBehaviors-IntegerFunctions-plus"/>
          <collection xmi:type="uml:InputPin" xmi:id="_reduceNoOutIn" name="collection">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          </collection>
        </node>
        <node xmi:type="uml:ReduceAction" xmi:id="_reduceNoIn" name="reduceNoIn">
          <reducer xmi:type="uml:FunctionBehavior" href="http://www.omg.org/spec/FUML/20180501/fUML_Library.xmi#PrimitiveBehaviors-IntegerFunctions-plus"/>
          <result xmi:type="uml:OutputPin" xmi:id="_reduceNoInOut" name="result">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          </result>
        </node>
        <node xmi:type="uml:ReduceAction" xmi:id="_reduceNone" name="reduceNone" reducer="_play">
          <collection xmi:type="uml:InputPin" xmi:id="_reduceNoneIn" name="collection">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          </collection>
          <result xmi:type="uml:OutputPin" xmi:id="_reduceNoneOut" name="result">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          </result>
        </node>
        <node xmi:type="uml:ActivityParameterNode" xmi:id="_redFeed" name="feed">
          <parameter xmi:idref="_redFeedP"/>
        </node>
        <node xmi:type="uml:ActivityFinalNode" xmi:id="_redFinal"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="_re1" source="_redInit" target="_reduce"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="_re2" source="_reduce" target="_redFinal"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_rf1" source="_redFeed" target="_reduceIn"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_rf2" source="_redFeed" target="_reduceModelIn"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_rf3" source="_redFeed" target="_reduceNoneIn"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_rf5" source="_redFeed" target="_reduceNoOutIn"/>
        <ownedParameter xmi:type="uml:Parameter" xmi:id="_redFeedP" name="feed" direction="in">
          <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_redFeedL" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_redFeedU" value="*"/>
        </ownedParameter>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_raising" name="Raising">
        <node xmi:type="uml:InitialNode" xmi:id="_raiseInit"/>
        <node xmi:type="uml:RaiseExceptionAction" xmi:id="_raise" name="raise">
          <exception xmi:type="uml:InputPin" xmi:id="_raiseIn" name="exception">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          </exception>
        </node>
        <node xmi:type="uml:ReadVariableAction" xmi:id="_after" name="after" variable="_vCount">
          <result xmi:type="uml:OutputPin" xmi:id="_afterOut" name="result">
            <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
          </result>
        </node>
        <node xmi:type="uml:ActivityParameterNode" xmi:id="_raiseFeed" name="feed">
          <parameter xmi:idref="_raiseFeedP"/>
        </node>
        <node xmi:type="uml:StructuredActivityNode" xmi:id="_nestRaise" name="nestRaise">
          <node xmi:type="uml:InitialNode" xmi:id="_nestRaiseInit"/>
          <node xmi:type="uml:RaiseExceptionAction" xmi:id="_raiseNested" name="raiseNested">
            <exception xmi:type="uml:InputPin" xmi:id="_raiseNestedIn" name="exception">
              <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
            </exception>
          </node>
          <edge xmi:type="uml:ControlFlow" xmi:id="_nre1" source="_nestRaiseInit" target="_raiseNested"/>
        </node>
        <node xmi:type="uml:ActivityFinalNode" xmi:id="_raiseFinal"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="_ra1" source="_raiseInit" target="_raise"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_rf4" source="_raiseFeed" target="_raiseIn"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="_rf6" source="_raiseFeed" target="_raiseNestedIn"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="_ra2" source="_raise" target="_after"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="_ra3" source="_after" target="_raiseFinal"/>
        <ownedParameter xmi:type="uml:Parameter" xmi:id="_raiseFeedP" name="feed" direction="in">
          <type href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML_dataType.Integer"/>
        </ownedParameter>
      </packagedElement>
    </packagedElement>
  </uml:Model>
</xmi:XMI>
