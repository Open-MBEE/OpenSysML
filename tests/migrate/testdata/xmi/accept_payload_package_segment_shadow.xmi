<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.5.1" xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
         xmlns:uml="http://www.omg.org/spec/UML/20161101"
         xmlns:sysml="http://www.omg.org/spec/SysML/20181001/SysML">
  <uml:Model xmi:type="uml:Model" xmi:id="_m" name="Model">
    <packagedElement xmi:type="uml:Package" xmi:id="_alarmPkg" name="Alarm">
      <packagedElement xmi:type="uml:Signal" xmi:id="_beep" name="Beep"/>
      <packagedElement xmi:type="uml:SignalEvent" xmi:id="_event" signal="_beep"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Activity" xmi:id="_receive" name="Receive">
      <node xmi:type="uml:InitialNode" xmi:id="_initial"/>
      <node xmi:type="uml:AcceptEventAction" xmi:id="_accept" name="receive">
        <trigger xmi:type="uml:Trigger" xmi:id="_trigger" event="_event"/>
        <result xmi:type="uml:OutputPin" xmi:id="_payload" name="Alarm"/>
      </node>
      <node xmi:type="uml:ActivityFinalNode" xmi:id="_final"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="_start" source="_initial" target="_accept"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="_finish" source="_accept" target="_final"/>
    </packagedElement>
  </uml:Model>
</xmi:XMI>
