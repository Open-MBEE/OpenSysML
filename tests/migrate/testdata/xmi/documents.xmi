  <Document_Profile_:TableAttributeColumn xmi:id="_st_safety_col_doc" base_CallBehaviorAction="_safety_col_doc" desiredAttribute="Documentation"/>
  <Document_Profile_:TableExpressionColumn xmi:id="_st_safety_col_ocl" base_CallBehaviorAction="_safety_col_ocl" expression="owner.oclAsType(NamedElement).name"/>

