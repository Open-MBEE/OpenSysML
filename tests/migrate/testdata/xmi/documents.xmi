    <stereotypes href="http://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML.Requirement"/>
  </Document_Profile_:FilterByStereotypes>
  <Document_Profile_:FilterByNames xmi:id="_st_reqs_names" base_CallBehaviorAction="_reqs_names" include="true">
    <names>Axle.*</names>
    <names>Brake.*</names>
    <names>Load.*</names>
  </Document_Profile_:FilterByNames>
  <Document_Profile_:Paragraph xmi:id="_st_reqs_intro" base_CallBehaviorAction="_reqs_intro" body="&lt;p&gt;Every &lt;b&gt;truck&lt;/b&gt; of the fleet satisfies these requirements.&lt;/p&gt;"/>
