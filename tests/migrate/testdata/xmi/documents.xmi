  </Document_Profile_:TableStructure>
  <Document_Profile_:TableAttributeColumn xmi:id="_st_parts_col_name" base_CallBehaviorAction="_parts_col_name" desiredAttribute="Name"/>
  <Document_Profile_:TablePropertyColumn xmi:id="_st_parts_col_payload" base_CallBehaviorAction="_parts_col_payload" desiredProperty="_prop_payload">
