<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.5.1" xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
         xmlns:uml="http://www.omg.org/spec/UML/20161101"
         xmlns:sysml="http://www.omg.org/spec/SysML/20181001/SysML">
  <uml:Model xmi:type="uml:Model" xmi:id="_m" name="Model">
    <packagedElement xmi:type="uml:Package" xmi:id="_library" name="Library">
      <packagedElement xmi:type="uml:Class" xmi:id="_viewpoint" name="Recursive Viewpoint">
        <ownedOperation xmi:type="uml:Operation" xmi:id="_view" name="View" method="_viewBody"/>
        <ownedBehavior xmi:type="uml:Activity" xmi:id="_viewBody" name="View Body" specification="_view">
          <node xmi:type="uml:InitialNode" xmi:id="_start"/>
          <node xmi:type="uml:CallBehaviorAction" xmi:id="_recursiveCall" name="recursive call" behavior="_viewBody"/>
          <node xmi:type="uml:ActivityFinalNode" xmi:id="_finish"/>
          <edge xmi:type="uml:ControlFlow" xmi:id="_startFlow" source="_start" target="_recursiveCall"/>
          <edge xmi:type="uml:ControlFlow" xmi:id="_finishFlow" source="_recursiveCall" target="_finish"/>
        </ownedBehavior>
      </packagedElement>
    </packagedElement>
  </uml:Model>
  <sysml:Viewpoint xmi:id="_viewpointStereotype" base_Class="_viewpoint"/>
</xmi:XMI>
