<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.5.1" xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
         xmlns:uml="http://www.omg.org/spec/UML/20161101"
         xmlns:sysml="http://www.omg.org/spec/SysML/20181001/SysML"
         xmlns:diagram="http://www.example.com/tool/diagram">
  <xmi:Documentation exporter="Example UML Tool" exporterVersion="1.0"/>
  <uml:Model xmi:type="uml:Model" xmi:id="_m" name="Model">
    <packagedElement xmi:type="uml:Package" xmi:id="_pkg_blocks" name="Blocks">
      <packagedElement xmi:type="uml:Class" xmi:id="_blk_vehicle" name="Vehicle">
        <ownedAttribute xmi:type="uml:Property" xmi:id="_prop_engine" name="engine" type="_blk_engine" aggregation="composite"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_blk_engine" name="Engine">
        <ownedAttribute xmi:type="uml:Property" xmi:id="_prop_piston" name="piston" type="_blk_piston" aggregation="composite"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_prop_sensor" name="sensor" type="_blk_sensor" aggregation="composite"/>
        <ownedConnector xmi:type="uml:Connector" xmi:id="_conn_feed">
          <end xmi:type="uml:ConnectorEnd" xmi:id="_ce_feed_1" role="_prop_piston"/>
          <end xmi:type="uml:ConnectorEnd" xmi:id="_ce_feed_2" role="_prop_sensor"/>
        </ownedConnector>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_blk_piston" name="Piston"/>
      <packagedElement xmi:type="uml:Class" xmi:id="_blk_sensor" name="Sensor"/>
    </packagedElement>
    <xmi:Extension extender="Example UML Tool 1.0">
      <modelExtension>
        <ownedDiagram xmi:type="uml:Diagram" xmi:id="_diag_ibd" name="Vehicle Internals" ownerOfDiagram="_blk_vehicle">
          <xmi:Extension extender="Example UML Tool 1.0">
            <diagramRepresentation>
              <diagram:DiagramRepresentationObject type="SysML Internal Block Diagram" umlType="Composite Structure Diagram">
                <diagramContents>
                  <usedElements>_prop_engine</usedElements>
                  <usedElements>_prop_piston</usedElements>
                  <usedElements>_prop_sensor</usedElements>
                  <usedElements>_conn_feed</usedElements>
                </diagramContents>
                <binaryObject streamContentID="BINARY-nested_parts"/>
              </diagram:DiagramRepresentationObject>
            </diagramRepresentation>
          </xmi:Extension>
        </ownedDiagram>
      </modelExtension>
    </xmi:Extension>
  </uml:Model>
  <sysml:Block xmi:id="_s_vehicle" base_Class="_blk_vehicle"/>
  <sysml:Block xmi:id="_s_engine" base_Class="_blk_engine"/>
  <sysml:Block xmi:id="_s_piston" base_Class="_blk_piston"/>
  <sysml:Block xmi:id="_s_sensor" base_Class="_blk_sensor"/>
</xmi:XMI>
