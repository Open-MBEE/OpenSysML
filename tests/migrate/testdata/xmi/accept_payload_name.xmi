<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.5.1" xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
         xmlns:uml="http://www.omg.org/spec/UML/20161101"
         xmlns:sysml="http://www.omg.org/spec/SysML/20181001/SysML">
  <uml:Model xmi:type="uml:Model" xmi:id="_m" name="Model">
    <packagedElement xmi:type="uml:Package" xmi:id="_pkg" name="AccProbe">
      <packagedElement xmi:type="uml:Signal" xmi:id="_signal" name="s3"/>
      <packagedElement xmi:type="uml:SignalEvent" xmi:id="_event" signal="_signal"/>
      <packagedElement xmi:type="uml:Signal" xmi:id="_startSignal" name="start"/>
      <packagedElement xmi:type="uml:SignalEvent" xmi:id="_startEvent" signal="_startSignal"/>
      <packagedElement xmi:type="uml:Activity" xmi:id="_wait" name="Wait">
        <node xmi:type="uml:InitialNode" xmi:id="_init"/>
        <node xmi:type="uml:AcceptEventAction" xmi:id="_accept" name="wait">
          <trigger xmi:type="uml:Trigger" xmi:id="_trigger" event="_event"/>
          <result xmi:type="uml:OutputPin" xmi:id="_payload" name="s3"/>
        </node>
        <node xmi:type="uml:ActivityFinalNode" xmi:id="_final"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="_e1" source="_init" target="_accept"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="_e2" source="_accept" target="_final"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_host" name="Host" classifierBehavior="_machine">
        <ownedBehavior xmi:type="uml:StateMachine" xmi:id="_machine" name="Machine">
          <region xmi:type="uml:Region" xmi:id="_region">
            <subvertex xmi:type="uml:Pseudostate" xmi:id="_machineInit"/>
            <subvertex xmi:type="uml:State" xmi:id="_a" name="A"/>
            <subvertex xmi:type="uml:State" xmi:id="_b" name="B"/>
            <transition xmi:type="uml:Transition" xmi:id="_machineStart" source="_machineInit" target="_a"/>
            <transition xmi:type="uml:Transition" xmi:id="_machineAccept" source="_a" target="_b">
              <trigger xmi:type="uml:Trigger" xmi:id="_startTrigger" event="_startEvent"/>
            </transition>
          </region>
        </ownedBehavior>
      </packagedElement>
    </packagedElement>
  </uml:Model>
  <sysml:Block xmi:id="_block" base_Class="_host"/>
</xmi:XMI>
