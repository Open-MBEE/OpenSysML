<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.5.1" xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
         xmlns:uml="http://www.omg.org/spec/UML/20161101"
         xmlns:sysml="http://www.omg.org/spec/SysML/20181001/SysML"
         xmlns:SimulationProfile="http://www.magicdraw.com/schemas/SimulationProfile.xmi"
         xmlns:UI_Prototyping_Profile="http://www.magicdraw.com/schemas/UI_Prototyping_Profile.xmi">
  <uml:Model xmi:type="uml:Model" xmi:id="_m" name="Model">
    <packagedElement xmi:type="uml:Signal" xmi:id="_start" name="Start"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="_stop" name="Stop"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="_finish" name="Finish"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="_reset" name="Reset"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="_hardReset" name="Hard Reset">
      <generalization xmi:type="uml:Generalization" xmi:id="_hardResetGen" general="_reset"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Signal" xmi:id="_pause" name="Pause"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="_longPause" name="Long Pause">
      <generalization xmi:type="uml:Generalization" xmi:id="_longPauseGen" general="_pause"/>
    </packagedElement>
    <!-- Resume's delay must hold a value, which the model's send never passes: that send is a placeholder. -->
    <packagedElement xmi:type="uml:Signal" xmi:id="_resume" name="Resume">
      <ownedAttribute xmi:type="uml:Property" xmi:id="_resumeDelay" name="delay">
        <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#Real"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="_resetEv" signal="_reset"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="_pauseEv" signal="_pause"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="_resumeEv" signal="_resume"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="_startEv" signal="_start"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="_stopEv" signal="_stop"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="_finishEv" signal="_finish"/>
    <packagedElement xmi:type="uml:Class" xmi:id="_ctl" name="Controller" classifierBehavior="_sm">
      <!-- Running's do activity: the model itself sends Stop, and Hard Reset, a Reset. -->
      <ownedBehavior xmi:type="uml:Activity" xmi:id="_run" name="Run">
        <node xmi:type="uml:InitialNode" xmi:id="_runInit"/>
        <node xmi:type="uml:SendSignalAction" xmi:id="_sendStop" name="send stop" signal="_stop"/>
        <node xmi:type="uml:SendSignalAction" xmi:id="_sendHardReset" name="send hard reset" signal="_hardReset"/>
        <node xmi:type="uml:SendSignalAction" xmi:id="_sendResume" name="send resume" signal="_resume"/>
        <node xmi:type="uml:ActivityFinalNode" xmi:id="_runFinal"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="_runE1" source="_runInit" target="_sendStop"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="_runE3" source="_sendStop" target="_sendHardReset"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="_runE4" source="_sendHardReset" target="_sendResume"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="_runE2" source="_sendResume" target="_runFinal"/>
      </ownedBehavior>
      <ownedBehavior xmi:type="uml:StateMachine" xmi:id="_sm" name="Controller Behavior">
        <region xmi:type="uml:Region" xmi:id="_r">
          <subvertex xmi:type="uml:Pseudostate" xmi:id="_init" kind="initial"/>
          <subvertex xmi:type="uml:State" xmi:id="_idle" name="Idle"/>
          <subvertex xmi:type="uml:State" xmi:id="_running" name="Running" doActivity="_run"/>
          <subvertex xmi:type="uml:FinalState" xmi:id="_done" name="Done"/>
          <transition xmi:type="uml:Transition" xmi:id="_t0" source="_init" target="_idle"/>
          <transition xmi:type="uml:Transition" xmi:id="_tStart" source="_idle" target="_running">
            <trigger xmi:type="uml:Trigger" xmi:id="_trStart" event="_startEv"/>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="_tStop" source="_running" target="_idle">
            <trigger xmi:type="uml:Trigger" xmi:id="_trStop" event="_stopEv"/>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="_tReset" source="_running" target="_idle">
            <trigger xmi:type="uml:Trigger" xmi:id="_trReset" event="_resetEv"/>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="_tPause" source="_running" target="_idle">
            <trigger xmi:type="uml:Trigger" xmi:id="_trPause" event="_pauseEv"/>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="_tResume" source="_idle" target="_running">
            <trigger xmi:type="uml:Trigger" xmi:id="_trResume" event="_resumeEv"/>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="_tFinish" source="_idle" target="_done">
            <trigger xmi:type="uml:Trigger" xmi:id="_trFinish" event="_finishEv"/>
          </transition>
        </region>
      </ownedBehavior>
    </packagedElement>
    <!-- An activity that waits for Start too, as an accept. -->
    <packagedElement xmi:type="uml:Activity" xmi:id="_await" name="Await Start">
      <node xmi:type="uml:InitialNode" xmi:id="_awInit"/>
      <node xmi:type="uml:AcceptEventAction" xmi:id="_awAccept" name="started">
        <trigger xmi:type="uml:Trigger" xmi:id="_awTr" event="_startEv"/>
      </node>
      <node xmi:type="uml:ActivityFinalNode" xmi:id="_awFinal"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="_awE1" source="_awInit" target="_awAccept"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="_awE2" source="_awAccept" target="_awFinal"/>
    </packagedElement>
    <!-- The tool's UI prototype: a frame with buttons that post Start, Reset, Long Pause (a Pause) and Resume. -->
    <packagedElement xmi:type="uml:Package" xmi:id="_gui" name="Gui">
      <packagedElement xmi:type="uml:Component" xmi:id="_frame" name="Console"/>
      <packagedElement xmi:type="uml:Class" xmi:id="_button"/>
      <packagedElement xmi:type="uml:Class" xmi:id="_resetButton"/>
      <packagedElement xmi:type="uml:Class" xmi:id="_pauseButton"/>
      <packagedElement xmi:type="uml:Class" xmi:id="_resumeButton"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="_cfg" name="Interactive"/>
  </uml:Model>
  <sysml:Block xmi:id="_s1" base_Class="_ctl"/>
  <UI_Prototyping_Profile:Frame xmi:id="_a_frame" base_Component="_frame" Title="Operate the controller"/>
  <UI_Prototyping_Profile:Button xmi:id="_a_button" base_Class="_button" Text="Start"/>
  <SimulationProfile:SignalInstance xmi:id="_a_signal" base_Element="_button" element="_start"/>
  <UI_Prototyping_Profile:Button xmi:id="_a_resetButton" base_Class="_resetButton" Text="Reset"/>
  <SimulationProfile:SignalInstance xmi:id="_a_resetSignal" base_Element="_resetButton" element="_reset"/>
  <UI_Prototyping_Profile:Button xmi:id="_a_pauseButton" base_Class="_pauseButton" Text="Pause"/>
  <SimulationProfile:SignalInstance xmi:id="_a_pauseSignal" base_Element="_pauseButton" element="_longPause"/>
  <UI_Prototyping_Profile:Button xmi:id="_a_resumeButton" base_Class="_resumeButton" Text="Resume"/>
  <SimulationProfile:SignalInstance xmi:id="_a_resumeSignal" base_Element="_resumeButton" element="_resume"/>
  <SimulationProfile:SimulationConfig xmi:id="_a_cfg" base_Class="_cfg" executionTarget="_ctl" UI="_frame"/>
</xmi:XMI>
