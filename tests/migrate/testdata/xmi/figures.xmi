<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.5.1" xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
         xmlns:uml="http://www.omg.org/spec/UML/20161101"
         xmlns:sysml="http://www.omg.org/spec/SysML/20181001/SysML"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Document_Profile_="http://www.magicdraw.com/schemas/manual/Document_Profile.xmi"
         xmlns:diagram="http://www.example.com/tool/diagram">
  <xmi:Documentation exporter="Example UML Tool" exporterVersion="1.0"/>
  <uml:Model xmi:type="uml:Model" xmi:id="_m" name="Model">

    <packagedElement xmi:type="uml:Package" xmi:id="_pkg_plant" name="Plant">
      <packagedElement xmi:type="uml:Signal" xmi:id="_sig_start" name="Start"/>
      <packagedElement xmi:type="uml:SignalEvent" xmi:id="_ev_start" signal="_sig_start"/>
      <packagedElement xmi:type="uml:Class" xmi:id="_blk_pump" name="Pump">
        <ownedComment xmi:type="uml:Comment" xmi:id="_cmt_pump" body="Moves the coolant."/>
        <ownedBehavior xmi:type="uml:StateMachine" xmi:id="_sm_modes" name="Modes">
          <region xmi:type="uml:Region" xmi:id="_sm_region">
            <subvertex xmi:type="uml:Pseudostate" xmi:id="_sm_init" kind="initial"/>
            <subvertex xmi:type="uml:State" xmi:id="_st_idle" name="Idle"/>
            <subvertex xmi:type="uml:State" xmi:id="_st_running" name="Running"/>
            <transition xmi:type="uml:Transition" xmi:id="_t_init" source="_sm_init" target="_st_idle"/>
            <transition xmi:type="uml:Transition" xmi:id="_t_start" source="_st_idle" target="_st_running">
              <trigger xmi:type="uml:Trigger" xmi:id="_tr_start" event="_ev_start"/>
              <ownedComment xmi:type="uml:Comment" xmi:id="_cmt_start" annotatedElement="_t_start" body="On demand."/>
            </transition>
          </region>
        </ownedBehavior>
        <ownedBehavior xmi:type="uml:Activity" xmi:id="_act_prime" name="Prime">
          <node xmi:type="uml:InitialNode" xmi:id="_prime_init"/>
          <node xmi:type="uml:OpaqueAction" xmi:id="_prime_fill" name="Fill"/>
          <node xmi:type="uml:OpaqueAction" xmi:id="_prime_vent" name="Vent"/>
          <node xmi:type="uml:ActivityFinalNode" xmi:id="_prime_final"/>
          <edge xmi:type="uml:ControlFlow" xmi:id="_prime_e1" source="_prime_init" target="_prime_fill"/>
          <edge xmi:type="uml:ControlFlow" xmi:id="_prime_e2" source="_prime_fill" target="_prime_vent"/>
          <edge xmi:type="uml:ControlFlow" xmi:id="_prime_e3" source="_prime_vent" target="_prime_final"/>
        </ownedBehavior>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_blk_tank" name="Tank"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Package" xmi:id="_pkg_viewpoints" name="Plant Viewpoints">
      <packagedElement xmi:type="uml:Class" xmi:id="_vp_figures" name="Figures Viewpoint" classifierBehavior="_act_figures">
        <ownedBehavior xmi:type="uml:Activity" xmi:id="_act_figures" name="Figures Method">
          <node xmi:type="uml:InitialNode" xmi:id="_figures_init"/>
          <node xmi:type="uml:CallBehaviorAction" xmi:id="_figures_image" name="Image"/>
          <node xmi:type="uml:ActivityFinalNode" xmi:id="_figures_final"/>
          <edge xmi:type="uml:ControlFlow" xmi:id="_figures_e1" source="_figures_init" target="_figures_image"/>
          <edge xmi:type="uml:ControlFlow" xmi:id="_figures_e2" source="_figures_image" target="_figures_final"/>
        </ownedBehavior>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_vp_pictures" name="Pictures Viewpoint" classifierBehavior="_act_pictures">
        <ownedBehavior xmi:type="uml:Activity" xmi:id="_act_pictures" name="Pictures Method">
          <node xmi:type="uml:InitialNode" xmi:id="_pictures_init"/>
          <node xmi:type="uml:CallBehaviorAction" xmi:id="_pictures_image" name="Image"/>
          <node xmi:type="uml:ActivityFinalNode" xmi:id="_pictures_final"/>
          <edge xmi:type="uml:ControlFlow" xmi:id="_pictures_e1" source="_pictures_init" target="_pictures_image"/>
          <edge xmi:type="uml:ControlFlow" xmi:id="_pictures_e2" source="_pictures_image" target="_pictures_final"/>
        </ownedBehavior>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_vp_shown" name="Shown Viewpoint" classifierBehavior="_act_shown">
        <ownedBehavior xmi:type="uml:Activity" xmi:id="_act_shown" name="Shown Method">
          <node xmi:type="uml:InitialNode" xmi:id="_shown_init"/>
          <node xmi:type="uml:CallBehaviorAction" xmi:id="_shown_collect" name="Collect Things On Diagram"/>
          <node xmi:type="uml:StructuredActivityNode" xmi:id="_shown_table" name="Shown Blocks">
            <node xmi:type="uml:InitialNode" xmi:id="_shown_table_init"/>
            <node xmi:type="uml:CallBehaviorAction" xmi:id="_shown_col_name" name="Name"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_shown_table_e1" source="_shown_table_init" target="_shown_col_name"/>
          </node>
          <node xmi:type="uml:ActivityFinalNode" xmi:id="_shown_final"/>
          <edge xmi:type="uml:ControlFlow" xmi:id="_shown_e1" source="_shown_init" target="_shown_collect"/>
          <edge xmi:type="uml:ControlFlow" xmi:id="_shown_e2" source="_shown_collect" target="_shown_table"/>
          <edge xmi:type="uml:ControlFlow" xmi:id="_shown_e3" source="_shown_table" target="_shown_final"/>
        </ownedBehavior>
      </packagedElement>
    </packagedElement>

    <packagedElement xmi:type="uml:Package" xmi:id="_pkg_docs" name="Plant Documents">
      <packagedElement xmi:type="uml:Class" xmi:id="_doc_plant" name="Plant Handbook">
        <ownedAttribute xmi:type="uml:Property" xmi:id="_doc_behaviors" name="behaviors" type="_view_behaviors" aggregation="composite"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_doc_pictures" name="pictures" type="_view_pictures" aggregation="composite"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_doc_shown" name="shown" type="_view_shown" aggregation="composite"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_view_behaviors" name="Behaviors">
        <generalization xmi:type="uml:Generalization" xmi:id="_gen_behaviors" general="_vp_figures"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Dependency" xmi:id="_expose_behaviors_modes" client="_view_behaviors" supplier="_diag_modes"/>
      <packagedElement xmi:type="uml:Dependency" xmi:id="_expose_behaviors_prime" client="_view_behaviors" supplier="_diag_prime"/>
      <packagedElement xmi:type="uml:Class" xmi:id="_view_pictures" name="Pictures">
        <generalization xmi:type="uml:Generalization" xmi:id="_gen_pictures" general="_vp_pictures"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Dependency" xmi:id="_expose_pictures_blank" client="_view_pictures" supplier="_diag_blank"/>
      <packagedElement xmi:type="uml:Dependency" xmi:id="_expose_pictures_poster" client="_view_pictures" supplier="_diag_poster"/>
      <packagedElement xmi:type="uml:Dependency" xmi:id="_expose_pictures_unlisted" client="_view_pictures" supplier="_diag_unlisted"/>
      <packagedElement xmi:type="uml:Dependency" xmi:id="_expose_pictures_silent" client="_view_pictures" supplier="_diag_silent"/>
      <packagedElement xmi:type="uml:Dependency" xmi:id="_expose_pictures_stale" client="_view_pictures" supplier="_diag_stale"/>
      <packagedElement xmi:type="uml:Class" xmi:id="_view_shown" name="Shown">
        <generalization xmi:type="uml:Generalization" xmi:id="_gen_shown" general="_vp_shown"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Dependency" xmi:id="_expose_shown_partial" client="_view_shown" supplier="_diag_partial"/>
      <packagedElement xmi:type="uml:Dependency" xmi:id="_expose_shown_unlisted" client="_view_shown" supplier="_diag_unlisted"/>
    </packagedElement>

    <xmi:Extension extender="Example UML Tool 1.0">
      <modelExtension>
        <ownedDiagram xmi:type="uml:Diagram" xmi:id="_diag_modes" name="Pump Modes" ownerOfDiagram="_sm_modes">
          <xmi:Extension extender="Example UML Tool 1.0">
            <diagramRepresentation>
              <diagram:DiagramRepresentationObject type="SysML State Machine Diagram" umlType="State Machine Diagram">
                <diagramContents>
                  <usedElements>_st_idle</usedElements>
                  <usedElements>_st_running</usedElements>
                  <usedElements>_t_start</usedElements>
                  <binaryObject xsi:type="binary:StreamIdentityBinaryObject" streamContentID="BINARY-modes"/>
                </diagramContents>
              </diagram:DiagramRepresentationObject>
            </diagramRepresentation>
          </xmi:Extension>
        </ownedDiagram>
        <ownedDiagram xmi:type="uml:Diagram" xmi:id="_diag_prime" name="Priming" ownerOfDiagram="_act_prime">
          <xmi:Extension extender="Example UML Tool 1.0">
            <diagramRepresentation>
              <diagram:DiagramRepresentationObject type="SysML Activity Diagram" umlType="Activity Diagram">
                <diagramContents>
                  <usedElements>_prime_fill</usedElements>
                  <usedElements>_prime_vent</usedElements>
                </diagramContents>
              </diagram:DiagramRepresentationObject>
            </diagramRepresentation>
          </xmi:Extension>
        </ownedDiagram>
        <!-- Four diagrams the tool lists no used element for: the streams the
             archive holds tell a blank one from a pasted picture and from
             symbols of elements the list omits; Silent names no stream. -->
        <ownedDiagram xmi:type="uml:Diagram" xmi:id="_diag_blank" name="Blank" ownerOfDiagram="_pkg_plant">
          <xmi:Extension extender="Example UML Tool 1.0">
            <diagramRepresentation>
              <diagram:DiagramRepresentationObject type="SysML Block Definition Diagram" umlType="Class Diagram">
                <diagramContents>
                  <binaryObject xsi:type="binary:StreamIdentityBinaryObject" streamContentID="BINARY-blank"/>
                </diagramContents>
              </diagram:DiagramRepresentationObject>
            </diagramRepresentation>
          </xmi:Extension>
        </ownedDiagram>
        <ownedDiagram xmi:type="uml:Diagram" xmi:id="_diag_poster" name="Poster" ownerOfDiagram="_pkg_plant">
          <xmi:Extension extender="Example UML Tool 1.0">
            <diagramRepresentation>
              <diagram:DiagramRepresentationObject type="SysML Block Definition Diagram" umlType="Class Diagram">
                <diagramContents>
                  <binaryObject xsi:type="binary:StreamIdentityBinaryObject" streamContentID="BINARY-poster"/>
                </diagramContents>
              </diagram:DiagramRepresentationObject>
            </diagramRepresentation>
          </xmi:Extension>
        </ownedDiagram>
        <ownedDiagram xmi:type="uml:Diagram" xmi:id="_diag_unlisted" name="Unlisted" ownerOfDiagram="_pkg_plant">
          <xmi:Extension extender="Example UML Tool 1.0">
            <diagramRepresentation>
              <diagram:DiagramRepresentationObject type="SysML Block Definition Diagram" umlType="Class Diagram">
                <diagramContents>
                  <binaryObject xsi:type="binary:StreamIdentityBinaryObject" streamContentID="BINARY-unlisted"/>
                </diagramContents>
              </diagram:DiagramRepresentationObject>
            </diagramRepresentation>
          </xmi:Extension>
        </ownedDiagram>
        <ownedDiagram xmi:type="uml:Diagram" xmi:id="_diag_silent" name="Silent" ownerOfDiagram="_pkg_plant">
          <xmi:Extension extender="Example UML Tool 1.0">
            <diagramRepresentation>
              <diagram:DiagramRepresentationObject type="SysML Block Definition Diagram" umlType="Class Diagram">
                <diagramContents/>
              </diagram:DiagramRepresentationObject>
            </diagramRepresentation>
          </xmi:Extension>
        </ownedDiagram>
        <!-- Stale lists a used element its stream has no symbol for; the stream shows another. -->
        <ownedDiagram xmi:type="uml:Diagram" xmi:id="_diag_stale" name="Stale" ownerOfDiagram="_pkg_plant">
          <xmi:Extension extender="Example UML Tool 1.0">
            <diagramRepresentation>
              <diagram:DiagramRepresentationObject type="SysML Block Definition Diagram" umlType="Class Diagram">
                <diagramContents>
                  <usedElements>_blk_pump</usedElements>
                  <binaryObject xsi:type="binary:StreamIdentityBinaryObject" streamContentID="BINARY-stale"/>
                </diagramContents>
              </diagram:DiagramRepresentationObject>
            </diagramRepresentation>
          </xmi:Extension>
        </ownedDiagram>
        <!-- Partial lists one used element and names a stream showing another. -->
        <ownedDiagram xmi:type="uml:Diagram" xmi:id="_diag_partial" name="Partial" ownerOfDiagram="_pkg_plant">
          <xmi:Extension extender="Example UML Tool 1.0">
            <diagramRepresentation>
              <diagram:DiagramRepresentationObject type="SysML Block Definition Diagram" umlType="Class Diagram">
                <diagramContents>
                  <usedElements>_blk_tank</usedElements>
                  <binaryObject xsi:type="binary:StreamIdentityBinaryObject" streamContentID="BINARY-partial"/>
                </diagramContents>
              </diagram:DiagramRepresentationObject>
            </diagramRepresentation>
          </xmi:Extension>
        </ownedDiagram>
      </modelExtension>
    </xmi:Extension>
  </uml:Model>

  <sysml:Block xmi:id="_st_blk_pump" base_Class="_blk_pump"/>
  <sysml:Block xmi:id="_st_blk_tank" base_Class="_blk_tank"/>

  <sysml:Viewpoint xmi:id="_st_vp_figures" base_Class="_vp_figures"/>
  <sysml:Viewpoint xmi:id="_st_vp_pictures" base_Class="_vp_pictures"/>
  <sysml:Viewpoint xmi:id="_st_vp_shown" base_Class="_vp_shown"/>
  <sysml:View xmi:id="_st_view_behaviors" base_Class="_view_behaviors"/>
  <sysml:View xmi:id="_st_view_pictures" base_Class="_view_pictures"/>
  <sysml:View xmi:id="_st_view_shown" base_Class="_view_shown"/>
  <sysml:Conform xmi:id="_st_conform_behaviors" base_Generalization="_gen_behaviors"/>
  <sysml:Conform xmi:id="_st_conform_pictures" base_Generalization="_gen_pictures"/>
  <sysml:Conform xmi:id="_st_conform_shown" base_Generalization="_gen_shown"/>
  <sysml:Expose xmi:id="_st_expose_behaviors_modes" base_Dependency="_expose_behaviors_modes"/>
  <sysml:Expose xmi:id="_st_expose_behaviors_prime" base_Dependency="_expose_behaviors_prime"/>
  <sysml:Expose xmi:id="_st_expose_pictures_blank" base_Dependency="_expose_pictures_blank"/>
  <sysml:Expose xmi:id="_st_expose_pictures_poster" base_Dependency="_expose_pictures_poster"/>
  <sysml:Expose xmi:id="_st_expose_pictures_unlisted" base_Dependency="_expose_pictures_unlisted"/>
  <sysml:Expose xmi:id="_st_expose_pictures_silent" base_Dependency="_expose_pictures_silent"/>
  <sysml:Expose xmi:id="_st_expose_pictures_stale" base_Dependency="_expose_pictures_stale"/>
  <sysml:Expose xmi:id="_st_expose_shown_partial" base_Dependency="_expose_shown_partial"/>
  <sysml:Expose xmi:id="_st_expose_shown_unlisted" base_Dependency="_expose_shown_unlisted"/>

  <Document_Profile_:Document xmi:id="_st_doc_plant" base_Class="_doc_plant"/>
  <Document_Profile_:Image xmi:id="_st_figures_image" base_CallBehaviorAction="_figures_image" showCaptions="true">
    <captions>How the pump behaves</captions>
    <captions>How the pump is primed</captions>
  </Document_Profile_:Image>
  <Document_Profile_:Image xmi:id="_st_pictures_image" base_CallBehaviorAction="_pictures_image" showCaptions="true">
    <captions>Nothing to see</captions>
    <captions>The plant, photographed</captions>
  </Document_Profile_:Image>
  <Document_Profile_:CollectThingsOnDiagram xmi:id="_st_shown_collect" base_CallBehaviorAction="_shown_collect"/>
  <Document_Profile_:TableStructure xmi:id="_st_shown_table" base_StructuredActivityNode="_shown_table"/>
  <Document_Profile_:TableAttributeColumn xmi:id="_st_shown_col_name" base_CallBehaviorAction="_shown_col_name" desiredAttribute="Name"/>
</xmi:XMI>
