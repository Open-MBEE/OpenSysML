<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.5.1" xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
         xmlns:uml="http://www.omg.org/spec/UML/20161101"
         xmlns:sysml="http://www.omg.org/spec/SysML/20181001/SysML">
  <uml:Model xmi:type="uml:Model" xmi:id="_m" name="Catalog">
    <packagedElement xmi:type="uml:Package" xmi:id="_parts" name="Components">
      <packagedElement xmi:type="uml:Class" xmi:id="_motor" name="Motor"/>
      <packagedElement xmi:type="uml:Class" xmi:id="_wheel" name="Wheel"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="_systems" name="Systems">
      <packagedElement xmi:type="uml:Class" xmi:id="_rover" name="Rover">
        <ownedAttribute xmi:type="uml:Property" xmi:id="_roverMotor" name="motor" type="_motor" aggregation="composite"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_roverWheel" name="Wheel" type="_wheel" aggregation="composite"/>
      </packagedElement>
    </packagedElement>
  </uml:Model>
  <sysml:Block xmi:id="_s1" base_Class="_motor"/>
  <sysml:Block xmi:id="_s2" base_Class="_wheel"/>
  <sysml:Block xmi:id="_s3" base_Class="_rover"/>
</xmi:XMI>
