<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.5.1" xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
         xmlns:uml="http://www.omg.org/spec/UML/20161101"
         xmlns:sysml="http://www.omg.org/spec/SysML/20181001/SysML"
         xmlns:Document_Profile_="http://www.magicdraw.com/schemas/manual/Document_Profile.xmi">
  <xmi:Documentation exporter="Example UML Tool" exporterVersion="1.0"/>
  <uml:Model xmi:type="uml:Model" xmi:id="_m" name="Model">
    <packagedElement xmi:type="uml:Package" xmi:id="_pkg_obs" name="Observatory">

      <packagedElement xmi:type="uml:Package" xmi:id="_pkg_types" name="Interface Types">
        <packagedElement xmi:type="uml:DataType" xmi:id="_vt_bits" name="Bits"/>
        <packagedElement xmi:type="uml:Class" xmi:id="_ib_usb" name="USB">
          <ownedAttribute xmi:type="uml:Property" xmi:id="_fp_usb_data" name="data" type="_vt_bits"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="_ib_serial" name="Serial">
          <ownedAttribute xmi:type="uml:Property" xmi:id="_fp_serial_cmd" name="cmd" type="_vt_bits"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="_ib_spare" name="Spare"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Package" xmi:id="_pkg_asm" name="Assemblies">
        <packagedElement xmi:type="uml:Class" xmi:id="_blk_coll" name="Collimator">
          <ownedAttribute xmi:type="uml:Port" xmi:id="_port_coll_usb" name="usb" type="_ib_usb" aggregation="composite">
            <ownedComment xmi:type="uml:Comment" xmi:id="_doc_coll_usb" body="Camera link." annotatedElement="_port_coll_usb"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Port" xmi:id="_port_coll_ctl" name="ctl" type="_ib_serial" aggregation="composite"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="_blk_mirror" name="Mirror">
          <ownedAttribute xmi:type="uml:Port" xmi:id="_port_mirror_tilt" name="tilt" type="_ib_serial" aggregation="composite">
            <ownedComment xmi:type="uml:Comment" xmi:id="_doc_mirror_tilt" body="Tilt command." annotatedElement="_port_mirror_tilt"/>
          </ownedAttribute>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="_blk_hub" name="Hub">
          <ownedAttribute xmi:type="uml:Port" xmi:id="_port_hub_usb" name="usb" type="_ib_usb" aggregation="composite"/>
          <ownedAttribute xmi:type="uml:Port" xmi:id="_port_hub_serial" name="serial" type="_ib_serial" aggregation="composite"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="_blk_bench" name="Optical Bench">
          <ownedAttribute xmi:type="uml:Property" xmi:id="_prop_coll" name="collimator" type="_blk_coll" aggregation="composite"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_prop_mirror" name="mirror" type="_blk_mirror" aggregation="composite"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="_blk_rack" name="Controller Rack">
          <ownedAttribute xmi:type="uml:Property" xmi:id="_prop_hub" name="hub" type="_blk_hub" aggregation="composite"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="_blk_sys" name="Observatory System">
          <ownedAttribute xmi:type="uml:Property" xmi:id="_prop_bench" name="bench" type="_blk_bench" aggregation="composite"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_prop_rack" name="rack" type="_blk_rack" aggregation="composite"/>
          <ownedConnector xmi:type="uml:Connector" xmi:id="_conn_usb" name="camera link">
            <end xmi:type="uml:ConnectorEnd" xmi:id="_ce_usb_1" role="_port_coll_usb"/>
            <end xmi:type="uml:ConnectorEnd" xmi:id="_ce_usb_2" role="_port_hub_usb"/>
            <ownedComment xmi:type="uml:Comment" xmi:id="_doc_conn_usb" body="Camera data to the rack." annotatedElement="_conn_usb"/>
          </ownedConnector>
          <ownedConnector xmi:type="uml:Connector" xmi:id="_conn_serial" name="tilt link">
            <end xmi:type="uml:ConnectorEnd" xmi:id="_ce_serial_1" role="_port_mirror_tilt"/>
            <end xmi:type="uml:ConnectorEnd" xmi:id="_ce_serial_2" role="_port_hub_serial"/>
          </ownedConnector>
        </packagedElement>
      </packagedElement>

      <packagedElement xmi:type="uml:Package" xmi:id="_pkg_viewpoints" name="Viewpoints">
        <packagedElement xmi:type="uml:Class" xmi:id="_vp_totals" name="Totals Viewpoint" classifierBehavior="_act_totals">
          <ownedBehavior xmi:type="uml:Activity" xmi:id="_act_totals" name="Totals Method">
            <node xmi:type="uml:InitialNode" xmi:id="_tot_init"/>
            <node xmi:type="uml:CallBehaviorAction" xmi:id="_tot_collect" name="Collect Owned Elements"/>
            <node xmi:type="uml:CallBehaviorAction" xmi:id="_tot_filter" name="Filter By Metaclasses"/>
            <node xmi:type="uml:CallBehaviorAction" xmi:id="_tot_sort" name="Sort By Name"/>
            <node xmi:type="uml:StructuredActivityNode" xmi:id="_tot_table" name="Interface Totals">
              <node xmi:type="uml:InitialNode" xmi:id="_tot_table_init"/>
              <node xmi:type="uml:CallBehaviorAction" xmi:id="_tot_col_name" name="Interface Type"/>
              <node xmi:type="uml:CallBehaviorAction" xmi:id="_tot_col_count" name="Number of Interfaces"/>
              <node xmi:type="uml:CallBehaviorAction" xmi:id="_tot_col_iter" name="Iterated"/>
              <node xmi:type="uml:FlowFinalNode" xmi:id="_tot_table_final"/>
              <edge xmi:type="uml:ControlFlow" xmi:id="_tot_table_e1" source="_tot_table_init" target="_tot_col_name"/>
              <edge xmi:type="uml:ControlFlow" xmi:id="_tot_table_e2" source="_tot_col_name" target="_tot_col_count"/>
              <edge xmi:type="uml:ControlFlow" xmi:id="_tot_table_e3" source="_tot_col_count" target="_tot_col_iter"/>
              <edge xmi:type="uml:ControlFlow" xmi:id="_tot_table_e4" source="_tot_col_iter" target="_tot_table_final"/>
            </node>
            <node xmi:type="uml:StructuredActivityNode" xmi:id="_tot_each" name="Per Type">
              <node xmi:type="uml:InitialNode" xmi:id="_tot_each_init"/>
              <node xmi:type="uml:CallBehaviorAction" xmi:id="_tot_each_name" name="Interface Type"/>
              <node xmi:type="uml:CallBehaviorAction" xmi:id="_tot_each_count" name="Number of Interfaces"/>
              <node xmi:type="uml:FlowFinalNode" xmi:id="_tot_each_final"/>
              <edge xmi:type="uml:ControlFlow" xmi:id="_tot_each_e1" source="_tot_each_init" target="_tot_each_name"/>
              <edge xmi:type="uml:ControlFlow" xmi:id="_tot_each_e2" source="_tot_each_name" target="_tot_each_count"/>
              <edge xmi:type="uml:ControlFlow" xmi:id="_tot_each_e3" source="_tot_each_count" target="_tot_each_final"/>
            </node>
            <node xmi:type="uml:ActivityFinalNode" xmi:id="_tot_final"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_tot_e1" source="_tot_init" target="_tot_collect"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_tot_e2" source="_tot_collect" target="_tot_filter"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_tot_e3" source="_tot_filter" target="_tot_sort"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_tot_e4" source="_tot_sort" target="_tot_table"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_tot_e5" source="_tot_table" target="_tot_each"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_tot_e6" source="_tot_each" target="_tot_final"/>
          </ownedBehavior>
        </packagedElement>

        <packagedElement xmi:type="uml:Class" xmi:id="_vp_conn" name="Connections Viewpoint" classifierBehavior="_act_conn">
          <ownedBehavior xmi:type="uml:Activity" xmi:id="_act_conn" name="Connections Method">
            <node xmi:type="uml:InitialNode" xmi:id="_conn_init"/>
            <node xmi:type="uml:CallBehaviorAction" xmi:id="_conn_collect" name="Collect Owned Elements"/>
            <node xmi:type="uml:CallBehaviorAction" xmi:id="_conn_filter" name="Filter By Metaclasses"/>
            <node xmi:type="uml:StructuredActivityNode" xmi:id="_conn_table" name="Table of Connections">
              <node xmi:type="uml:InitialNode" xmi:id="_conn_table_init"/>
              <node xmi:type="uml:CallBehaviorAction" xmi:id="_conn_col_bench" name="Point of Interface on Optical Bench"/>
              <node xmi:type="uml:CallBehaviorAction" xmi:id="_conn_col_rack" name="Point of Interface on Controller Rack"/>
              <node xmi:type="uml:CallBehaviorAction" xmi:id="_conn_col_type" name="Type"/>
              <node xmi:type="uml:CallBehaviorAction" xmi:id="_conn_col_dir" name="Direction"/>
              <node xmi:type="uml:CallBehaviorAction" xmi:id="_conn_col_desc" name="Description"/>
              <node xmi:type="uml:FlowFinalNode" xmi:id="_conn_table_final"/>
              <edge xmi:type="uml:ControlFlow" xmi:id="_conn_table_e1" source="_conn_table_init" target="_conn_col_bench"/>
              <edge xmi:type="uml:ControlFlow" xmi:id="_conn_table_e2" source="_conn_col_bench" target="_conn_col_rack"/>
              <edge xmi:type="uml:ControlFlow" xmi:id="_conn_table_e3" source="_conn_col_rack" target="_conn_col_type"/>
              <edge xmi:type="uml:ControlFlow" xmi:id="_conn_table_e4" source="_conn_col_type" target="_conn_col_dir"/>
              <edge xmi:type="uml:ControlFlow" xmi:id="_conn_table_e5" source="_conn_col_dir" target="_conn_col_desc"/>
              <edge xmi:type="uml:ControlFlow" xmi:id="_conn_table_e6" source="_conn_col_desc" target="_conn_table_final"/>
            </node>
            <node xmi:type="uml:ActivityFinalNode" xmi:id="_conn_final"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_conn_e1" source="_conn_init" target="_conn_collect"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_conn_e2" source="_conn_collect" target="_conn_filter"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_conn_e3" source="_conn_filter" target="_conn_table"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_conn_e4" source="_conn_table" target="_conn_final"/>
          </ownedBehavior>
        </packagedElement>

        <packagedElement xmi:type="uml:Class" xmi:id="_vp_ifc" name="Interfaces Viewpoint" classifierBehavior="_act_ifc">
          <ownedBehavior xmi:type="uml:Activity" xmi:id="_act_ifc" name="Interfaces Method">
            <node xmi:type="uml:InitialNode" xmi:id="_ifc_init"/>
            <node xmi:type="uml:CallBehaviorAction" xmi:id="_ifc_collect" name="Collect Owned Elements"/>
            <node xmi:type="uml:CallBehaviorAction" xmi:id="_ifc_parts" name="Filter By Metaclasses"/>
            <node xmi:type="uml:CallBehaviorAction" xmi:id="_ifc_sort" name="Sort By Name"/>
            <node xmi:type="uml:StructuredActivityNode" xmi:id="_ifc_loop" name="Per Assembly">
              <node xmi:type="uml:InitialNode" xmi:id="_ifc_loop_init"/>
              <node xmi:type="uml:CallBehaviorAction" xmi:id="_ifc_bullet" name="Assembly"/>
              <node xmi:type="uml:CallBehaviorAction" xmi:id="_ifc_types" name="Collect Types"/>
              <node xmi:type="uml:StructuredActivityNode" xmi:id="_ifc_table" name="Interfaces Table">
                <node xmi:type="uml:InitialNode" xmi:id="_ifc_table_init"/>
                <node xmi:type="uml:CallBehaviorAction" xmi:id="_ifc_col_name" name="Name"/>
                <node xmi:type="uml:StructuredActivityNode" xmi:id="_ifc_col_desc" name="Description">
                  <node xmi:type="uml:InitialNode" xmi:id="_ifc_desc_init"/>
                  <node xmi:type="uml:CallBehaviorAction" xmi:id="_ifc_desc_collect" name="Collect Owned Elements"/>
                  <node xmi:type="uml:CallBehaviorAction" xmi:id="_ifc_desc_ports" name="Filter By Metaclasses"/>
                  <node xmi:type="uml:FlowFinalNode" xmi:id="_ifc_desc_final"/>
                  <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_desc_e1" source="_ifc_desc_init" target="_ifc_desc_collect"/>
                  <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_desc_e2" source="_ifc_desc_collect" target="_ifc_desc_ports"/>
                  <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_desc_e3" source="_ifc_desc_ports" target="_ifc_desc_final"/>
                </node>
                <node xmi:type="uml:StructuredActivityNode" xmi:id="_ifc_col_ifc" name="Interfaces">
                  <node xmi:type="uml:InitialNode" xmi:id="_ifc_ifc_init"/>
                  <node xmi:type="uml:CallBehaviorAction" xmi:id="_ifc_ifc_collect" name="Collect Owned Elements"/>
                  <node xmi:type="uml:CallBehaviorAction" xmi:id="_ifc_ifc_ports" name="Filter By Metaclasses"/>
                  <node xmi:type="uml:CallBehaviorAction" xmi:id="_ifc_ifc_types" name="Collect Types"/>
                  <node xmi:type="uml:FlowFinalNode" xmi:id="_ifc_ifc_final"/>
                  <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_ifc_e1" source="_ifc_ifc_init" target="_ifc_ifc_collect"/>
                  <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_ifc_e2" source="_ifc_ifc_collect" target="_ifc_ifc_ports"/>
                  <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_ifc_e3" source="_ifc_ifc_ports" target="_ifc_ifc_types"/>
                  <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_ifc_e4" source="_ifc_ifc_types" target="_ifc_ifc_final"/>
                </node>
                <node xmi:type="uml:StructuredActivityNode" xmi:id="_ifc_col_sorted" name="Sorted Ports">
                  <node xmi:type="uml:InitialNode" xmi:id="_ifc_sorted_init"/>
                  <node xmi:type="uml:CallBehaviorAction" xmi:id="_ifc_sorted_collect" name="Collect Owned Elements"/>
                  <node xmi:type="uml:CallBehaviorAction" xmi:id="_ifc_sorted_sort" name="Sort By Property"/>
                  <node xmi:type="uml:FlowFinalNode" xmi:id="_ifc_sorted_final"/>
                  <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_sorted_e1" source="_ifc_sorted_init" target="_ifc_sorted_collect"/>
                  <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_sorted_e2" source="_ifc_sorted_collect" target="_ifc_sorted_sort"/>
                  <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_sorted_e3" source="_ifc_sorted_sort" target="_ifc_sorted_final"/>
                </node>
                <node xmi:type="uml:StructuredActivityNode" xmi:id="_ifc_col_assoc" name="Associated">
                  <node xmi:type="uml:InitialNode" xmi:id="_ifc_assoc_init"/>
                  <node xmi:type="uml:CallBehaviorAction" xmi:id="_ifc_assoc_collect" name="Collect By Association"/>
                  <node xmi:type="uml:FlowFinalNode" xmi:id="_ifc_assoc_final"/>
                  <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_assoc_e1" source="_ifc_assoc_init" target="_ifc_assoc_collect"/>
                  <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_assoc_e2" source="_ifc_assoc_collect" target="_ifc_assoc_final"/>
                </node>
                <node xmi:type="uml:FlowFinalNode" xmi:id="_ifc_table_final"/>
                <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_table_e1" source="_ifc_table_init" target="_ifc_col_name"/>
                <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_table_e2" source="_ifc_col_name" target="_ifc_col_desc"/>
                <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_table_e3" source="_ifc_col_desc" target="_ifc_col_ifc"/>
                <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_table_e4" source="_ifc_col_ifc" target="_ifc_col_sorted"/>
                <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_table_e5" source="_ifc_col_sorted" target="_ifc_col_assoc"/>
                <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_table_e6" source="_ifc_col_assoc" target="_ifc_table_final"/>
              </node>
              <node xmi:type="uml:FlowFinalNode" xmi:id="_ifc_loop_final"/>
              <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_loop_e1" source="_ifc_loop_init" target="_ifc_bullet"/>
              <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_loop_e2" source="_ifc_bullet" target="_ifc_types"/>
              <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_loop_e3" source="_ifc_types" target="_ifc_table"/>
              <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_loop_e4" source="_ifc_table" target="_ifc_loop_final"/>
            </node>
            <node xmi:type="uml:CallBehaviorAction" xmi:id="_ifc_none_filter" name="Filter By Metaclasses"/>
            <node xmi:type="uml:StructuredActivityNode" xmi:id="_ifc_none" name="Per Activity">
              <node xmi:type="uml:InitialNode" xmi:id="_ifc_none_init"/>
              <node xmi:type="uml:CallBehaviorAction" xmi:id="_ifc_none_bullet" name="Activity"/>
              <node xmi:type="uml:FlowFinalNode" xmi:id="_ifc_none_final"/>
              <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_none_e1" source="_ifc_none_init" target="_ifc_none_bullet"/>
              <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_none_e2" source="_ifc_none_bullet" target="_ifc_none_final"/>
            </node>
            <node xmi:type="uml:ActivityFinalNode" xmi:id="_ifc_final"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_e1" source="_ifc_init" target="_ifc_collect"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_e2" source="_ifc_collect" target="_ifc_parts"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_e3" source="_ifc_parts" target="_ifc_sort"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_e4" source="_ifc_sort" target="_ifc_loop"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_e5" source="_ifc_loop" target="_ifc_none_filter"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_e6" source="_ifc_none_filter" target="_ifc_none"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_ifc_e7" source="_ifc_none" target="_ifc_final"/>
          </ownedBehavior>
        </packagedElement>

        <packagedElement xmi:type="uml:Class" xmi:id="_vp_per" name="Per Part Viewpoint" classifierBehavior="_act_per">
          <ownedBehavior xmi:type="uml:Activity" xmi:id="_act_per" name="Per Part Method">
            <node xmi:type="uml:InitialNode" xmi:id="_per_init"/>
            <node xmi:type="uml:CallBehaviorAction" xmi:id="_per_collect" name="Collect Owned Elements"/>
            <node xmi:type="uml:CallBehaviorAction" xmi:id="_per_parts" name="Filter By Metaclasses"/>
            <node xmi:type="uml:CallBehaviorAction" xmi:id="_per_call" name="One Part" behavior="_act_one_part"/>
            <node xmi:type="uml:ActivityFinalNode" xmi:id="_per_final"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_per_e1" source="_per_init" target="_per_collect"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_per_e2" source="_per_collect" target="_per_parts"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_per_e3" source="_per_parts" target="_per_call"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_per_e4" source="_per_call" target="_per_final"/>
          </ownedBehavior>
          <ownedBehavior xmi:type="uml:Activity" xmi:id="_act_one_part" name="One Part">
            <node xmi:type="uml:InitialNode" xmi:id="_one_init"/>
            <node xmi:type="uml:CallBehaviorAction" xmi:id="_one_list" name="The Part"/>
            <node xmi:type="uml:ActivityFinalNode" xmi:id="_one_final"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_one_e1" source="_one_init" target="_one_list"/>
            <edge xmi:type="uml:ControlFlow" xmi:id="_one_e2" source="_one_list" target="_one_final"/>
          </ownedBehavior>
        </packagedElement>
      </packagedElement>

      <packagedElement xmi:type="uml:Package" xmi:id="_pkg_docs" name="Documents">
        <packagedElement xmi:type="uml:Class" xmi:id="_doc_icd" name="Interface Control Document">
          <ownedAttribute xmi:type="uml:Property" xmi:id="_doc_totals" name="totals" type="_view_totals" aggregation="composite"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_doc_conn" name="connections" type="_view_conn" aggregation="composite"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_doc_ifc" name="interfaces" type="_view_ifc" aggregation="composite"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_doc_per" name="perPart" type="_view_per" aggregation="composite"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="_doc_sum" name="Interface Summary">
          <ownedAttribute xmi:type="uml:Property" xmi:id="_doc_sum_ifc" name="interfaces" type="_view_ifc" aggregation="composite"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="_view_totals" name="Interface Totals">
          <generalization xmi:type="uml:Generalization" xmi:id="_gen_totals" general="_vp_totals"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="_view_conn" name="Connections">
          <generalization xmi:type="uml:Generalization" xmi:id="_gen_conn" general="_vp_conn"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="_view_ifc" name="Interfaces">
          <generalization xmi:type="uml:Generalization" xmi:id="_gen_ifc" general="_vp_ifc"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="_view_per" name="Per Part">
          <generalization xmi:type="uml:Generalization" xmi:id="_gen_per" general="_vp_per"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Dependency" xmi:id="_expose_totals" client="_view_totals" supplier="_pkg_types"/>
        <packagedElement xmi:type="uml:Dependency" xmi:id="_expose_conn" client="_view_conn" supplier="_blk_sys"/>
        <packagedElement xmi:type="uml:Dependency" xmi:id="_expose_ifc" client="_view_ifc" supplier="_blk_bench"/>
        <packagedElement xmi:type="uml:Dependency" xmi:id="_expose_per" client="_view_per" supplier="_blk_bench"/>
      </packagedElement>
    </packagedElement>
  </uml:Model>

  <sysml:ValueType xmi:id="_st_vt_bits" base_DataType="_vt_bits"/>
  <sysml:InterfaceBlock xmi:id="_st_ib_usb" base_Class="_ib_usb"/>
  <sysml:InterfaceBlock xmi:id="_st_ib_serial" base_Class="_ib_serial"/>
  <sysml:InterfaceBlock xmi:id="_st_ib_spare" base_Class="_ib_spare"/>
  <sysml:FlowProperty xmi:id="_st_fp_usb_data" base_Property="_fp_usb_data" direction="inout"/>
  <sysml:FlowProperty xmi:id="_st_fp_serial_cmd" base_Property="_fp_serial_cmd" direction="in"/>
  <sysml:Block xmi:id="_st_blk_coll" base_Class="_blk_coll"/>
  <sysml:Block xmi:id="_st_blk_mirror" base_Class="_blk_mirror"/>
  <sysml:Block xmi:id="_st_blk_hub" base_Class="_blk_hub"/>
  <sysml:Block xmi:id="_st_blk_bench" base_Class="_blk_bench"/>
  <sysml:Block xmi:id="_st_blk_rack" base_Class="_blk_rack"/>
  <sysml:Block xmi:id="_st_blk_sys" base_Class="_blk_sys"/>
