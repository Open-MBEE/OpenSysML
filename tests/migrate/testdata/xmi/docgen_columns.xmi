  <Document_Profile_:TableExpressionColumn xmi:id="_st_conn_col_bench" base_CallBehaviorAction="_conn_col_bench" expression="end.appliedStereotypeInstance.slot-&gt;select(x|x.definingFeature.name = 'propertyPath' and x.value.oclAsType(ElementValue).element-&gt;exists(y|y.oclAsType(Property).type.name = 'Optical Bench')).value.oclAsType(ElementValue).element-&gt;select(z|z.oclAsType(Property).type.oclAsType(NamedElement).name &lt;&gt; 'Optical Bench').oclAsType(NamedElement).name"/>
  <Document_Profile_:TableExpressionColumn xmi:id="_st_conn_col_rack" base_CallBehaviorAction="_conn_col_rack" expression="end.appliedStereotypeInstance.slot-&gt;select(x|x.definingFeature.name = 'propertyPath' and x.value.oclAsType(ElementValue).element-&gt;exists(y|y.oclAsType(Property).type.name = 'Controller Rack')).value.oclAsType(ElementValue).element-&gt;select(z|z.oclAsType(Property).type.oclAsType(NamedElement).name &lt;&gt; 'Controller Rack').oclAsType(NamedElement).name"/>
  <Document_Profile_:TableExpressionColumn xmi:id="_st_conn_col_type" base_CallBehaviorAction="_conn_col_type" expression="end.role.type-&gt;asSet()"/>
  <Document_Profile_:TableExpressionColumn xmi:id="_st_conn_col_dir" base_CallBehaviorAction="_conn_col_dir" expression="end.role.type.oclAsType(Class).member-&gt;select(y|y.appliedStereotypeInstance.classifier-&gt;any(x|x.name = 'FlowProperty')-&gt;size() &lt;&gt; 0).appliedStereotypeInstance.slot-&gt;select(x|x.oclAsType(Slot).definingFeature.name = 'direction').oclAsType(Slot).value.oclAsType(InstanceValue).instance.name-&gt;asSet()"/>
  <Document_Profile_:TableAttributeColumn xmi:id="_st_conn_col_desc" base_CallBehaviorAction="_conn_col_desc" desiredAttribute="Documentation"/>

