    sysx:sourceText "    state def Lamp {\n        entry; then off;\n        state off;\n        state on parallel {\n            state heat {\n                entry; then warm;\n                state warm;\n                state hot;\n                transition warm then hot;\n            }\n            state light {\n                entry; then dim;\n                state dim;\n                state bright;\n                transition dim then bright;\n                transition bright then hot;\n            }\n        }\n        transition off then on;\n        transition on then bright;\n        transition hot then off;\n    }\n" ;
