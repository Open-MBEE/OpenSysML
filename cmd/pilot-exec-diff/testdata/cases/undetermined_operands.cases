model: cmd/pilot-exec-diff/testdata/models/undetermined_operands.sysml

# Model-level evaluation over an unbound feature (`attribute u;`, no type, no value)
# and over usages whose multiplicity leaves the cardinality open. The pilot leaves
# such expressions unevaluated (the operator expression itself comes back); ours
# answers <undetermined> and folds only what a constant operand fixes.

# Boolean folding on the first operand: the conditional second operand is never read.
and-first-false :: U :: false and (u > 3)
or-first-true :: U :: true or (u == 1)
implies-first-false :: U :: false implies (u == 1)

# Boolean folding on the second operand: the unknown first operand cannot change the answer.
and-second-false :: U :: (u > 3) and false
or-second-true :: U :: (u == 1) or true
implies-second-true :: U :: (u == 1) implies true

# Boolean forms the unknown decides.
and-second-true :: U :: (u > 3) and true
or-second-false :: U :: (u == 1) or false
implies-second-false :: U :: (u == 1) implies false
not-unbound :: U :: not (u == 5)

# Arithmetic, comparison, unary, conditional, indexing over the unknown.
unbound-ref :: U :: u
add-unbound :: U :: u + 5
nested-unbound :: U :: (u + 5) * 2
gt-unbound :: U :: u > 3
eq-unbound :: U :: u == 5
neg-unbound :: U :: -u
if-unbound :: U :: if u > 0 ? 1 else 2
index-by-unbound :: U :: (10, 20, 30)#(u)

# Collection membership with an unknown element or an unknown probe. The library
# functions are qualified: the pilot's prompt does not see a package's private imports.
includes-unknown-element :: U :: SequenceFunctions::includes((1, u + 1), 1)
excludes-unknown-element :: U :: SequenceFunctions::excludes((1, u + 1), 1)
includes-unknown-probe :: U :: SequenceFunctions::includes((1, 2), u + 1)
excludes-unknown-probe :: U :: SequenceFunctions::excludes((1, 2), u + 1)

# The count of an unbound feature is fixed by its multiplicity, `[1]`, even though its value is not.
size-unbound :: U :: SequenceFunctions::size(u)
size-mixed :: U :: SequenceFunctions::size((1, u))
notempty-unbound :: U :: SequenceFunctions::notEmpty(u)

# Cardinalities the model fixes stay definite.
size-slots :: T :: SequenceFunctions::size(rack.slots)
size-lone :: T :: SequenceFunctions::size(rack.lone)
size-enum-literal :: T :: SequenceFunctions::size(Mode::ON)
index-slots :: T :: rack.slots#(2)

# Cardinalities the model leaves open.
size-gear :: T :: SequenceFunctions::size(rack.gear)
notempty-gear :: T :: SequenceFunctions::notEmpty(rack.gear)
isempty-gear :: T :: SequenceFunctions::isEmpty(rack.gear)
isempty-loose :: T :: SequenceFunctions::isEmpty(rack.loose)
notempty-loose :: T :: SequenceFunctions::notEmpty(rack.loose)
size-loose :: T :: SequenceFunctions::size(rack.loose)
size-gear-loose :: T :: SequenceFunctions::size((rack.gear, rack.loose))
index-gear :: T :: rack.gear#(7)

# A lower bound too large to materialize is still only a bound at model level.
size-many :: T :: SequenceFunctions::size(rack.many)
notempty-many :: T :: SequenceFunctions::notEmpty(rack.many)

# An open collection certainly holds what subsets it.
includes-subsetter :: T :: SequenceFunctions::includes(rack.gear, rack.fixed)
includes-other :: T :: SequenceFunctions::includes(rack.gear, rack.lone)

# Quantifiers decide from the elements an open collection certainly holds.
exists-known-witness :: U :: (1, u)->ControlFunctions::exists{in x; x == 1}
forall-known-counterexample :: U :: (1, u)->ControlFunctions::forAll{in x; x > 2}
exists-unknown :: U :: (1, u)->ControlFunctions::exists{in x; x == 2}
anytrue-known-witness :: U :: ControlFunctions::anyTrue((true, u == 1))

# Membership decides from the elements both sequences certainly hold.
includes-known-absent :: U :: SequenceFunctions::includes((1), (2, u))
excludes-known-shared :: U :: SequenceFunctions::excludes((1), (1, u))

# No index reaches into a sequence certainly empty.
index-empty-by-unbound :: U :: ()#(u)

# Filters and mappings keep what the elements certainly held yield.
select-keeps-known :: U :: SequenceFunctions::includes((1, u)->ControlFunctions::select{in x; x == 1}, 1)
select-known-count :: U :: SequenceFunctions::size((1, u)->ControlFunctions::select{in x; x == 1})
collect-keeps-known :: U :: SequenceFunctions::includes((1, u)->ControlFunctions::collect{in x; x + 1}, 2)

# A mapping of fixed count over an open collection keeps the count the collection fixes.
collect-fixed-count :: U :: SequenceFunctions::size((1, u)->ControlFunctions::collect{in x; x + 1})
collect-loose-count :: T :: SequenceFunctions::size(rack.loose->ControlFunctions::collect{in x; x})

# A feature declared `[0]` holds nothing: its count is fixed, so it reads as empty.
vacant-ref :: T :: rack.vacant
size-vacant :: T :: SequenceFunctions::size(rack.vacant)
isempty-vacant :: T :: SequenceFunctions::isEmpty(rack.vacant)

# A conditional over an open test holds the count both branches fix; branches of
# different counts leave it open.
size-if-unbound :: U :: SequenceFunctions::size(if u > 0 ? 1 else 2)
size-if-pairs :: U :: SequenceFunctions::size(if u > 0 ? (1, 2) else (3, 4))
size-if-differing :: U :: SequenceFunctions::size(if u > 0 ? (1, 2) else 3)

# `??` over an operand that may be empty yields that operand, then nonempty, or
# the fallback: the count covers both.
size-coalesce-unbound :: U :: SequenceFunctions::size(u ?? 3)
notempty-coalesce-loose :: T :: SequenceFunctions::notEmpty(rack.loose ?? 3)

# A test that does not depend on the element decides a quantifier over a
# collection certainly holding one; over one that may hold none it stays open.
exists-constant-gear :: T :: rack.gear->ControlFunctions::exists{in x; true}
forall-constant-gear :: T :: rack.gear->ControlFunctions::forAll{in x; false}
exists-constant-loose :: T :: rack.loose->ControlFunctions::exists{in x; true}

# A zero divisor fails the division whatever the open operand holds.
div-unbound-by-zero :: U :: u / 0
mod-unbound-by-zero :: U :: u % 0
div-unbound-by-two :: U :: u / 2

# A determined position outside every value the open operand may hold fails the
# library function; one the operand's count admits leaves the result open.
substring-unbound-zero :: U :: StringFunctions::Substring(s, 0, 2)
substring-unbound-valid :: U :: StringFunctions::Substring(s, 1, 2)
substring-unbound-inverted :: U :: StringFunctions::Substring(s, 3, 2)
includingat-unbound-zero :: U :: SequenceFunctions::includingAt(xs, 1.0, 0)
includingat-unbound-past :: U :: SequenceFunctions::includingAt(xs, 1.0, 6)
includingat-unbound-valid :: U :: SequenceFunctions::includingAt(xs, 1.0, 1)
subsequence-unbound-zero :: U :: SequenceFunctions::subsequence(xs, 0, 1)
subsequence-unbound-past :: U :: SequenceFunctions::subsequence(xs, 2, 5)
subsequence-unbound-valid :: U :: SequenceFunctions::subsequence(xs, 1, 2)
excludingat-unbound-zero :: U :: SequenceFunctions::excludingAt(xs, 0)
excludingat-unbound-past :: U :: SequenceFunctions::excludingAt(xs, 5)
excludingat-unbound-valid :: U :: SequenceFunctions::excludingAt(xs, 1)

# A determined argument outside its parameter's domain fails a numeric library
# function whatever the open argument holds; one within it leaves the result open.
max-integer-real-unbound :: U :: IntegerFunctions::max(1.5, u)
max-integer-unbound :: U :: IntegerFunctions::max(1, u)
rat-unbound-zero-denum :: U :: RationalFunctions::rat(u, 0)
gcd-fraction-unbound :: U :: RationalFunctions::gcd(1.5, u)

# A filter test that does not depend on the element decides over the elements an
# open collection may hold beyond the known: it keeps or drops them as a whole.
select-constant-gear-nonempty :: T :: SequenceFunctions::notEmpty(rack.gear->ControlFunctions::select{in x; true})
reject-constant-gear-empty :: T :: SequenceFunctions::isEmpty(rack.gear->ControlFunctions::reject{in x; true})
select-constant-unbound-count :: U :: SequenceFunctions::size(xs->ControlFunctions::select{in x; true})
reject-constant-unbound-empty :: U :: xs->ControlFunctions::reject{in x; true}
select-failing-unbound :: U :: xs->ControlFunctions::select{in x; 1 / 0 > 0}

# A sequence whose elements each hold a fixed number of values fixes every position:
# the determined ones answer, the open one stays open, one past the count fails.
index-fixed-first :: U :: (10, u, 30)#(1)
index-fixed-last :: U :: (10, u, 30)#(3)
index-fixed-open :: U :: (10, u, 30)#(2)
index-fixed-past :: U :: (10, u, 30)#(4)
head-fixed :: U :: SequenceFunctions::head((10, u, 30))
last-fixed :: U :: SequenceFunctions::last((10, u, 30))
last-tail-fixed :: U :: SequenceFunctions::last(SequenceFunctions::tail((10, u, 30)))
subsequence-fixed-index :: U :: SequenceFunctions::subsequence((10, u, 30), 2, 3)#(2)
excludingat-fixed-index :: U :: SequenceFunctions::excludingAt((10, u, 30), 2)#(2)
includingat-fixed-index :: U :: SequenceFunctions::includingAt((10, u, 30), 20, 2)#(4)
index-open-count-first :: U :: (10, xs, 30)#(1)

# An open operand is judged by the type its feature declares: an operator or
# function undefined for that type is a type mismatch, one it may hold stays open.
typed-string-minus :: U :: s - 1
typed-string-negate :: U :: -s
typed-string-ordered-number :: U :: s > 1
typed-string-not :: U :: not s
typed-string-and-true :: U :: s and true
typed-string-condition :: U :: if s ? 1 else 2
typed-string-index :: U :: (10, 20, 30)#(s)
typed-string-two-open :: U :: s < r
typed-boolean-minus :: U :: b - 1
typed-real-length :: U :: StringFunctions::Length(r)
typed-real-function-string :: U :: RealFunctions::'-'(s, 1)
typed-string-concat :: U :: s + "a"
typed-string-ordered-string :: U :: s < "a"
typed-real-minus :: U :: r - 1
typed-boolean-not :: U :: not b
typed-boolean-condition :: U :: if b ? 1 else 2
typed-real-index :: U :: (10, 20, 30)#(r)
typed-string-and-false :: U :: false and s
typed-boolean-and-false :: U :: b and false

# A chain through an open collection reads what the members it certainly holds
# declare, so membership and quantifiers can decide from them.
chain-known-tag-default :: T :: rack.fixed.tag
chain-known-tag-redefined :: T :: rack.tagged.tag
chain-open-tag :: T :: rack.gear.tag
chain-includes-default :: T :: SequenceFunctions::includes(rack.gear.tag, "d")
chain-includes-redefined :: T :: SequenceFunctions::includes(rack.gear.tag, "x")
chain-includes-unknown :: T :: SequenceFunctions::includes(rack.gear.tag, "zz")
chain-excludes-known :: T :: SequenceFunctions::excludes(rack.gear.tag, "d")
chain-exists-known :: T :: rack.gear.tag->ControlFunctions::exists{in x; x == "x"}
chain-forall-refuted :: T :: rack.gear.tag->ControlFunctions::forAll{in x; x == "d"}
chain-open-mass :: T :: rack.gear.mass
chain-size-open :: T :: SequenceFunctions::size(rack.gear.tag)
chain-loose-tag :: T :: rack.loose.tag
chain-no-member :: T :: rack.gear.nope
