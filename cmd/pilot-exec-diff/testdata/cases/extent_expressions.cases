model: cmd/pilot-exec-diff/testdata/models/extent_expressions.sysml

# `all T` is the extent of T (KerML 1.0 §7.4.9.2 ExtentExpression, BaseFunctions::'all'): the
# instances of the named type. The pilot does not evaluate the operator — it returns the
# `OperatorExpression all` node unreduced — so the extent cases below land in
# pilot-unevaluated whatever T is, and `size(all T)` counts that one node as 1 on the pilot's
# side, whatever the extent's true size (0 for Boat, which nothing instantiates). Ours
# enumerates the run's extent: an enumeration's literals, a variation's variants, and the
# objects of an ordinary definition the context reaches, nested ones included.
extent-enum-literals ::  :: Extent::sizes
extent-nested-objects ::  :: Extent::wheels
extent-root-objects ::  :: Extent::cars
extent-uninstantiated-definition ::  :: Extent::boats
extent-variation-count ::  :: Extent::gearboxCount
extent-uninstantiated-count ::  :: Extent::boatCount

# A namespace-level object usage of several occurrences denotes its lower bound of objects
# (KerML 1.0 §7.3.4.3): `part rims : Rim[2];` is two rims, `[1..*]` one, `[0..*]` none, and a
# valued `[2]` usage is bound to its two values, or refused where the value yields three. The
# pilot materializes no object and evaluates neither `all` nor a read of such a usage, so these
# land in pilot-unevaluated (or count the one unevaluated node) on its side.
extent-namespace-collection-count ::  :: Collections::rimCount
extent-namespace-collection-read ::  :: Collections::rimsRead
extent-namespace-collection-index ::  :: Collections::firstRimRadius
extent-namespace-collection-chain ::  :: Collections::rimRadii
extent-namespace-lower-bound-one ::  :: Collections::hubCount
extent-namespace-lower-bound-zero ::  :: Collections::spareCount
extent-namespace-valued-collection ::  :: Collections::rodCount
extent-namespace-valued-count-mismatch ::  :: Mismatch::unevenCount
