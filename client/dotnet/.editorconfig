# The .NET client's formatting and code-style policy; dotnet format and the build enforce it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,config,json,xml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Unnecessary using directives fail the build.
dotnet_diagnostic.IDE0005.severity = warning

# Private fields are camelCase; constants and static readonly fields PascalCase.
dotnet_naming_rule.constants.symbols = constants
dotnet_naming_rule.constants.style = pascal_case
dotnet_naming_rule.constants.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.static_readonly.symbols = static_readonly
dotnet_naming_rule.static_readonly.style = pascal_case
dotnet_naming_rule.static_readonly.severity = warning
dotnet_naming_symbols.static_readonly.applicable_kinds = field
dotnet_naming_symbols.static_readonly.required_modifiers = static, readonly
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = camel_case
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

# The committed buf output (make proto-csharp), by exact path: generated code, and public
# protocol API outside the handwritten PublicAPI baseline. Nothing else is exempted.
[src/OpenMBEE.OpenSysML/Wire/{Sysml,SysmlGrpc}.cs]
generated_code = true
dotnet_diagnostic.RS0016.severity = none
dotnet_diagnostic.RS0041.severity = none

# The metamodel types tools/gen/csmetamodel writes (make dotnet-metamodel), by exact path: generated
# code, and public API outside the metamodel's handwritten PublicAPI baseline. Nothing else is exempted.
[src/OpenMBEE.OpenSysML.Metamodel/Generated.cs]
generated_code = true
dotnet_diagnostic.RS0016.severity = none
dotnet_diagnostic.RS0041.severity = none
