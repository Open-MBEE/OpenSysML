<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The SysML metamodel as C# types, standalone: it references neither the client library nor any
    package at run time. Generated.cs is written by tools/gen/csmetamodel (make dotnet-metamodel);
    the rest is the runtime those types compile against.
  -->
  <PropertyGroup>
    <AssemblyName>OpenMBEE.OpenSysML.Metamodel</AssemblyName>
    <RootNamespace>OpenMBEE.OpenSysML.Metamodel</RootNamespace>
    <Description>The SysML v2 metamodel's metaclasses, properties and enumerations as C# interfaces, classes and enums.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also adds PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt as the baseline it checks against. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Experimental until the client is declared stable: a release may change its API, and a project opts in by suppressing OSML0001. -->
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExperimentalAttribute">
      <_Parameter1>OSML0001</_Parameter1>
      <UrlFormat>https://runtime.opensysml.org/clients/dotnet/#experimental</UrlFormat>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenMBEE.OpenSysML.Metamodel.Tests" />
  </ItemGroup>
</Project>
