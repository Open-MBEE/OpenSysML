<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A stand-in for sysml-grpc that the lifecycle tests start as a private service. It serves
    nothing: it reports, misreports or withholds an address and exits, lingers or floods its
    output as the fake-service.json beside it says, so every startup and shutdown path of the
    client can be driven without the real service.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>FakeService</AssemblyName>
    <RootNamespace>OpenMBEE.OpenSysML.FakeService</RootNamespace>
    <!-- The tests copy the native launcher and run it under another name. -->
    <UseAppHost>true</UseAppHost>
    <!-- LibraryImport, to close its own standard output for real. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
